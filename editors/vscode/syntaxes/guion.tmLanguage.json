{
  "scopeName": "source.guion",
  "name": "Guion",
  "patterns": [
    { "name": "comment.line.number-sign.guion", "match": "#.*$" },
    { "name": "string.quoted.double.guion", "begin": "f?\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.guion", "match": "\\\\." }] },
    { "name": "keyword.control.guion", "match": "\\b(if|else|while|for|in|return|break|continue|pass|match)\\b" },
    { "name": "keyword.declaration.guion", "match": "\\b(fn|let|var|set|record|enum|pub|priv|import|extern)\\b" },
    { "name": "constant.language.guion", "match": "\\b(true|false|None)\\b" },
    { "name": "keyword.operator.word.guion", "match": "\\b(and|or|not)\\b" },
    { "name": "support.type.guion", "match": "\\b(Int|Float64|Bool|Text|Bytes|Unit|Json|List|Map|Option|Result|Array)\\b" },
    { "name": "constant.numeric.hex.guion", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
    { "name": "constant.numeric.octal.guion", "match": "\\b0[oO][0-7_]+\\b" },
    { "name": "constant.numeric.binary.guion", "match": "\\b0[bB][01_]+\\b" },
    { "name": "constant.numeric.guion", "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d[\\d_]*)?\\b" }
  ]
}
