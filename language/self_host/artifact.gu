# Canonical Guion artifact encoder. This module owns field ordering and
# opcode/value encodings; the Rust model remains the independent verifier.

fn ab_join(parts: List[Bytes]) -> Bytes:
    return bytes_join(parts)

fn ab_u8(value: Int) -> Bytes:
    return bytes_from_ints([value])

fn ab_u32(value: Int) -> Bytes:
    return bytes_from_ints([value % 256, (value / 256) % 256, (value / 65536) % 256, (value / 16777216) % 256])

fn ab_u64(value: Int) -> Bytes:
    return bytes_from_ints([value % 256, (value / 256) % 256, (value / 65536) % 256, (value / 16777216) % 256, (value / 4294967296) % 256, (value / 1099511627776) % 256, (value / 281474976710656) % 256, (value / 72057594037927936) % 256])

fn ab_count(value: Int) -> Bytes:
    return ab_u32(value)

fn ab_string(value: Text) -> Bytes:
    let raw = bytes_from_text(value)
    return ab_join([ab_count(len(raw)), raw])

fn ab_blob(value: Bytes) -> Bytes:
    return ab_join([ab_u32(len(value)), value])

fn ab_starts(value: Text, prefix: Text) -> Bool:
    let value_chars = text_chars(value)
    let prefix_chars = text_chars(prefix)
    if len(prefix_chars) > len(value_chars):
        return false
    var cursor = 0
    while cursor < len(prefix_chars):
        if value_chars[cursor] != prefix_chars[cursor]:
            return false
        set cursor = cursor + 1
    return true

fn ab_json_int(value: Json) -> Int:
    return json_as_int(value)

fn ab_json_int_or(value: Json, key: Text, fallback: Int) -> Int:
    if json_has(value, key):
        return json_as_int(json_get(value, key))
    return fallback

fn ab_type_inner(value: Text, prefix_length: Int) -> Text:
    let characters = text_chars(value)
    var result = ""
    var cursor = prefix_length
    while cursor < len(characters) - 1:
        set result = result + characters[cursor]
        set cursor = cursor + 1
    return result

fn ab_type_comma(value: Text) -> Int:
    let characters = text_chars(value)
    var depth = 0
    var cursor = 0
    while cursor < len(characters):
        if characters[cursor] == "[":
            set depth = depth + 1
        else:
            if characters[cursor] == "]":
                set depth = depth - 1
            else:
                if characters[cursor] == "," and depth == 0:
                    return cursor
        set cursor = cursor + 1
    return -1

fn ab_type_argument(value: Text, wanted: Int) -> Text:
    let characters = text_chars(value)
    var result = ""
    var depth = 0
    var part = 0
    var cursor = 0
    while cursor <= len(characters):
        if cursor == len(characters) or (characters[cursor] == "," and depth == 0):
            if part == wanted:
                return result
            set result = ""
            set part = part + 1
        else:
            if characters[cursor] == "[":
                set depth = depth + 1
            else:
                if characters[cursor] == "]":
                    set depth = depth - 1
            if result != "" or characters[cursor] != " ":
                set result = result + characters[cursor]
        set cursor = cursor + 1
    return result

fn ab_type(value: Text) -> Bytes:
    if value == "Int":
        return ab_u8(0)
    if value == "Bool":
        return ab_u8(1)
    if value == "Text":
        return ab_u8(2)
    if value == "Unit":
        return ab_u8(3)
    if value == "TaskError":
        return ab_u8(6)
    if value == "Json":
        return ab_u8(7)
    if value == "JsonError":
        return ab_u8(8)
    if value == "FileError":
        return ab_u8(9)
    if value == "Option[Int]":
        return ab_join([ab_u8(10), ab_u8(0)])
    if value == "Float64":
        return ab_u8(12)
    if value == "Bytes":
        return ab_u8(14)
    if value == "HttpError":
        return ab_u8(15)
    if value == "FileReader" or value == "Db" or value == "Transaction" or value == "TomlDocument":
        return ab_join([ab_u8(17), ab_string(value)])
    if ab_starts(value, "List["):
        return ab_join([ab_u8(4), ab_type(ab_type_inner(value, 5))])
    if ab_starts(value, "Result["):
        let inner = ab_type_inner(value, 7)
        return ab_join([ab_u8(5), ab_type(ab_type_argument(inner, 0)), ab_type(ab_type_argument(inner, 1))])
    if ab_starts(value, "Option["):
        return ab_join([ab_u8(10), ab_type(ab_type_inner(value, 7))])
    if ab_starts(value, "Map["):
        let inner = ab_type_inner(value, 4)
        let comma = ab_type_comma(inner)
        var item_type = inner
        if comma >= 0:
            set item_type = ab_type_argument(inner, 1)
        return ab_join([ab_u8(11), ab_type(item_type)])
    if ab_starts(value, "Record["):
        return ab_join([ab_u8(13), ab_string(ab_type_inner(value, 7))])
    return ab_u8(255)

fn ab_span(value: Json, pc: Int) -> Bytes:
    return ab_join([ab_u32(ab_json_int_or(value, "source_id", 0)), ab_u64(ab_json_int_or(value, "start", 0)), ab_u64(ab_json_int_or(value, "end", 0)), ab_u64(ab_json_int_or(value, "line", 1)), ab_u64(ab_json_int_or(value, "column", pc + 1))])

fn ab_instruction_span(instruction: Json, pc: Int, source_id: Int) -> Bytes:
    if json_has(instruction, "span"):
        let span = json_set(json_get(instruction, "span"), "source_id", json_int(source_id))
        return ab_span(span, pc)
    return ab_join([ab_u32(source_id), ab_u64(0), ab_u64(0), ab_u64(1), ab_u64(pc + 1)])

fn ab_encode_trace(trace: Json) -> Bytes:
    var parts: List[Bytes] = [ab_count(json_len(trace))]
    var cursor = 0
    while cursor < json_len(trace):
        set parts = list_push(parts, ab_span(json_index(trace, cursor), 0))
        set cursor = cursor + 1
    return ab_join(parts)

fn ab_int_items(values: Json) -> List[Int]:
    var result: List[Int] = []
    var cursor = 0
    while cursor < json_len(values):
        set result = list_push(result, json_as_int(json_index(values, cursor)))
        set cursor = cursor + 1
    return result

fn ab_encode_value(value: Json, depth: Int) -> Bytes:
    if depth > 64:
        return ab_u8(255)
    let kind = json_as_text(json_get(value, "kind"))
    if kind == "Int":
        return ab_join([ab_u8(0), ab_string(ab_decimal_integer(json_as_text(json_get(value, "value"))))])
    if kind == "Bool":
        var bit = 0
        if json_as_bool(json_get(value, "value")):
            set bit = 1
        return ab_join([ab_u8(1), ab_u8(bit)])
    if kind == "Text":
        return ab_join([ab_u8(2), ab_string(json_as_text(json_get(value, "value")))])
    if kind == "Unit":
        return ab_u8(3)
    if kind == "List":
        let items = json_get(value, "items")
        var parts: List[Bytes] = [ab_u8(4), ab_count(json_len(items))]
        var cursor = 0
        while cursor < json_len(items):
            set parts = list_push(parts, ab_encode_value(json_index(items, cursor), depth + 1))
            set cursor = cursor + 1
        return ab_join(parts)
    if kind == "ResultOk" or kind == "ResultErr" or kind == "OptionSome":
        var tag = 5
        if kind == "ResultErr":
            set tag = 6
        else:
            if kind == "OptionSome":
                set tag = 12
        return ab_join([ab_u8(tag), ab_encode_value(json_get(value, "value"), depth + 1)])
    if kind == "TaskError":
        return ab_join([ab_u8(7), ab_string(ab_decimal_integer(json_as_text(json_get(value, "index")))), ab_string(json_as_text(json_get(value, "code"))), ab_string(json_as_text(json_get(value, "message"))), ab_encode_trace(json_get(value, "trace"))])
    if kind == "Json":
        return ab_join([ab_u8(8), ab_string(json_stringify(json_get(value, "value")))])
    if kind == "JsonError":
        return ab_join([ab_u8(9), ab_string(json_as_text(json_get(value, "code"))), ab_string(json_as_text(json_get(value, "message"))), ab_count(json_as_int(json_get(value, "line"))), ab_count(json_as_int(json_get(value, "column")))])
    if kind == "FileError":
        return ab_join([ab_u8(10), ab_string(json_as_text(json_get(value, "code"))), ab_string(json_as_text(json_get(value, "message"))), ab_encode_trace(json_get(value, "trace"))])
    if kind == "OptionNone":
        return ab_u8(11)
    if kind == "Map":
        let entries = json_get(value, "entries")
        var parts: List[Bytes] = [ab_u8(13), ab_count(json_len(entries))]
        var cursor = 0
        while cursor < json_len(entries):
            let item = json_index(entries, cursor)
            set parts = list_push(parts, ab_string(json_as_text(json_get(item, "key"))))
            set parts = list_push(parts, ab_encode_value(json_get(item, "value"), depth + 1))
            set cursor = cursor + 1
        return ab_join(parts)
    if kind == "Float64":
        return ab_join([ab_u8(14), ab_u64(float64_bits(json_as_float(json_get(value, "value"))))])
    if kind == "Record":
        let fields = json_get(value, "fields")
        var parts: List[Bytes] = [ab_u8(15), ab_string(json_as_text(json_get(value, "name"))), ab_count(json_len(fields))]
        var cursor = 0
        while cursor < json_len(fields):
            set parts = list_push(parts, ab_encode_value(json_index(fields, cursor), depth + 1))
            set cursor = cursor + 1
        return ab_join(parts)
    if kind == "Bytes":
        return ab_join([ab_u8(16), ab_blob(bytes_from_ints(ab_int_items(json_get(value, "items"))))])
    if kind == "HttpError":
        return ab_join([ab_u8(17), ab_string(json_as_text(json_get(value, "code"))), ab_string(json_as_text(json_get(value, "message"))), ab_encode_trace(json_get(value, "trace"))])
    return ab_u8(255)

fn ab_decimal_integer(value: Text) -> Text:
    return json_stringify(json_int(json_as_int(unwrap(json_parse(value)))))

fn ab_constant(instruction: Json) -> Bytes:
    let operation = json_as_text(json_get(instruction, "op"))
    if operation == "ConstInt":
        let int_value = json_get(instruction, "value")
        return ab_join([ab_u8(0), ab_string(ab_decimal_integer(json_as_text(int_value)))])
    if operation == "ConstBool":
        let bool_value = json_get(instruction, "value")
        var bit = 0
        if json_as_bool(bool_value):
            set bit = 1
        return ab_join([ab_u8(1), ab_u8(bit)])
    if operation == "ConstText":
        let text_value = json_get(instruction, "value")
        return ab_join([ab_u8(2), ab_string(json_as_text(text_value))])
    if operation == "ConstFloat64":
        let float_value = json_get(instruction, "value")
        let parsed = unwrap(json_parse(json_as_text(float_value)))
        return ab_join([ab_u8(14), ab_u64(float64_bits(json_as_float(parsed)))])
    if operation == "ConstUnit":
        return ab_u8(3)
    if operation == "ConstValue":
        let encoded_value = json_get(instruction, "value")
        return ab_encode_value(encoded_value, 0)
    return ab_u8(255)

fn ab_function_index(functions: Json, name: Text) -> Int:
    var cursor = 0
    while cursor < json_len(functions):
        if json_as_text(json_get(json_index(functions, cursor), "name")) == name:
            return cursor
        set cursor = cursor + 1
    return -1

fn ab_record_index(records: Json, name: Text) -> Int:
    var cursor = 0
    while cursor < json_len(records):
        if json_as_text(json_get(json_index(records, cursor), "name")) == name:
            return cursor
        set cursor = cursor + 1
    return -1

fn ab_external_index(externals: Json, name: Text) -> Int:
    var cursor = 0
    while cursor < json_len(externals):
        if json_as_text(json_get(json_index(externals, cursor), "name")) == name:
            return cursor
        set cursor = cursor + 1
    return -1

fn ab_field_index(record: Json, name: Text) -> Int:
    let fields = json_get(record, "fields")
    var cursor = 0
    while cursor < json_len(fields):
        if json_as_text(json_get(json_index(fields, cursor), "name")) == name:
            return cursor
        set cursor = cursor + 1
    return -1

fn ab_label_key(value: Json) -> Text:
    return json_stringify(json_int(json_as_int(value)))

fn ab_target(instruction: Json, labels: Json) -> Int:
    if json_has(instruction, "label_id"):
        return json_as_int(json_get(labels, ab_label_key(json_get(instruction, "label_id"))))
    return json_as_int(json_get(instruction, "target"))

