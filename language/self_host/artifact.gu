fn ab_instruction(instruction: Json, pc: Int, functions: Json, records: Json, externals: Json, labels: Json, source_id: Int) -> Bytes:
    let name = json_as_text(json_get(instruction, "op"))
    if name == "ConstInt" or name == "ConstBool" or name == "ConstText" or name == "ConstFloat64" or name == "ConstUnit" or name == "ConstValue":
        return ab_join([ab_instruction_span(instruction, pc, source_id), ab_u8(0), ab_constant(instruction)])
    let tag = ab_plain_opcode(name)
    if tag < 0:
        return ab_u8(255)
    var parts: List[Bytes] = [ab_instruction_span(instruction, pc, source_id), ab_u8(tag)]
    if name == "Load" or name == "Store" or name == "MakeList" or name == "MakeMap" or name == "ListSetLocal" or name == "ListPushLocal" or name == "JsonPushLocal":
        var field = "local"
        if name == "MakeList" or name == "MakeMap":
            set field = "count"
        set parts = list_push(parts, ab_count(json_as_int(json_get(instruction, field))))
    else:
        if name == "Jump" or name == "JumpIfFalse":
            set parts = list_push(parts, ab_count(ab_target(instruction, labels)))
        else:
            if name == "Call" or name == "ParallelMap" or name == "SortBy" or name == "SortByIntKey" or name == "MergeSortedByIntKey":
                let target = ab_function_index(functions, json_as_text(json_get(instruction, "function")))
                set parts = list_push(parts, ab_count(target))
                if name == "Call":
                    set parts = list_push(parts, ab_count(json_as_int(json_get(instruction, "argc"))))
            else:
                if name == "PythonCall" or name == "PythonCallKw":
                    let target = ab_external_index(externals, json_as_text(json_get(instruction, "function")))
                    set parts = list_push(parts, ab_count(target))
                    set parts = list_push(parts, ab_count(json_as_int(json_get(instruction, "argc"))))
                    if name == "PythonCallKw":
                        let names = json_get(instruction, "keyword_names")
                        set parts = list_push(parts, ab_count(json_len(names)))
                        var name_cursor = 0
                        while name_cursor < json_len(names):
                            set parts = list_push(parts, ab_string(json_as_text(json_index(names, name_cursor))))
                            set name_cursor = name_cursor + 1
                else:
                    if name == "MakeRecord" or name == "GetField":
                        let record_name = json_as_text(json_get(instruction, "record"))
                        let record_slot = ab_record_index(records, record_name)
                        set parts = list_push(parts, ab_count(record_slot))
                        if name == "MakeRecord":
                            set parts = list_push(parts, ab_count(json_as_int(json_get(instruction, "count"))))
                        else:
                            set parts = list_push(parts, ab_count(ab_field_index(json_index(records, record_slot), json_as_text(json_get(instruction, "field")))))
                    else:
                        if name == "MakeTypedList" or name == "MakeTypedMap":
                            set parts = list_push(parts, ab_type(json_as_text(json_get(instruction, "item_type"))))
    return ab_join(parts)

fn ab_encode_record(record: Json) -> Bytes:
    let fields = json_get(record, "fields")
    var parts: List[Bytes] = [ab_string(json_as_text(json_get(record, "name"))), ab_count(json_len(fields))]
    var cursor = 0
    while cursor < json_len(fields):
        let field = json_index(fields, cursor)
        set parts = list_push(parts, ab_string(json_as_text(json_get(field, "name"))))
        set parts = list_push(parts, ab_type(json_as_text(json_get(field, "type"))))
        set cursor = cursor + 1
    return ab_join(parts)

fn ab_encode_external(external: Json) -> Bytes:
    let parameters = json_get(external, "parameters")
    let names = json_get(external, "parameter_names")
    var parts: List[Bytes] = [ab_string(json_as_text(json_get(external, "name"))), ab_string(json_as_text(json_get(external, "module"))), ab_string(json_as_text(json_get(external, "callable"))), ab_count(json_len(parameters))]
    var cursor = 0
    while cursor < json_len(parameters):
        set parts = list_push(parts, ab_string(json_as_text(json_index(names, cursor))))
        set parts = list_push(parts, ab_type(json_as_text(json_index(parameters, cursor))))
        set cursor = cursor + 1
    set parts = list_push(parts, ab_type(json_as_text(json_get(external, "result"))))
    return ab_join(parts)

fn ab_encode_function(function: Json, functions: Json, records: Json, externals: Json) -> Bytes:
    let parameters = json_get(function, "parameters")
    let code = json_get(function, "code")
    let source_id = ab_json_int_or(function, "source_id", 0)
    var labels = json_object()
    var executable_count = 0
    var cursor = 0
    while cursor < json_len(code):
        let instruction = json_index(code, cursor)
        let name = json_as_text(json_get(instruction, "op"))
        if name == "Label":
            set labels = json_set(labels, ab_label_key(json_get(instruction, "id")), json_int(executable_count))
        else:
            set executable_count = executable_count + 1
        set cursor = cursor + 1
    var parts: List[Bytes] = [ab_string(json_as_text(json_get(function, "name"))), ab_count(json_len(parameters))]
    set cursor = 0
    while cursor < json_len(parameters):
        set parts = list_push(parts, ab_type(json_as_text(json_index(parameters, cursor))))
        set cursor = cursor + 1
    set parts = list_push(parts, ab_type(json_as_text(json_get(function, "result"))))
    set parts = list_push(parts, ab_count(json_as_int(json_get(function, "local_count"))))
    set parts = list_push(parts, ab_count(executable_count))
    set cursor = 0
    while cursor < json_len(code):
        let instruction = json_index(code, cursor)
        if json_as_text(json_get(instruction, "op")) != "Label":
            set parts = list_push(parts, ab_instruction(instruction, cursor, functions, records, externals, labels, source_id))
        set cursor = cursor + 1
    return ab_join(parts)

fn ab_optional_string(value: Json, key: Text) -> Bytes:
    if not json_has(value, key):
        return ab_u8(0)
    let item = json_get(value, key)
    if json_is_null(item):
        return ab_u8(0)
    return ab_join([ab_u8(1), ab_string(json_as_text(item))])

fn ab_encode_metadata(metadata: Json) -> Bytes:
    let limits = json_get(metadata, "resource_limits")
    return ab_join([ab_u8(1), ab_string(json_as_text(json_get(metadata, "compiler_version"))), ab_string(json_as_text(json_get(metadata, "target"))), ab_u32(ab_json_int_or(metadata, "metadata_schema_version", 1)), ab_optional_string(metadata, "source_sha256"), ab_optional_string(metadata, "dependency_lock_sha256"), ab_u64(json_as_int(json_get(limits, "instruction_limit"))), ab_u64(json_as_int(json_get(limits, "allocation_limit_bytes"))), ab_u64(json_as_int(json_get(limits, "call_depth_limit"))), ab_u64(json_as_int(json_get(limits, "output_limit_bytes"))), ab_u64(json_as_int(json_get(limits, "max_integer_digits"))), ab_u64(json_as_int(json_get(limits, "max_text_bytes"))), ab_u64(json_as_int(json_get(limits, "max_collection_items"))), ab_u64(json_as_int(json_get(limits, "max_parallelism"))), ab_u64(json_as_int(json_get(limits, "max_file_bytes")))])

pub fn artifact_assemble(ir: Json) -> Bytes:
    let source_name = json_as_text(json_get(ir, "source_name"))
    let entry = json_as_text(json_get(ir, "entry"))
    let sources = json_get(ir, "sources")
    let records = json_get(ir, "records")
    let externals = json_get(ir, "externals")
    let functions = json_get(ir, "functions")
    var parts: List[Bytes] = [bytes_from_text("VRTA"), ab_u32(40), ab_string(source_name), ab_string(entry), ab_count(json_len(sources))]
    var cursor = 0
    while cursor < json_len(sources):
        set parts = list_push(parts, ab_string(json_as_text(json_index(sources, cursor))))
        set cursor = cursor + 1
    set parts = list_push(parts, ab_count(json_len(records)))
    set cursor = 0
    while cursor < json_len(records):
        set parts = list_push(parts, ab_encode_record(json_index(records, cursor)))
        set cursor = cursor + 1
    set parts = list_push(parts, ab_count(json_len(externals)))
    set cursor = 0
    while cursor < json_len(externals):
        set parts = list_push(parts, ab_encode_external(json_index(externals, cursor)))
        set cursor = cursor + 1
    set parts = list_push(parts, ab_count(json_len(functions)))
    set cursor = 0
    while cursor < json_len(functions):
        set parts = list_push(parts, ab_encode_function(json_index(functions, cursor), functions, records, externals))
        set cursor = cursor + 1
    if json_has(ir, "build_metadata") and not json_is_null(json_get(ir, "build_metadata")):
        set parts = list_push(parts, ab_encode_metadata(json_get(ir, "build_metadata")))
    else:
        set parts = list_push(parts, ab_u8(0))
    return ab_join(parts)
