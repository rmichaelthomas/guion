fn builtin_catalog_part(value: Text, delimiter: Text, wanted: Int) -> Text:
    var cursor = 0
    var part = 0
    var result = ""
    while cursor <= len(value):
        if cursor == len(value) or value[cursor] == delimiter:
            if part == wanted:
                return result
            set part = part + 1
            set result = ""
        else:
            if part == wanted:
                set result = result + value[cursor]
        set cursor = cursor + 1
    return ""

pub fn builtin_catalog_has(name: Text) -> Bool:
    return builtin_catalog_signature(name) != ""

pub fn builtin_catalog_arity(name: Text) -> Int:
    let value = builtin_catalog_part(builtin_catalog_signature(name), ":", 0)
    if value == "0":
        return 0
    if value == "1":
        return 1
    if value == "2":
        return 2
    if value == "3":
        return 3
    if value == "4":
        return 4
    if value == "5":
        return 5
    return -1

pub fn builtin_catalog_operation(name: Text) -> Text:
    return builtin_catalog_part(builtin_catalog_signature(name), ":", 1)

pub fn builtin_catalog_result(name: Text) -> Text:
    return builtin_catalog_part(builtin_catalog_signature(name), ":", 2)

pub fn builtin_catalog_parameter_type(name: Text, index: Int) -> Text:
    let parameters = builtin_catalog_part(builtin_catalog_signature(name), ":", 3)
    return builtin_catalog_part(parameters, ";", index)
