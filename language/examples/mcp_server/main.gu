import "std:io"
import "std:types"

# A Model Context Protocol server over stdio: one JSON-RPC 2.0 message per line.
# Tools: `echo`, which returns its `text` argument.
#
# Try it: guion run language/examples/mcp_server

fn ok_reply(id: Json, result: Json) -> Json:
    var reply = json_object()
    set reply = json_set(reply, "jsonrpc", json_text("2.0"))
    set reply = json_set(reply, "id", id)
    set reply = json_set(reply, "result", result)
    return reply

fn error_reply(id: Json, code: Int, message: Text) -> Json:
    var problem = json_object()
    set problem = json_set(problem, "code", json_int(code))
    set problem = json_set(problem, "message", json_text(message))
    var reply = json_object()
    set reply = json_set(reply, "jsonrpc", json_text("2.0"))
    set reply = json_set(reply, "id", id)
    set reply = json_set(reply, "error", problem)
    return reply

fn initialize_result(request: Json) -> Json:
    var version = "2024-11-05"
    if json_has(request, "params"):
        let params = json_get(request, "params")
        if json_has(params, "protocolVersion"):
            set version = json_as_text(json_get(params, "protocolVersion"))
    var info = json_object()
    set info = json_set(info, "name", json_text("guion-example"))
    set info = json_set(info, "version", json_text("0.1.0"))
    var capabilities = json_object()
    set capabilities = json_set(capabilities, "tools", json_object())
    var result = json_object()
    set result = json_set(result, "protocolVersion", json_text(version))
    set result = json_set(result, "capabilities", capabilities)
    set result = json_set(result, "serverInfo", info)
    return result

fn tools_list_result() -> Json:
    var text_property = json_object()
    set text_property = json_set(text_property, "type", json_text("string"))
    var properties = json_object()
    set properties = json_set(properties, "text", text_property)
    var required = json_array()
    set required = json_push(required, json_text("text"))
    var schema = json_object()
    set schema = json_set(schema, "type", json_text("object"))
    set schema = json_set(schema, "properties", properties)
    set schema = json_set(schema, "required", required)
    var tool = json_object()
    set tool = json_set(tool, "name", json_text("echo"))
    set tool = json_set(tool, "description", json_text("Return the text it is given."))
    set tool = json_set(tool, "inputSchema", schema)
    var tools = json_array()
    set tools = json_push(tools, tool)
    var result = json_object()
    set result = json_set(result, "tools", tools)
    return result

fn echo_result(text: Text) -> Json:
    var part = json_object()
    set part = json_set(part, "type", json_text("text"))
    set part = json_set(part, "text", json_text(text))
    var content = json_array()
    set content = json_push(content, part)
    var result = json_object()
    set result = json_set(result, "content", content)
    return result

# The `text` argument of a tools/call for `echo`, or None when the call is malformed.
fn echo_argument(request: Json) -> Option[Text]:
    if not json_has(request, "params"):
        return None
    let params = json_get(request, "params")
    if not json_has(params, "name"):
        return None
    if json_as_text(json_get(params, "name")) != "echo":
        return None
    if not json_has(params, "arguments"):
        return None
    let arguments = json_get(params, "arguments")
    if not json_has(arguments, "text"):
        return None
    return Some(json_as_text(json_get(arguments, "text")))

# One reply line per request; a notification (no `id`) gets none.
fn handle(request: Json) -> Option[Json]:
    if not json_has(request, "method"):
        return Some(error_reply(json_null(), -32600, "Invalid Request"))
    if not json_has(request, "id"):
        return None
    let id = json_get(request, "id")
    let method = json_as_text(json_get(request, "method"))
    if method == "initialize":
        return Some(ok_reply(id, initialize_result(request)))
    if method == "ping":
        return Some(ok_reply(id, json_object()))
    if method == "tools/list":
        return Some(ok_reply(id, tools_list_result()))
    if method == "tools/call":
        match echo_argument(request):
            Some(text):
                return Some(ok_reply(id, echo_result(text)))
            None:
                return Some(error_reply(id, -32602, "Unknown tool or bad arguments"))
    return Some(error_reply(id, -32601, "Method not found"))

fn main() -> Int:
    var going = true
    while going:
        match stdin_read_line():
            Ok(next):
                match next:
                    Some(line):
                        if len(line) > 0:
                            match json_parse(line):
                                Ok(request):
                                    let answer = handle(request)
                                    if is_some(answer):
                                        print(json_stringify(unwrap(answer)))
                                Err(problem):
                                    print(json_stringify(error_reply(json_null(), -32700, "Parse error")))
                    None:
                        set going = false
            Err(problem):
                set going = false
    return 0
