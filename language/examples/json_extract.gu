fn main() -> Int:
    let document = unwrap(json_parse("{\"name\":\"Guion\",\"count\":123456789012345678901}"))
    let name = json_as_text(json_get(document, "name"))
    let count = json_as_int(json_get(document, "count"))
    print(name)
    print(count)
    print(json_stringify(document))
    return 0
