import "std:types"
import "std:crypto"
import "std:encoding"
import "std:text"

# Stamp a message with a trusted timestamp from DigiCert (RFC 3161) and check the answer.
#
# 1. Hash the message with SHA-512.
# 2. Build a timestamp request for that digest with a fresh 8-byte nonce. A nonce's first byte must be
#    0x01 to 0x7f, so it is forced into that range.
# 3. POST it to the TSA with http_request_bytes.
# 4. Take the token out of the response and verify it against the DigiCert certificates pinned below
#    (the signer and its issuer), for this digest.
# 5. Check that the TSA echoed our nonce, and print the time it vouches for.
#
# Run it with the network host granted by guion.toml:
#   guion run main.gu
# or replay the recorded answer with no network at all (this is what the example's test does):
#   guion run --replay tapes/tsa-live.tape main.gu
# and to record again:
#   guion run --record tapes/tsa-live.tape main.gu
# A new recording stamps a new time, so the pinned certificates must still be the ones DigiCert signs
# with; crypto_tsa_certificates(token) lists the certificates a token carries when they rotate.

