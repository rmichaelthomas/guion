fn certificate(pem: Text) -> Bytes:
    return unwrap(crypto_pem_decode(pem))

# Eight random bytes whose first byte is 0x01 to 0x7f.
fn make_nonce() -> Bytes:
    let drawn = unwrap(crypto_random_bytes(8))
    let forced = int_or(int_and(drawn[0], 127), 1)
    return bytes_join([bytes_from_ints([forced]), bytes_slice(drawn, 1, 8)])

# POST the request to DigiCert and return the token from its answer.
fn fetch_token(request: Bytes) -> Result[Bytes, StdError]:
    let headers: Map[Text, Text] = {"content-type": "application/timestamp-query"}
    match http_request_bytes("POST", "http://timestamp.digicert.com", headers, request, 10000):
        Err(problem):
            return Err(std_error("E_TSA_HTTP", http_error_code(problem)))
        Ok(response):
            if response.status != 200:
                return Err(std_error("E_TSA_HTTP", "the TSA answered HTTP " + int_to_text(response.status)))
            return crypto_tsa_response_token(response.body)

fn fail(what: Text) -> Int:
    print("timestamp failed: " + what)
    return 1

# Check the token against the pinned certificates, then print what it says.
fn report(token: Bytes, digest: Bytes, nonce: Bytes) -> Int:
    let tsa = certificate(digicert_tsa_pem())
    let issuer = certificate(digicert_issuer_pem())
    match crypto_tsa_verify(token, digest, tsa, issuer):
        Err(problem):
            return fail(problem.code + " " + problem.message)
        Ok(None):
            return fail("the token is not a DigiCert timestamp of this message")
        Ok(Some(stamp)):
            if stamp.nonce != nonce:
                return fail("the token does not echo our nonce")
            print("verified: the token is DigiCert's, for this message, with our nonce")
            print("time: " + int_to_text(stamp.gen_time_ms) + " ms since 1970 (UTC)")
            print("policy: " + stamp.policy)
            print("serial: " + hex_encode(stamp.serial))
            return 0

fn main() -> Int:
    let message = bytes_from_text("The Lotcast draw for round 1 was sealed before the numbers were known.")
    let digest = crypto_sha512(message)
    let nonce = make_nonce()
    let request = unwrap(crypto_tsa_request(digest, nonce))
    match fetch_token(request):
        Err(problem):
            return fail(problem.code + " " + problem.message)
        Ok(token):
            return report(token, digest, nonce)
