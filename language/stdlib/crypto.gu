import "std:encoding"
import "std:types"
import "std:text"
import "std:json"
pub import "std:http_types"

# std:crypto: HMAC-SHA-256, SHA-256, SHA-512, SHA3-512 and SHA-1 digests, and byte XOR.
#
# crypto_sha256 and crypto_sha256_text digest a value held in memory and return the 32-byte
# digest. crypto_sha256_file reads the file in fixed-size blocks, so memory stays constant for
# any file size; it needs the file-read grant (effect filesystem.read) and returns a typed
# StdError for a missing or ungranted path.
#
# crypto_sha512 and crypto_sha3_512 digest a value held in memory and return the 64-byte digest
# (SHA-512 from FIPS 180-4, SHA3-512 from FIPS 202). Both are pure and need no grant.
#
# crypto_rsa_verify, crypto_ecdsa_p256_verify and crypto_x509_rsa_public_key check signatures
# against public keys (artifact format 79); they are pure, need no grant, and never sign. A
# malformed key, signature length, scheme or certificate is a typed StdError (E_CRYPTO_INPUT,
# E_CRYPTO_SCHEME, E_X509); a well-formed signature that does not verify is Ok(false).
# crypto_rsa_verify takes the big-endian modulus and exponent and a scheme, one of
# "pkcs1v15-sha256", "pkcs1v15-sha512" or "pss-sha256". crypto_ecdsa_p256_verify takes a SEC1
# public key (65 bytes uncompressed) and the raw 64-byte r||s signature over SHA-256 of the
# message, as JWS writes it. crypto_x509_rsa_public_key reads a DER certificate and gives
# [modulus, exponent]. crypto_bls12381_verify_g1 (artifact format 80) checks a BLS12-381
# min-signature: a 96-byte compressed G2 public key, the message bytes, a 48-byte compressed G1
# signature and the caller's domain separation tag (drand quicknet signs SHA-256 of the round as
# 8 big-endian bytes under "BLS_SIG_BLS12381G1_XMD:SHA-256_SSWU_RO_NUL_"); a point that is
# malformed or outside the subgroup is E_CRYPTO_INPUT.
#
# crypto_x509_verify_issued_by(certificate_der, issuer_der) (artifact format 84) is true when the
# certificate's issuer name is the issuer certificate's subject name and the certificate's signature
# verifies under the issuer's key: RSA PKCS#1 v1.5 or PSS with SHA-256, SHA-384 or SHA-512, and ECDSA
# with SHA-256, SHA-384 or SHA-512 under a P-256 or P-384 key, whichever the certificate names. A
# name mismatch, a key of the wrong type or a signature that does not verify is Ok(false); input that
# is not DER X.509 is E_X509; any other algorithm (SHA-1, P-521, Ed25519) is E_X509_ALG. A certificate
# whose outer signatureAlgorithm differs from the one inside its tbsCertificate is Ok(false), and for
# RSASSA-PSS the saltLength in the certificate's parameters is honoured (a trailerField other than 1 is
# E_X509). It checks one link only: not validity dates, extensions such as CA:TRUE, or revocation. Read
# those yourself with the two functions below, and compare them to what you expect:
#
# crypto_x509_dns_names(der) (artifact format 85) gives the dNSName entries of the certificate's
# SubjectAltName extension, in order (IP, e-mail and URI entries are skipped); only when the certificate
# has no SubjectAltName extension at all does it give the subject's common names instead. Wildcards are
# returned as written, not expanded. crypto_x509_validity(der) gives [notBefore, notAfter] as Unix
# seconds. Input that is not a DER certificate is E_X509. A name and a date check is what turns "some
# certificate this CA issued" into "the certificate I mean".
#
# crypto_ed25519_public_key(seed), crypto_ed25519_sign(seed, message) and
# crypto_ed25519_verify(public_key, message, signature) (artifact format 86) are pure Ed25519 as in
# RFC 8032 (no Ed25519ph, no context). A key is a 32-byte seed, which you draw yourself with
# crypto_random_bytes(32) and keep secret; the public key is 32 bytes and a signature 64. Signing is
# deterministic: the same seed and message always give the same signature. Verification is strict: a
# small-order public key, a non-canonical R or S (S at or above the group order) and the mixed-order
# edge cases of "Taming the Many EdDSAs" are Ok(false), never Ok(true). A seed that is not 32 bytes, a
# key that is not 32 bytes or is not a point on the curve, or a signature that is not 64 bytes is
# E_CRYPTO_INPUT. Verification returns Ok(true) only for the signature of this exact message.
#
# ECDSA signatures are malleable: crypto_ecdsa_p256_verify accepts both (r, s) and (r, n - s) for a
# valid signature, so never use signature bytes as an identifier or a dedupe key. crypto_rsa_verify
# accepts moduli from 1024 to 8192 bits; "pss-sha256" uses a salt as long as the digest (32 bytes), as
# JWS PS256 requires, and a signature made with another salt length is Ok(false).
#
# crypto_tlock_encrypt, crypto_tlock_decrypt and crypto_tlock_round are drand timelock encryption
# (artifact format 81) in the age format, interoperable with drand's `tle` and tlock-js on a
# G1-signature network such as quicknet. crypto_tlock_encrypt(round, chain_hash, public_key,
# plaintext) takes the 32-byte chain hash and 96-byte compressed G2 network key and returns armored
# age text that only the signature of that round can open; it draws 48 random bytes from the same
# source as crypto_random_bytes. crypto_tlock_decrypt(armored, round_signature) takes the 48-byte
# compressed G1 signature drand publishes for the round: a wrong signature or any change to the file
# is E_TLOCK_DECRYPT, malformed armor or header is E_TLOCK_FORMAT, a bad key or signature length or
# point is E_CRYPTO_INPUT. crypto_tlock_round reads the round from the file's header (unauthenticated).
# crypto_tlock_chain_hash (artifact format 84) reads the 32-byte chain hash from the same header
# (also unauthenticated; E_TLOCK_FORMAT for a malformed file) so a caller can check it against the network it
# means to decrypt for. They are pure: fetching the signature is the caller's job. crypto_pem_decode turns one PEM block into its DER bytes; text that is not
# exactly one well-formed BEGIN/END block is E_CRYPTO_INPUT.
#
# crypto_tsa_request(digest, nonce), crypto_tsa_response_token(response), crypto_tsa_verify(token,
# digest, tsa_cert, issuer_cert) and crypto_tsa_certificates(token) (artifact format 87) are RFC 3161
# trusted timestamps, all pure (no grant): the network round trip is yours, with http_request_bytes.
# crypto_tsa_request builds a DER TimeStampReq for a 64-byte SHA-512 digest (anything else is
# E_TSA_DIGEST) with certReq set, no policy and an optional nonce: at most 32 bytes with a first byte
# of 0x01 to 0x7f, or empty for none (otherwise E_TSA_NONCE). Draw one with crypto_random_bytes and
# force the first byte, and check TsaToken.nonce against it. POST the request with the header
# Content-Type: application/timestamp-query. crypto_tsa_response_token reads the TimeStampResp the
# TSA sends back and gives the token (a CMS ContentInfo): status 0 and 1 are a token; 2 to 5
# (rejection, waiting, revocation warnings) are E_TSA_STATUS with the status, the statusString and the
# failInfo bit names in the message, never a token; anything unreadable is E_TSA_FORMAT.
# crypto_tsa_verify is Ok(Some(TsaToken)) only when the token is for this digest and was signed by
# exactly this tsa_cert (a DER certificate you pinned), which issuer_cert (also pinned) issued, and
# the certificate may time-stamp (the extended key usage timeStamping; RFC 3161 wants it critical, and
# this does not insist, because the certificate is pinned) and was valid at the token's genTime;
# otherwise it is Ok(None), and an unreadable certificate is E_X509, a malformed token E_TSA_FORMAT,
# a signer or ESS algorithm outside SHA-256/384/512 with RSA PKCS#1 v1.5, RSA-PSS or ECDSA P-256 and
# P-384, or a tsa_cert key that is not RSA, P-256 or P-384, E_TSA_ALG, and a digest that is not 64
# bytes E_TSA_DIGEST. A TsaToken has gen_time_ms (genTime as Unix milliseconds; finer digits are
# truncated), accuracy_ms (the TSA's stated accuracy, microseconds rounded up, 0 if none), serial,
# policy (a dotted OID) and nonce (empty if the TSA echoed none). The time is the TSA's claim about
# when it signed, valid at that moment; today's date and revocation are not examined. crypto_tsa_certificates
# lists the DER certificates a token carries, in order, so a program can pin them on first use.
#
# crypto_random_bytes, crypto_random_hex and crypto_random_base64url draw unpredictable bytes
# from the operating system's cryptographic generator (getentropy on macOS, getrandom on Linux).
# `count` is the number of random BYTES, so crypto_random_hex(32) is 64 hex digits and
# crypto_random_base64url(32) is 44 characters. At most crypto_random_max_bytes() (1 MiB) may be
# drawn per call; a count of 0 gives empty bytes; a negative count or one above the maximum is
# the typed error E_RANDOM_COUNT, never a clamp; a failing OS source is E_ENTROPY_UNAVAILABLE.
# No grant is needed: drawing entropy reads nothing, opens nothing and sends nothing.
#
# Programs that call these are NOT reproducible: two runs never give the same output, and no
# determinism claim covers them. Use std:random with a seed when a repeatable sequence is wanted,
# and never use std:random for tokens, salts or keys. An embedding can pin the source for tests
# with HostPolicy::with_entropy_source; that is not reachable from a program or from guion.toml.

pub fn crypto_hmac_sha256(key: Bytes, body: Bytes) -> Bytes:
    return native_crypto_hmac_sha256(key, body)

pub fn crypto_verify_hmac_sha256(key: Bytes, body: Bytes, expected: Bytes) -> Bool:
    return native_crypto_verify_hmac_sha256(key, body, expected)

pub fn crypto_sha256(data: Bytes) -> Bytes:
    return native_crypto_sha256(data)

pub fn crypto_sha256_text(text: Text) -> Bytes:
    return native_crypto_sha256(bytes_from_text(text))

pub fn crypto_sha512(data: Bytes) -> Bytes:
    return native_crypto_sha512(data)

pub fn crypto_sha3_512(data: Bytes) -> Bytes:
    return native_crypto_sha3_512(data)

pub fn crypto_rsa_verify(modulus: Bytes, exponent: Bytes, message: Bytes, signature: Bytes, scheme: Text) -> Result[Bool, StdError]:
    return native_crypto_rsa_verify(modulus, exponent, message, signature, scheme)

pub fn crypto_ecdsa_p256_verify(public_key: Bytes, message: Bytes, signature: Bytes) -> Result[Bool, StdError]:
    return native_crypto_ecdsa_p256_verify(public_key, message, signature)

pub fn crypto_bls12381_verify_g1(public_key: Bytes, message: Bytes, signature: Bytes, dst: Bytes) -> Result[Bool, StdError]:
    return native_crypto_bls12381_verify_g1(public_key, message, signature, dst)

pub fn crypto_tlock_encrypt(round: Int, chain_hash: Bytes, public_key: Bytes, plaintext: Bytes) -> Result[Text, StdError]:
    match native_crypto_random_bytes(48):
        Ok(randomness):
            return native_crypto_tlock_encrypt(round, chain_hash, public_key, plaintext, randomness)
        Err(problem):
            return Err(problem)

pub fn crypto_tlock_decrypt(armored: Text, round_signature: Bytes) -> Result[Bytes, StdError]:
    return native_crypto_tlock_decrypt(armored, round_signature)

pub fn crypto_tlock_round(armored: Text) -> Result[Int, StdError]:
    return native_crypto_tlock_round(armored)

pub fn crypto_tlock_chain_hash(armored: Text) -> Result[Bytes, StdError]:
    return native_crypto_tlock_chain_hash(armored)

pub fn crypto_x509_verify_issued_by(certificate_der: Bytes, issuer_der: Bytes) -> Result[Bool, StdError]:
    return native_crypto_x509_verify_issued_by(certificate_der, issuer_der)

pub fn crypto_x509_dns_names(der: Bytes) -> Result[List[Text], StdError]:
    return native_crypto_x509_dns_names(der)

pub fn crypto_x509_validity(der: Bytes) -> Result[List[Int], StdError]:
    return native_crypto_x509_validity(der)

pub fn crypto_ed25519_public_key(seed: Bytes) -> Result[Bytes, StdError]:
    return native_crypto_ed25519_public_key(seed)

pub fn crypto_ed25519_sign(seed: Bytes, message: Bytes) -> Result[Bytes, StdError]:
    return native_crypto_ed25519_sign(seed, message)

pub fn crypto_ed25519_verify(public_key: Bytes, message: Bytes, signature: Bytes) -> Result[Bool, StdError]:
    return native_crypto_ed25519_verify(public_key, message, signature)

pub record TsaToken:
    gen_time_ms: Int
    accuracy_ms: Int
    serial: Bytes
    policy: Text
    nonce: Bytes

pub fn crypto_tsa_request(digest: Bytes, nonce: Bytes) -> Result[Bytes, StdError]:
    return native_crypto_tsa_request(digest, nonce)

pub fn crypto_tsa_response_token(response: Bytes) -> Result[Bytes, StdError]:
    return native_crypto_tsa_response_token(response)

pub fn crypto_tsa_certificates(token: Bytes) -> Result[List[Bytes], StdError]:
    return native_crypto_tsa_certificates(token)

fn tsa_result_error(key: Text) -> StdError:
    return std_error("E_TSA_FORMAT", "the timestamp result has no usable field " + key)

fn tsa_result_int(found: Json, key: Text) -> Result[Int, StdError]:
    match json_get_int_safe(found, key):
        Ok(value):
            return Ok(value)
        Err(problem):
            return Err(tsa_result_error(key))

fn tsa_result_text(found: Json, key: Text) -> Result[Text, StdError]:
    match json_get_text_safe(found, key):
        Ok(value):
            return Ok(value)
        Err(problem):
            return Err(tsa_result_error(key))

fn tsa_result_bytes(found: Json, key: Text) -> Result[Bytes, StdError]:
    let text = tsa_result_text(found, key)?
    return hex_decode(text)

pub fn crypto_tsa_verify(token: Bytes, digest: Bytes, tsa_cert: Bytes, issuer_cert: Bytes) -> Result[Option[TsaToken], StdError]:
    let found = native_crypto_tsa_verify(token, digest, tsa_cert, issuer_cert)?
    match json_get_safe(found, "gen_time_ms"):
        Err(absent):
            return Ok(None)
        Ok(first):
            let gen_time_ms = tsa_result_int(found, "gen_time_ms")?
            let accuracy_ms = tsa_result_int(found, "accuracy_ms")?
            let serial = tsa_result_bytes(found, "serial_hex")?
            let policy = tsa_result_text(found, "policy")?
            let nonce = tsa_result_bytes(found, "nonce_hex")?
            return Ok(Some(TsaToken(gen_time_ms, accuracy_ms, serial, policy, nonce)))

pub fn crypto_x509_rsa_public_key(der: Bytes) -> Result[List[Bytes], StdError]:
    return native_crypto_x509_rsa_public_key(der)

fn pem_error(message: Text) -> StdError:
    return std_error("E_CRYPTO_INPUT", message)

# A `-----BEGIN X-----` or `-----END X-----` line: the dashes at both ends and the word after them.
fn pem_marker(line: Text, word: Text) -> Bool:
    let size = len(line)
    let lead = len(word) + 5
    if size < lead + 5:
        return false
    if text_slice(line, 0, lead) != "-----" + word:
        return false
    return text_slice(line, size - 5, size) == "-----"

pub fn crypto_pem_decode(text: Text) -> Result[Bytes, StdError]:
    let lines = text_split(text_replace(text, "\r", ""), "\n")
    var state = 0
    var body = ""
    var index = 0
    while index < len(lines):
        let line = text_trim(lines[index])
        set index = index + 1
        if line == "":
            continue
        if pem_marker(line, "BEGIN "):
            if state != 0:
                return Err(pem_error("PEM text has more than one BEGIN line"))
            set state = 1
            continue
        if pem_marker(line, "END "):
            if state != 1:
                return Err(pem_error("PEM END line without a BEGIN line"))
            set state = 2
            continue
        if state != 1:
            return Err(pem_error("PEM text has content outside its BEGIN and END lines"))
        set body = body + line
    if state != 2:
        return Err(pem_error("PEM text needs one BEGIN line and one END line"))
    match base64_decode(body):
        Ok(data):
            return Ok(data)
        Err(problem):
            return Err(pem_error("PEM body is not valid base64"))

pub fn crypto_sha256_file(path: Text) -> Result[Bytes, StdError]:
    match native_fs_sha256(path):
        Ok(digest):
            return Ok(digest)
        Err(problem):
            return Err(StdError(file_error_code(problem), file_error_message(problem), path, 0, 0))

pub fn crypto_random_max_bytes() -> Int:
    return 1048576

pub fn crypto_random_bytes(count: Int) -> Result[Bytes, StdError]:
    return native_crypto_random_bytes(count)

pub fn crypto_random_hex(count: Int) -> Result[Text, StdError]:
    match native_crypto_random_bytes(count):
        Ok(bytes):
            return Ok(hex_encode(bytes))
        Err(problem):
            return Err(problem)

pub fn crypto_random_base64url(count: Int) -> Result[Text, StdError]:
    match native_crypto_random_bytes(count):
        Ok(bytes):
            return Ok(base64url_encode(bytes))
        Err(problem):
            return Err(problem)

pub fn crypto_sha1(data: Bytes) -> Bytes:
    return native_sha1(data)

pub fn bytes_xor_key(data: Bytes, key: Bytes) -> Bytes:
    return native_bytes_xor(data, key)
