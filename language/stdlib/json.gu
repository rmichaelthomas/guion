pub fn json_get_safe(value: Json, key: Text) -> Result[Json, JsonError]:
    return json_try_get(value, key)

pub fn json_get_text_safe(value: Json, key: Text) -> Result[Text, JsonError]:
    return json_try_get_text(value, key)

pub fn json_get_int_safe(value: Json, key: Text) -> Result[Int, JsonError]:
    return json_try_get_int(value, key)

pub fn json_index_safe(value: Json, index: Int) -> Result[Json, JsonError]:
    return json_try_index(value, index)

pub fn json_text_safe(value: Json) -> Result[Text, JsonError]:
    return json_try_text(value)

pub fn json_stringify_pairs(values: Map[Text, List[Text]], key_field: Text, value_field: Text) -> Text:
    return json_stringify_pairs_native(values, key_field, value_field)

pub fn json_int_safe(value: Json) -> Result[Int, JsonError]:
    return json_try_int(value)

pub fn json_bool_safe(value: Json) -> Result[Bool, JsonError]:
    return json_try_bool(value)

pub fn json_float_safe(value: Json) -> Result[Float64, JsonError]:
    return json_try_float(value)

# The Result-returning counterpart of json_as_int_list: Err with E_JSON_SHAPE when the value is not
# an array and E_JSON_TYPE when an element is not an integer; it never stops the program.
pub fn json_int_list_safe(value: Json) -> Result[List[Int], JsonError]:
    var items: List[Int] = []
    var index = 0
    while true:
        match json_try_index(value, index):
            Ok(element):
                match json_try_int(element):
                    Ok(number):
                        set items = list_push(items, number)
                    Err(problem):
                        return Err(problem)
            Err(problem):
                if json_error_code(problem) == "E_JSON_INDEX":
                    return Ok(items)
                return Err(problem)
        set index += 1
    return Ok(items)

# The keys of a JSON object, in the order json_stringify writes them (ascending by the bytes of the
# key). Err with code R_JSON_TYPE when the value is not an object. Looks at the top level only.
pub fn json_keys(value: Json) -> Result[List[Text], JsonError]:
    return json_keys_native(value)

# The value as indented text: each array element and object member on its own line, indented by
# `indent` spaces per level (0 to 16, otherwise R_JSON_INDENT; 0 puts the lines at the left edge).
# A colon is followed by one space, an empty object or array is `{}` or `[]`, and there is no
# newline at the end. Strings and numbers are written as json_stringify writes them, and
# non-ASCII text is kept as it is.
pub fn json_stringify_pretty(value: Json, indent: Int) -> Text:
    return json_stringify_pretty_native(value, indent)
