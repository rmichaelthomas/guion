import "std:types"
import "std:text"
import "std:time"
import "std:url"
import "std:http_response"

# std:cookie: the Cookie request header and the Set-Cookie response header as values.
#
# cookie_parse reads a Cookie header into a map and never fails: a pair that is malformed (no `=`, a
# name that is not an HTTP token, a bad percent escape) is dropped, and the first value of a repeated
# name wins. A cookie is built with cookie_new and the setters, serialized with cookie_serialize, and
# attached to a response with response_add_cookie (a second cookie is a second Set-Cookie header).
# cookie_parse_set reads a Set-Cookie line back into a Cookie, so a serialized cookie round-trips.
#
# Names must be HTTP tokens. Values are percent-encoded on the way out and decoded on the way in, so a
# `;`, `,`, `"`, space or line break in a value is data and never reaches the header as syntax.
# Defaults: HttpOnly on, SameSite=Lax, Secure off (local HTTP development works), no Path, Domain,
# Max-Age or Expires. SameSite=None needs Secure: cookie_same_site(c, "None") on a cookie that is not
# Secure, and cookie_serialize of such a cookie, fail with E_COOKIE_SAMESITE_NONE_NEEDS_SECURE, so set
# Secure first. A record literal skips the constructors, so cookie_serialize checks every field again.
# Failures are HttpFailure values (status 500, code E_COOKIE_*).

pub record Cookie:
    name: Text
    value: Text
    http_only: Bool
    secure: Bool
    same_site: Text
    path: Text
    domain: Text
    max_age: Option[Int]
    expires: Option[Instant]

fn ck_no_int() -> Option[Int]:
    return None

fn ck_no_instant() -> Option[Instant]:
    return None

fn ck_some_int(value: Int) -> Option[Int]:
    return Some(value)

fn ck_some_instant(value: Instant) -> Option[Instant]:
    return Some(value)

fn ck_fail(code: Text, message: Text) -> HttpFailure:
    return HttpFailure(500, code, message)

fn ck_token_ok(name: Text) -> Bool:
    if len(name) == 0:
        return false
    let allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'*+-.^_`|~"
    let chars = text_chars(name)
    var index = 0
    while index < len(chars):
        if text_find(allowed, chars[index], 0) < 0:
            return false
        set index = index + 1
    return true

# Printable ASCII only, without `;` (attribute values are not encoded).
fn ck_attr_ok(value: Text) -> Bool:
    let codes = bytes_to_ints(bytes_from_text(value))
    var index = 0
    while index < len(codes):
        if codes[index] < 33 or codes[index] > 126 or codes[index] == 59:
            return false
        set index = index + 1
    return true

fn ck_domain_ok(value: Text) -> Bool:
    if len(value) == 0:
        return false
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-."
    let chars = text_chars(value)
    var index = 0
    while index < len(chars):
        if text_find(allowed, chars[index], 0) < 0:
            return false
        set index = index + 1
    return true

fn ck_same_site_ok(value: Text) -> Bool:
    return value == "Lax" or value == "Strict" or value == "None"

# The first thing wrong with a cookie, or None. Used by every setter and again by cookie_serialize.
fn ck_problem(c: Cookie) -> Option[HttpFailure]:
    if not ck_token_ok(c.name):
        return Some(ck_fail("E_COOKIE_NAME_INVALID", "a cookie name is an HTTP token: no space, `=`, `;`, `,` or control character"))
    if not ck_same_site_ok(c.same_site):
        return Some(ck_fail("E_COOKIE_SAMESITE_INVALID", "SameSite is Lax, Strict or None"))
    if c.same_site == "None" and not c.secure:
        return Some(ck_fail("E_COOKIE_SAMESITE_NONE_NEEDS_SECURE", "COOKIE_SAMESITE_NONE_NEEDS_SECURE: SameSite=None is only sent over HTTPS, so the cookie must also be Secure"))
    if len(c.path) > 0:
        if text_slice(c.path, 0, 1) != "/" or not ck_attr_ok(c.path):
            return Some(ck_fail("E_COOKIE_ATTRIBUTE_INVALID", "Path starts with `/` and holds no `;`, space or control character"))
    if len(c.domain) > 0:
        if not ck_domain_ok(c.domain):
            return Some(ck_fail("E_COOKIE_ATTRIBUTE_INVALID", "Domain is letters, digits, `-` and `.` only"))
    if is_some(c.max_age):
        if unwrap(c.max_age) < 0:
            return Some(ck_fail("E_COOKIE_MAX_AGE_INVALID", "Max-Age is zero or more (zero deletes the cookie)"))
    if is_some(c.expires):
        let seconds = unwrap(c.expires).unix_microseconds // 1000000
        if seconds < -30610224000 or seconds > 253402300799:
            return Some(ck_fail("E_COOKIE_EXPIRES_INVALID", "Expires is a year from 1000 to 9999"))
    return None

pub fn cookie_new(name: Text, value: Text) -> Result[Cookie, HttpFailure]:
    let c = Cookie(name, value, true, false, "Lax", "", "", ck_no_int(), ck_no_instant())
    match ck_problem(c):
        Some(problem):
            return Err(problem)
        None:
            return Ok(c)

pub fn cookie_http_only(c: Cookie, enabled: Bool) -> Cookie:
    return Cookie(c.name, c.value, enabled, c.secure, c.same_site, c.path, c.domain, c.max_age, c.expires)

pub fn cookie_secure(c: Cookie, enabled: Bool) -> Cookie:
    return Cookie(c.name, c.value, c.http_only, enabled, c.same_site, c.path, c.domain, c.max_age, c.expires)

pub fn cookie_same_site(c: Cookie, mode: Text) -> Result[Cookie, HttpFailure]:
    let next = Cookie(c.name, c.value, c.http_only, c.secure, mode, c.path, c.domain, c.max_age, c.expires)
    match ck_problem(next):
        Some(problem):
            return Err(problem)
        None:
            return Ok(next)

pub fn cookie_path(c: Cookie, path: Text) -> Result[Cookie, HttpFailure]:
    let next = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, path, c.domain, c.max_age, c.expires)
    match ck_problem(next):
        Some(problem):
            return Err(problem)
        None:
            return Ok(next)

pub fn cookie_domain(c: Cookie, domain: Text) -> Result[Cookie, HttpFailure]:
    let next = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, c.path, domain, c.max_age, c.expires)
    match ck_problem(next):
        Some(problem):
            return Err(problem)
        None:
            return Ok(next)

pub fn cookie_max_age(c: Cookie, seconds: Int) -> Result[Cookie, HttpFailure]:
    let next = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, c.path, c.domain, ck_some_int(seconds), c.expires)
    match ck_problem(next):
        Some(problem):
            return Err(problem)
        None:
            return Ok(next)

pub fn cookie_expires(c: Cookie, instant: Instant) -> Result[Cookie, HttpFailure]:
    let next = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, c.path, c.domain, c.max_age, ck_some_instant(instant))
    match ck_problem(next):
        Some(problem):
            return Err(problem)
        None:
            return Ok(next)

fn ck_days_from_civil(year: Int, month: Int, day: Int) -> Int:
    var y = year
    if month <= 2:
        set y = y - 1
    let era = y // 400
    let yoe = y - era * 400
    var shifted = month - 3
    if month <= 2:
        set shifted = month + 9
    let doy = (153 * shifted + 2) // 5 + day - 1
    let doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468

fn ck_two(value: Int) -> Text:
    if value < 10:
        return "0" + int_to_text(value)
    return int_to_text(value)

fn ck_months() -> List[Text]:
    return ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

# IMF-fixdate, for example `Wed, 21 Oct 2015 07:28:00 GMT`.
fn ck_http_date(instant: Instant) -> Text:
    let total = instant.unix_microseconds // 1000000
    let days = total // 86400
    let rest = total - days * 86400
    let shifted = days + 719468
    let era = shifted // 146097
    let doe = shifted - era * 146097
    let yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    let doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    let mp = (5 * doy + 2) // 153
    let day = doy - (153 * mp + 2) // 5 + 1
    var month = mp + 3
    if mp >= 10:
        set month = mp - 9
    var year = yoe + era * 400
    if month <= 2:
        set year = year + 1
    let names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    let weekday = names[(days + 4) % 7]
    return weekday + ", " + ck_two(day) + " " + ck_months()[month - 1] + " " + int_to_text(year) + " " + ck_two(rest // 3600) + ":" + ck_two((rest % 3600) // 60) + ":" + ck_two(rest % 60) + " GMT"

pub fn cookie_serialize(c: Cookie) -> Result[Text, HttpFailure]:
    match ck_problem(c):
        Some(problem):
            return Err(problem)
        None:
            var out = c.name + "=" + url_encode_component(c.value)
            if len(c.path) > 0:
                set out = out + "; Path=" + c.path
            if len(c.domain) > 0:
                set out = out + "; Domain=" + c.domain
            if is_some(c.max_age):
                set out = out + "; Max-Age=" + int_to_text(unwrap(c.max_age))
            if is_some(c.expires):
                set out = out + "; Expires=" + ck_http_date(unwrap(c.expires))
            if c.http_only:
                set out = out + "; HttpOnly"
            if c.secure:
                set out = out + "; Secure"
            set out = out + "; SameSite=" + c.same_site
            return Ok(out)

# Adds one Set-Cookie header; the line goes through the same header check as any header value.
pub fn response_add_cookie(response: Response, c: Cookie) -> Result[Response, HttpFailure]:
    let line = cookie_serialize(c)?
    return response_add_header(response, "Set-Cookie", line)

# A `name=value` pair: the value without optional surrounding double quotes, percent-decoded.
# None when the pair is malformed.
fn ck_pair(pair: Text) -> Option[Header]:
    let at = text_find(pair, "=", 0)
    if at <= 0:
        return None
    let name = text_trim(text_slice(pair, 0, at))
    var raw = text_trim(text_slice(pair, at + 1, len(pair)))
    if not ck_token_ok(name):
        return None
    if len(raw) >= 2 and text_slice(raw, 0, 1) == "\"" and text_slice(raw, len(raw) - 1, len(raw)) == "\"":
        set raw = text_slice(raw, 1, len(raw) - 1)
    match url_decode_component(raw):
        Ok(value):
            return Some(Header(name, value))
        Err(problem):
            return None

pub fn cookie_parse(header: Text) -> Map[Text, Text]:
    var out: Map[Text, Text] = {}
    let pairs = text_split(header, ";")
    var index = 0
    while index < len(pairs):
        let parsed = ck_pair(pairs[index])
        if is_some(parsed):
            let found = unwrap(parsed)
            if not map_has(out, found.name):
                set out = map_set(out, found.name, found.value)
        set index = index + 1
    return out

fn ck_month_number(name: Text) -> Int:
    let months = ck_months()
    var index = 0
    while index < 12:
        if text_casefold(months[index]) == text_casefold(name):
            return index + 1
        set index = index + 1
    return 0

fn ck_int(text: Text) -> Option[Int]:
    if len(text) == 0:
        return None
    let chars = text_chars(text)
    var index = 0
    while index < len(chars):
        if text_find("0123456789", chars[index], 0) < 0:
            return None
        set index = index + 1
    let parsed = text_parse_int(text)
    if not is_ok(parsed):
        return None
    return Some(unwrap(parsed))

# `Wed, 21 Oct 2015 07:28:00 GMT` to an Instant; None when it does not fit that form.
fn ck_parse_date(text: Text) -> Option[Instant]:
    let words = text_split(text_collapse_whitespace(text_trim(text)), " ")
    if len(words) != 6 or words[5] != "GMT":
        return None
    let clock = text_split(words[4], ":")
    if len(clock) != 3:
        return None
    let day = ck_int(words[1])
    let year = ck_int(words[3])
    let hour = ck_int(clock[0])
    let minute = ck_int(clock[1])
    let second = ck_int(clock[2])
    let month = ck_month_number(words[2])
    if not is_some(day) or not is_some(year) or not is_some(hour) or not is_some(minute) or not is_some(second) or month == 0:
        return None
    if unwrap(day) < 1 or unwrap(day) > 31 or unwrap(hour) > 23 or unwrap(minute) > 59 or unwrap(second) > 60:
        return None
    let days = ck_days_from_civil(unwrap(year), month, unwrap(day))
    let seconds = days * 86400 + unwrap(hour) * 3600 + unwrap(minute) * 60 + unwrap(second)
    return Some(Instant(seconds * 1000000))

# Reads one Set-Cookie header value back into a Cookie (the inverse of cookie_serialize). Attribute
# names are matched without case and unknown attributes are ignored. A malformed name=value part, or
# a field the setters would refuse, is an error.
pub fn cookie_parse_set(line: Text) -> Result[Cookie, HttpFailure]:
    let parts = text_split(line, ";")
    let first = ck_pair(parts[0])
    if not is_some(first):
        return Err(ck_fail("E_COOKIE_NAME_INVALID", "a Set-Cookie line starts with name=value"))
    let head = unwrap(first)
    var c = Cookie(head.name, head.value, false, false, "Lax", "", "", ck_no_int(), ck_no_instant())
    var index = 1
    while index < len(parts):
        let part = text_trim(parts[index])
        let at = text_find(part, "=", 0)
        var key = text_casefold(part)
        var arg = ""
        if at >= 0:
            set key = text_casefold(text_trim(text_slice(part, 0, at)))
            set arg = text_trim(text_slice(part, at + 1, len(part)))
        if key == "httponly":
            set c = cookie_http_only(c, true)
        if key == "secure":
            set c = cookie_secure(c, true)
        if key == "path":
            set c = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, arg, c.domain, c.max_age, c.expires)
        if key == "domain":
            set c = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, c.path, arg, c.max_age, c.expires)
        if key == "samesite":
            var mode = arg
            if text_casefold(arg) == "lax":
                set mode = "Lax"
            if text_casefold(arg) == "strict":
                set mode = "Strict"
            if text_casefold(arg) == "none":
                set mode = "None"
            set c = Cookie(c.name, c.value, c.http_only, c.secure, mode, c.path, c.domain, c.max_age, c.expires)
        if key == "max-age":
            let seconds = text_parse_int(arg)
            if not is_ok(seconds):
                return Err(ck_fail("E_COOKIE_MAX_AGE_INVALID", "Max-Age is a whole number of seconds"))
            set c = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, c.path, c.domain, ck_some_int(unwrap(seconds)), c.expires)
        if key == "expires":
            let when = ck_parse_date(arg)
            if not is_some(when):
                return Err(ck_fail("E_COOKIE_EXPIRES_INVALID", "Expires is an IMF-fixdate such as Wed, 21 Oct 2015 07:28:00 GMT"))
            set c = Cookie(c.name, c.value, c.http_only, c.secure, c.same_site, c.path, c.domain, c.max_age, when)
        set index = index + 1
    match ck_problem(c):
        Some(problem):
            return Err(problem)
        None:
            return Ok(c)
