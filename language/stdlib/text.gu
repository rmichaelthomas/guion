import "std:unicode"
import "std:types"
pub import "std:http_types"

pub fn text_compare_scalar(left: Text, right: Text) -> Int:
    if left < right:
        return -1
    if left > right:
        return 1
    return 0

pub fn text_compare_bytes(left: Text, right: Text) -> Int:
    if left < right:
        return -1
    if left > right:
        return 1
    return 0

pub fn text_trim(value: Text) -> Text:
    return text_trim_native(value)

pub fn text_split(value: Text, delimiter: Text) -> List[Text]:
    return text_split_native(value, delimiter)

pub fn text_join(values: List[Text], delimiter: Text) -> Text:
    return text_join_native(values, delimiter)

pub fn text_replace(value: Text, needle: Text, replacement: Text) -> Text:
    return text_replace_native(value, needle, replacement)

pub fn text_parse_integer(value: Text) -> Result[Int, FileError]:
    return text_parse_int(value)

pub fn text_parse_decimal(value: Text) -> Result[Float64, FileError]:
    return text_parse_float(value)

pub fn text_casefold(value: Text) -> Text:
    return unicode_casefold(value)

pub fn text_collapse_whitespace(value: Text) -> Text:
    return unicode_collapse_whitespace(value)

pub fn text_normalize(value: Text, form: Text) -> Result[Text, StdError]:
    return unicode_normalize(value, form)

# Lowercases with the Unicode default case mapping, for display: a capital sigma ending a word
# becomes the final form, and a dotted capital I becomes `i` and a combining dot. To compare text
# without regard to case, use text_casefold instead.
pub fn text_lower(value: Text) -> Text:
    return text_lower_native(value)

# Uppercases with the Unicode default case mapping, for display: Straße becomes STRASSE. To compare
# text without regard to case, use text_casefold instead.
pub fn text_upper(value: Text) -> Text:
    return text_upper_native(value)

# The digits of `value` in `radix` (2 to 36): lowercase letters for digits above 9, a leading `-`
# for a negative value, no prefix and no separators, so `int_to_text_radix(255, 16)` is `"ff"` and
# `int_to_text_radix(493, 8)` is `"755"`. Any radix outside 2 to 36 is R_RADIX_RANGE.
pub fn int_to_text_radix(value: Int, radix: Int) -> Text:
    return int_to_text_radix_native(value, radix)

# Reads an integer written in `radix` (2 to 36): digits in either case with one optional leading
# `-`, no `+`, no prefix such as `0x` and no `_`. Anything else is Err with code E_INT_PARSE, as
# text_parse_int gives; a value over the digit limit is R_INTEGER_LIMIT and a radix outside 2 to
# 36 is R_RADIX_RANGE. The value can be as large as an Int can be.
pub fn text_parse_int_radix(text: Text, radix: Int) -> Result[Int, FileError]:
    return text_parse_int_radix_native(text, radix)

# Whether `value` begins with `prefix`, comparing Unicode scalar values as `len` and `text_slice`
# count them. An empty prefix is always a match; a prefix longer than `value` is false, never an
# error.
pub fn text_starts_with(value: Text, prefix: Text) -> Bool:
    let size = len(prefix)
    if size > len(value):
        return false
    return text_slice(value, 0, size) == prefix

# Whether `value` ends with `suffix`, comparing Unicode scalar values as `len` and `text_slice`
# count them. An empty suffix is always a match; a suffix longer than `value` is false, never an
# error.
pub fn text_ends_with(value: Text, suffix: Text) -> Bool:
    let size = len(suffix)
    let total = len(value)
    if size > total:
        return false
    return text_slice(value, total - size, total) == suffix
