import "std:unicode"
import "std:types"

pub fn text_compare_scalar(left: Text, right: Text) -> Int:
    if left < right:
        return -1
    if left > right:
        return 1
    return 0

pub fn text_compare_bytes(left: Text, right: Text) -> Int:
    if left < right:
        return -1
    if left > right:
        return 1
    return 0

pub fn text_trim(value: Text) -> Text:
    return text_trim_native(value)

pub fn text_split(value: Text, delimiter: Text) -> List[Text]:
    return text_split_native(value, delimiter)

pub fn text_join(values: List[Text], delimiter: Text) -> Text:
    return text_join_native(values, delimiter)

pub fn text_replace(value: Text, needle: Text, replacement: Text) -> Text:
    return text_replace_native(value, needle, replacement)

pub fn text_parse_integer(value: Text) -> Result[Int, FileError]:
    return text_parse_int(value)

pub fn text_parse_decimal(value: Text) -> Result[Float64, FileError]:
    return text_parse_float(value)

pub fn text_casefold(value: Text) -> Text:
    return unicode_casefold(value)

pub fn text_collapse_whitespace(value: Text) -> Text:
    return unicode_collapse_whitespace(value)

pub fn text_normalize(value: Text, form: Text) -> Result[Text, StdError]:
    return unicode_normalize(value, form)
