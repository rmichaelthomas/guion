import "std:types"
import "std:text"
import "std:path"
import "std:fs"
import "std:encoding"
import "std:crypto"
import "std:url"
import "std:http_response"
pub import "std:http_types"

# std:http_body: request bodies as values, with every limit explicit.
#
# form_parse reads an application/x-www-form-urlencoded body into a map of name to values (repeated
# names keep every value, in order). multipart_parse reads a multipart/form-data request: a part with
# a `filename` is a file and is written under `files_root`; a part without one is a text field.
#
# BodyLimits has five limits and body_limits_default() gives the defaults:
#   max_headers      header lines in one part                                  default 16
#   max_header_bytes bytes in one part's header block                          default 8192
#   max_parts        parts in a multipart body, or pairs in a form             default 1000
#   max_part_bytes   bytes in one part's data, or in one form name or value    default 8388608
#   max_total_bytes  bytes in the whole body                                   default 16777216
# A value over a limit is refused with status 413, code E_BODY_LIMIT and a message that names the
# limit; a value exactly at the limit is accepted. A negative limit is a 500 (E_BODY_LIMITS_INVALID).
# Fixed limits: a boundary is 1 to 70 characters (RFC 2046) and a sanitized filename is at most 255
# bytes (400 E_BODY_MALFORMED above that).
#
# A request body reaches a Request as bytes already read, so the total limit has to be applied while
# reading: pass body_read_limit(limits) as max_body_bytes to http_server_read_request, which refuses a
# declared Content-Length over it before reading any body byte, and turn that StdError into the 413
# with body_read_failure. multipart_parse checks max_total_bytes again before it parses anything.
#
# Nothing is written until the whole body has parsed, so a refused request leaves no file behind. A
# file is written as `files_root/<32 random hex digits>`: the client's name never reaches a path. It
# is kept as original_name after sanitizing: backslashes count as separators, only the final
# component stays, control characters (NUL included) are dropped, and a name that is empty or only
# dots becomes `unnamed`. A `filename*=` parameter (RFC 8187, UTF-8, quoted or not) wins over
# `filename=`. Writing is confined by the file grant like any std:fs write (effect filesystem.write).
#
# Strictness: the body starts with the first boundary line (no preamble); a part header may not be
# folded (a continuation line is a 400) and holds no control character; a quoted
# parameter ends at the next double quote (a backslash is an ordinary character); a part needs a
# `name`; a field value must be UTF-8; a part with `filename=""` and no data is skipped. A boundary
# string inside part data that is not followed by `--` or a line break is data, not a delimiter.
# Failures are HttpFailure values: 400 E_BODY_MALFORMED (or E_BODY_NOT_MULTIPART), 413 E_BODY_LIMIT,
# 500 for the host (E_BODY_STORE_FAILED, E_BODY_LIMITS_INVALID).

pub record BodyLimits:
    max_headers: Int
    max_header_bytes: Int
    max_parts: Int
    max_part_bytes: Int
    max_total_bytes: Int

pub record UploadedFile:
    field: Text
    original_name: Text
    stored_path: Text
    bytes: Int
    content_type: Text

pub record Multipart:
    fields: Map[Text, List[Text]]
    files: List[UploadedFile]

# A file part found while parsing: where its data sits in the body, before anything is written.
record HbFilePart:
    field: Text
    original_name: Text
    content_type: Text
    start: Int
    stop: Int

record HbParsed:
    fields: Map[Text, List[Text]]
    files: List[HbFilePart]

# One part's header block, read.
record HbHead:
    name: Text
    filename: Text
    has_filename: Bool
    content_type: Text

pub fn body_limits_default() -> BodyLimits:
    return BodyLimits(16, 8192, 1000, 8388608, 16777216)

# The max_body_bytes to give http_server_read_request so an oversized body is refused unread.
pub fn body_read_limit(limits: BodyLimits) -> Int:
    return limits.max_total_bytes

fn hb_fail(status: Int, code: Text, message: Text) -> HttpFailure:
    return HttpFailure(status, code, message)

fn hb_too_large(limits: BodyLimits) -> HttpFailure:
    return hb_fail(413, "E_BODY_LIMIT", "max_total_bytes (" + int_to_text(limits.max_total_bytes) + ") exceeded: the request body is larger")

# Turns the StdError that http_server_read_request returns into the failure to send.
pub fn body_read_failure(problem: StdError, limits: BodyLimits) -> HttpFailure:
    if problem.code == "E_HTTP_BODY_TOO_LARGE":
        return hb_too_large(limits)
    return hb_fail(400, problem.code, problem.message)

fn hb_limits_problem(limits: BodyLimits) -> Option[HttpFailure]:
    if limits.max_headers < 0 or limits.max_header_bytes < 0 or limits.max_parts < 0 or limits.max_part_bytes < 0 or limits.max_total_bytes < 0:
        return Some(hb_fail(500, "E_BODY_LIMITS_INVALID", "every BodyLimits field is zero or more"))
    return None

fn hb_token_ok(name: Text) -> Bool:
    if len(name) == 0:
        return false
    let allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'*+-.^_`|~"
    let chars = text_chars(name)
    var index = 0
    while index < len(chars):
        if text_find(allowed, chars[index], 0) < 0:
            return false
        set index = index + 1
    return true

# ---- urlencoded -------------------------------------------------------------------------------

fn hb_form_decode(raw: Text, what: Text, limits: BodyLimits) -> Result[Text, HttpFailure]:
    if len(bytes_from_text(raw)) > limits.max_part_bytes:
        return Err(hb_fail(413, "E_BODY_LIMIT", "max_part_bytes (" + int_to_text(limits.max_part_bytes) + ") exceeded: a form " + what + " is larger"))
    match url_decode_component(text_replace(raw, "+", " ")):
        Ok(value):
            return Ok(value)
        Err(problem):
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a form " + what + " has an invalid percent escape or is not UTF-8"))

# `a=1&b=2&a=3` to {"a": ["1", "3"], "b": ["2"]}. A pair without `=` has an empty value and an empty
# pair is skipped. Over max_total_bytes is refused before any parsing.
pub fn form_parse(body: Bytes, limits: BodyLimits) -> Result[Map[Text, List[Text]], HttpFailure]:
    let bad = hb_limits_problem(limits)
    if is_some(bad):
        return Err(unwrap(bad))
    if len(body) > limits.max_total_bytes:
        return Err(hb_too_large(limits))
    var fields: Map[Text, List[Text]] = {}
    let text_option = text_from_bytes(body)
    if not is_some(text_option):
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a urlencoded body is UTF-8 text"))
    let text = unwrap(text_option)
    var count = 0
    var start = 0
    while start <= len(text):
        var stop = text_find(text, "&", start)
        if stop < 0:
            set stop = len(text)
        let item = text_slice(text, start, stop)
        if len(item) > 0:
            set count = count + 1
            if count > limits.max_parts:
                return Err(hb_fail(413, "E_BODY_LIMIT", "max_parts (" + int_to_text(limits.max_parts) + ") exceeded: the form has more pairs"))
            var raw_name = item
            var raw_value = ""
            let equals = text_find(item, "=", 0)
            if equals >= 0:
                set raw_name = text_slice(item, 0, equals)
                set raw_value = text_slice(item, equals + 1, len(item))
            let name = hb_form_decode(raw_name, "name", limits)?
            let value = hb_form_decode(raw_value, "value", limits)?
            var values: List[Text] = []
            match map_get(fields, name):
                Some(existing):
                    set values = existing
                None:
                    set values = values
            set fields = map_set(fields, name, list_push(values, value))
        set start = stop + 1
    return Ok(fields)

# ---- parameters and filenames -----------------------------------------------------------------

# Splits `type; a=b; c="d;e"` at the semicolons outside double quotes.
fn hb_segments(text: Text) -> Result[List[Text], HttpFailure]:
    var out: List[Text] = []
    let chars = text_chars(text)
    var current = ""
    var quoted = false
    var index = 0
    while index < len(chars):
        let c = chars[index]
        if c == "\"":
            set quoted = not quoted
        if c == ";" and not quoted:
            set out = list_push(out, current)
            set current = ""
        else:
            set current = current + c
        set index = index + 1
    if quoted:
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a quoted parameter is not closed"))
    return Ok(list_push(out, current))

fn hb_unquote(value: Text) -> Result[Text, HttpFailure]:
    if len(value) >= 1 and text_slice(value, 0, 1) == "\"":
        if len(value) < 2 or text_slice(value, len(value) - 1, len(value)) != "\"":
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a quoted parameter is not closed"))
        return Ok(text_slice(value, 1, len(value) - 1))
    return Ok(value)

# The `name=value` parameters after the first segment, names lower-cased, values unquoted.
fn hb_params(text: Text) -> Result[List[Header], HttpFailure]:
    let segments = hb_segments(text)?
    var out: List[Header] = []
    var index = 1
    while index < len(segments):
        let segment = text_trim(segments[index])
        let equals = text_find(segment, "=", 0)
        if equals > 0:
            let name = text_casefold(text_trim(text_slice(segment, 0, equals)))
            let value = hb_unquote(text_trim(text_slice(segment, equals + 1, len(segment))))?
            set out = list_push(out, Header(name, value))
        set index = index + 1
    return Ok(out)

fn hb_param(params: List[Header], name: Text) -> Option[Text]:
    var index = 0
    while index < len(params):
        if params[index].name == name:
            return Some(params[index].value)
        set index = index + 1
    return None

fn hb_boundary_char_ok(c: Text) -> Bool:
    return text_find("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'()+_,-./:=? ", c, 0) >= 0

fn hb_boundary_of(content_type: Text) -> Result[Text, HttpFailure]:
    let segments = hb_segments(content_type)?
    if text_casefold(text_trim(segments[0])) != "multipart/form-data":
        return Err(hb_fail(400, "E_BODY_NOT_MULTIPART", "the Content-Type is not multipart/form-data"))
    let params = hb_params(content_type)?
    let found = hb_param(params, "boundary")
    if not is_some(found):
        return Err(hb_fail(400, "E_BODY_MALFORMED", "the Content-Type has no boundary"))
    let boundary = unwrap(found)
    if len(boundary) < 1 or len(boundary) > 70:
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a boundary is 1 to 70 characters"))
    if text_slice(boundary, len(boundary) - 1, len(boundary)) == " ":
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a boundary does not end in a space"))
    let chars = text_chars(boundary)
    var index = 0
    while index < len(chars):
        if not hb_boundary_char_ok(chars[index]):
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a boundary uses letters, digits and ' ( ) + _ , - . / : = ? only"))
        set index = index + 1
    return Ok(boundary)

# The final path component of a client filename, safe to show and to store as metadata. Never a path.
fn hb_sanitize_name(raw: Text) -> Result[Text, HttpFailure]:
    let codes = bytes_to_ints(bytes_from_text(raw))
    var kept: List[Int] = []
    var index = 0
    while index < len(codes):
        let code = codes[index]
        if code == 92:
            set kept = list_push(kept, 47)
        else:
            if code >= 32 and code != 127:
                set kept = list_push(kept, code)
        set index = index + 1
    let cleaned = text_from_bytes(bytes_from_ints(kept))
    if not is_some(cleaned):
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a filename is UTF-8 text"))
    let pieces = text_split(unwrap(cleaned), "/")
    var name = text_trim(pieces[len(pieces) - 1])
    var dots = true
    let chars = text_chars(name)
    var at = 0
    while at < len(chars):
        if chars[at] != ".":
            set dots = false
        set at = at + 1
    if len(name) == 0 or dots:
        set name = "unnamed"
    if len(bytes_from_text(name)) > 255:
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a filename is at most 255 bytes"))
    return Ok(name)

# `UTF-8'en'%E2%82%AC.txt` (RFC 8187) to the decoded name.
fn hb_extended_name(value: Text) -> Result[Text, HttpFailure]:
    let first = text_find(value, "'", 0)
    if first < 0:
        return Err(hb_fail(400, "E_BODY_MALFORMED", "filename* is charset'language'value"))
    let second = text_find(value, "'", first + 1)
    if second < 0:
        return Err(hb_fail(400, "E_BODY_MALFORMED", "filename* is charset'language'value"))
    if text_casefold(text_slice(value, 0, first)) != "utf-8":
        return Err(hb_fail(400, "E_BODY_MALFORMED", "filename* must use the UTF-8 charset"))
    match url_decode_component(text_slice(value, second + 1, len(value))):
        Ok(decoded):
            return Ok(decoded)
        Err(problem):
            return Err(hb_fail(400, "E_BODY_MALFORMED", "filename* has an invalid percent escape or is not UTF-8"))

# ---- part headers -----------------------------------------------------------------------------

# Reads one part's header block (the bytes between the boundary line and the blank line).
fn hb_read_head(block: Bytes, limits: BodyLimits) -> Result[HbHead, HttpFailure]:
    let codes = bytes_to_ints(block)
    var index = 0
    while index < len(codes):
        let code = codes[index]
        if (code < 32 and code != 13 and code != 10 and code != 9) or code == 127:
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a part header holds a control character"))
        set index = index + 1
    let text_option = text_from_bytes(block)
    if not is_some(text_option):
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a part header is UTF-8 text"))
    let lines = text_split(unwrap(text_option), "\r\n")
    if len(lines) > limits.max_headers:
        return Err(hb_fail(413, "E_BODY_LIMIT", "max_headers (" + int_to_text(limits.max_headers) + ") exceeded: a part has " + int_to_text(len(lines)) + " header lines"))
    var disposition = ""
    var has_disposition = false
    var content_type = ""
    var line_no = 0
    while line_no < len(lines):
        let line = lines[line_no]
        if len(line) == 0:
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a part header has an empty line"))
        let first = text_slice(line, 0, 1)
        if first == " " or first == "\t":
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a folded part header (obs-fold) is refused"))
        if text_find(line, "\r", 0) >= 0 or text_find(line, "\n", 0) >= 0:
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a part header line ends with CRLF"))
        let colon = text_find(line, ":", 0)
        if colon <= 0 or not hb_token_ok(text_slice(line, 0, colon)):
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a part header is `name: value` with a token name"))
        let name = text_casefold(text_slice(line, 0, colon))
        let value = text_trim(text_slice(line, colon + 1, len(line)))
        if name == "content-disposition":
            if has_disposition:
                return Err(hb_fail(400, "E_BODY_MALFORMED", "a part has two Content-Disposition headers"))
            set has_disposition = true
            set disposition = value
        if name == "content-type":
            set content_type = value
        set line_no = line_no + 1
    if not has_disposition:
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a part has no Content-Disposition header"))
    let segments = hb_segments(disposition)?
    if text_casefold(text_trim(segments[0])) != "form-data":
        return Err(hb_fail(400, "E_BODY_MALFORMED", "Content-Disposition is form-data"))
    let params = hb_params(disposition)?
    let field = hb_param(params, "name")
    if not is_some(field):
        return Err(hb_fail(400, "E_BODY_MALFORMED", "a part has no name"))
    var filename = ""
    var has_filename = false
    let plain = hb_param(params, "filename")
    if is_some(plain):
        set has_filename = true
        set filename = unwrap(plain)
    let extended = hb_param(params, "filename*")
    if is_some(extended):
        set has_filename = true
        set filename = hb_extended_name(unwrap(extended))?
    return Ok(HbHead(unwrap(field), filename, has_filename, content_type))

# ---- multipart structure ----------------------------------------------------------------------

# The byte index of `needle_hex` in `hex` at or after byte `from`, or -1. A hit must sit on a byte
# boundary (an even hex index).
fn hb_find(hex: Text, needle_hex: Text, from: Int) -> Int:
    var at = from * 2
    while at <= len(hex):
        let found = text_find(hex, needle_hex, at)
        if found < 0:
            return -1
        if found % 2 == 0:
            return found // 2
        set at = found + 1
    return -1

fn hb_part_too_large(limits: BodyLimits) -> HttpFailure:
    return hb_fail(413, "E_BODY_LIMIT", "max_part_bytes (" + int_to_text(limits.max_part_bytes) + ") exceeded: a part is larger")

fn hb_unterminated() -> HttpFailure:
    return hb_fail(400, "E_BODY_MALFORMED", "the closing boundary is missing")

fn hb_parse_body(body: Bytes, boundary: Text, limits: BodyLimits) -> Result[HbParsed, HttpFailure]:
    let hex = hex_encode(body)
    let total = len(body)
    let opening = "--" + boundary
    let opening_len = len(opening)
    if total < opening_len or text_slice(hex, 0, opening_len * 2) != hex_encode(bytes_from_text(opening)):
        return Err(hb_fail(400, "E_BODY_MALFORMED", "the body does not start with the boundary line"))
    let delimiter_hex = hex_encode(bytes_from_text("\r\n" + opening))
    let blank_hex = hex_encode(bytes_from_text("\r\n\r\n"))
    let crlf_hex = hex_encode(bytes_from_text("\r\n"))
    let dashes_hex = hex_encode(bytes_from_text("--"))
    var fields: Map[Text, List[Text]] = {}
    var files: List[HbFilePart] = []
    var parts = 0
    var cursor = opening_len
    while true:
        # `cursor` is just after a boundary: `--` closes the body, CRLF opens a part.
        if cursor + 2 > total:
            return Err(hb_unterminated())
        let marker = text_slice(hex, cursor * 2, cursor * 2 + 4)
        if marker == dashes_hex:
            return Ok(HbParsed(fields, files))
        if marker != crlf_hex:
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a boundary line ends with CRLF or `--`"))
        set parts = parts + 1
        if parts > limits.max_parts:
            return Err(hb_fail(413, "E_BODY_LIMIT", "max_parts (" + int_to_text(limits.max_parts) + ") exceeded: the body has more parts"))
        let head_start = cursor + 2
        if head_start + 2 <= total and text_slice(hex, head_start * 2, head_start * 2 + 4) == crlf_hex:
            return Err(hb_fail(400, "E_BODY_MALFORMED", "a part has no headers"))
        let head_end = hb_find(hex, blank_hex, head_start)
        if head_end < 0:
            if total - head_start > limits.max_header_bytes:
                return Err(hb_fail(413, "E_BODY_LIMIT", "max_header_bytes (" + int_to_text(limits.max_header_bytes) + ") exceeded: a part header block is larger"))
            return Err(hb_unterminated())
        if head_end - head_start > limits.max_header_bytes:
            return Err(hb_fail(413, "E_BODY_LIMIT", "max_header_bytes (" + int_to_text(limits.max_header_bytes) + ") exceeded: a part header block is larger"))
        let head = hb_read_head(bytes_slice(body, head_start, head_end), limits)?
        let data_start = head_end + 4
        # The data ends at the next delimiter that is followed by `--` or CRLF.
        var data_end = -1
        var searching = true
        var from = data_start
        while searching:
            let found = hb_find(hex, delimiter_hex, from)
            if found < 0:
                set data_end = -2
                set searching = false
            else:
                let after = found + 2 + opening_len
                if after + 2 > total:
                    set data_end = -2
                    set searching = false
                else:
                    let next = text_slice(hex, after * 2, after * 2 + 4)
                    if next == dashes_hex or next == crlf_hex:
                        set data_end = found
                        set searching = false
                    else:
                        set from = found + 1
        if data_end == -2:
            return Err(hb_unterminated())
        if data_end - data_start > limits.max_part_bytes:
            return Err(hb_part_too_large(limits))
        if head.has_filename:
            if len(head.filename) == 0 and data_end == data_start:
                set cursor = data_end + 2 + opening_len
            else:
                let original = hb_sanitize_name(head.filename)?
                var kind = head.content_type
                if len(kind) == 0:
                    set kind = "application/octet-stream"
                set files = list_push(files, HbFilePart(head.name, original, kind, data_start, data_end))
                set cursor = data_end + 2 + opening_len
        else:
            let text_option = text_from_bytes(bytes_slice(body, data_start, data_end))
            if not is_some(text_option):
                return Err(hb_fail(400, "E_BODY_MALFORMED", "the field " + head.name + " is not UTF-8 text"))
            var values: List[Text] = []
            match map_get(fields, head.name):
                Some(existing):
                    set values = existing
                None:
                    set values = values
            set fields = map_set(fields, head.name, list_push(values, unwrap(text_option)))
            set cursor = data_end + 2 + opening_len
    return Err(hb_unterminated())

# ---- writing ----------------------------------------------------------------------------------

fn hb_remove_all(paths: List[Text]) -> Unit:
    var index = 0
    while index < len(paths):
        let removed = fs_remove(paths[index])
        set index = index + 1

fn hb_store(body: Bytes, parsed: HbParsed, files_root: Text) -> Result[List[UploadedFile], HttpFailure]:
    var stored: List[UploadedFile] = []
    var written: List[Text] = []
    if len(parsed.files) > 0:
        let made = fs_make_dir(files_root)
    var index = 0
    while index < len(parsed.files):
        let part = parsed.files[index]
        match crypto_random_hex(16):
            Ok(token):
                let path = path_join(files_root, token)
                match write_bytes(path, bytes_slice(body, part.start, part.stop)):
                    Ok(done):
                        set written = list_push(written, path)
                        set stored = list_push(stored, UploadedFile(part.field, part.original_name, path, part.stop - part.start, part.content_type))
                    Err(problem):
                        hb_remove_all(written)
                        return Err(hb_fail(500, "E_BODY_STORE_FAILED", "an uploaded file could not be written: " + file_error_code(problem)))
            Err(problem):
                hb_remove_all(written)
                return Err(hb_fail(500, "E_BODY_STORE_FAILED", "no random name was available: " + problem.code))
        set index = index + 1
    return Ok(stored)

# Parses a multipart/form-data request. Text fields come back in `fields`; each file part is written
# to `files_root` under a random name and described in `files`. The Content-Type header must be
# multipart/form-data with a boundary.
pub fn multipart_parse(request: Request, files_root: Text, limits: BodyLimits) -> Result[Multipart, HttpFailure]:
    let bad = hb_limits_problem(limits)
    if is_some(bad):
        return Err(unwrap(bad))
    if len(request.body) > limits.max_total_bytes:
        return Err(hb_too_large(limits))
    let content_type = request_header(request, "content-type")
    if not is_some(content_type):
        return Err(hb_fail(400, "E_BODY_NOT_MULTIPART", "the request has no Content-Type"))
    let boundary = hb_boundary_of(unwrap(content_type))?
    let parsed = hb_parse_body(request.body, boundary, limits)?
    let stored = hb_store(request.body, parsed, files_root)?
    return Ok(Multipart(parsed.fields, stored))
