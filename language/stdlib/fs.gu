import "std:types"

pub record SourceLine:
    number: Int
    text: Text

pub record DirectoryEntry:
    relative_path: Text
    kind: Text

pub fn fs_read_text(path: Text) -> Result[Text, StdError]:
    match read_text(path):
        Ok(text):
            return Ok(text)
        Err(problem):
            return Err(StdError(file_error_code(problem), file_error_message(problem), path, 0, 0))

pub fn fs_open_lines(path: Text) -> Result[FileReader, FileError]:
    return file_open_lines(path)

pub fn fs_next_line(reader: FileReader) -> Result[Option[SourceLine], FileError]:
    return file_next_line(reader)

pub fn fs_close_reader(reader: FileReader) -> Result[Unit, FileError]:
    return file_close(reader)
