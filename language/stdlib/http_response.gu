import "std:types"
import "std:text"

# std:http_response: request and response values for HTTP servers. Everything here is a plain value,
# so a handler `fn(Request) -> Result[Response, HttpFailure]` runs in a test without a socket, and a
# response built in one function can be returned through others and compared with `==`.
# `std:http_server` converts a connection-bound request into a Request (http_request_value) and sends
# a Response (http_server_send_response).
#
# A header is refused at construction when its name is not an HTTP token or its value holds a
# control character (CR, LF and NUL included), which closes response splitting. Because a record
# literal skips construction, response_serialize checks every header again.
#
# A Body is one of three explicit shapes: bytes, text or a stream. A stream is sent with chunked
# transfer encoding. stream_from_list sends the chunks it holds; stream_from_file names a file that
# is read in blocks when the response is sent by std:http_server (response_wire and
# response_serialize read it whole, for tests). std:http_static builds two more stream shapes with
# Content-Length framing instead of chunking: a file range (kind "file_range", the path, and the
# start and length as decimal text in `chunks`) and a head-only body (kind "sized", the length in
# `chunks`, for HEAD; kind "headers_only", no length, for 304 and 416). A function value cannot live
# in a value that is compared with `==`, so a stream names its source (a path or a list of chunks)
# instead of holding a producer function.

pub record Header:
    name: Text
    value: Text

# HttpError is the built-in client error type and cannot be built in Guion, so a server-side failure
# is its own record: the status to send, a stable code and a message.
pub record HttpFailure:
    status: Int
    code: Text
    message: Text

pub record Stream:
    kind: Text
    path: Text
    chunks: List[Bytes]

pub record Body:
    kind: Text
    data: Bytes
    stream: Stream

pub record Response:
    status: Int
    headers: List[Header]
    body: Body

# `params` is empty until a router fills it.
pub record Request:
    method: Text
    path: Text
    query: Map[Text, List[Text]]
    headers: List[Header]
    body: Bytes
    params: Map[Text, Text]

# Where a file-backed body comes from and how it is framed, so a server can send it in blocks.
pub record FilePlan:
    path: Text
    start: Int
    length: Int
    chunked: Bool

fn hr_reason(status: Int) -> Text:
    if status == 100:
        return "Continue"
    if status == 200:
        return "OK"
    if status == 201:
        return "Created"
    if status == 202:
        return "Accepted"
    if status == 204:
        return "No Content"
    if status == 206:
        return "Partial Content"
    if status == 301:
        return "Moved Permanently"
    if status == 302:
        return "Found"
    if status == 303:
        return "See Other"
    if status == 304:
        return "Not Modified"
    if status == 307:
        return "Temporary Redirect"
    if status == 308:
        return "Permanent Redirect"
    if status == 400:
        return "Bad Request"
    if status == 401:
        return "Unauthorized"
    if status == 403:
        return "Forbidden"
    if status == 404:
        return "Not Found"
    if status == 405:
        return "Method Not Allowed"
    if status == 409:
        return "Conflict"
    if status == 411:
        return "Length Required"
    if status == 413:
        return "Content Too Large"
    if status == 415:
        return "Unsupported Media Type"
    if status == 416:
        return "Range Not Satisfiable"
    if status == 422:
        return "Unprocessable Content"
    if status == 426:
        return "Upgrade Required"
    if status == 429:
        return "Too Many Requests"
    if status == 431:
        return "Request Header Fields Too Large"
    if status == 500:
        return "Internal Server Error"
    if status == 501:
        return "Not Implemented"
    if status == 502:
        return "Bad Gateway"
    if status == 503:
        return "Service Unavailable"
    if status == 504:
        return "Gateway Timeout"
    return "Status"

fn hr_invalid(message: Text) -> HttpFailure:
    return HttpFailure(500, "E_HTTP_HEADER_INVALID", message)

fn hr_token_ok(name: Text) -> Bool:
    if len(name) == 0:
        return false
    let allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'*+-.^_`|~"
    let chars = text_chars(name)
    var index = 0
    while index < len(chars):
        if text_find(allowed, chars[index], 0) < 0:
            return false
        set index = index + 1
    return true

# A value may hold any byte except a control character other than horizontal tab (CR, LF and NUL
# are control characters) and DEL.
fn hr_value_ok(value: Text) -> Bool:
    let codes = bytes_to_ints(bytes_from_text(value))
    var index = 0
    while index < len(codes):
        let code = codes[index]
        if (code < 32 and code != 9) or code == 127:
            return false
        set index = index + 1
    return true

pub fn header_new(name: Text, value: Text) -> Result[Header, HttpFailure]:
    if not hr_token_ok(name):
        return Err(hr_invalid("header name is not an HTTP token"))
    if not hr_value_ok(value):
        return Err(hr_invalid("header value holds a control character such as CR, LF or NUL"))
    return Ok(Header(name, value))

pub fn body_bytes(data: Bytes) -> Body:
    return Body("bytes", data, Stream("none", "", []))

pub fn body_text(text: Text) -> Body:
    return Body("text", bytes_from_text(text), Stream("none", "", []))

pub fn body_stream(stream: Stream) -> Body:
    return Body("stream", bytes_from_ints([]), stream)

pub fn stream_from_file(path: Text) -> Stream:
    return Stream("file", path, [])

pub fn stream_from_list(chunks: List[Bytes]) -> Stream:
    return Stream("list", "", chunks)

pub fn response_new(status: Int, body: Body) -> Response:
    return Response(status, [], body)

pub fn response_text(status: Int, text: Text) -> Response:
    return Response(status, [], body_text(text))

pub fn response_bytes(status: Int, data: Bytes) -> Response:
    return Response(status, [], body_bytes(data))

# Appends a header; an existing header of the same name stays (Set-Cookie is repeated this way).
pub fn response_add_header(response: Response, name: Text, value: Text) -> Result[Response, HttpFailure]:
    let header = header_new(name, value)?
    return Ok(Response(response.status, list_push(response.headers, header), response.body))

# Replaces the first header of that name (compared without case) and drops later ones of the same
# name; appends when there is none.
pub fn response_set_header(response: Response, name: Text, value: Text) -> Result[Response, HttpFailure]:
    let header = header_new(name, value)?
    let wanted = text_casefold(name)
    var kept: List[Header] = []
    var placed = false
    var index = 0
    while index < len(response.headers):
        let current = response.headers[index]
        if text_casefold(current.name) == wanted:
            if not placed:
                set kept = list_push(kept, header)
                set placed = true
        else:
            set kept = list_push(kept, current)
        set index = index + 1
    if not placed:
        set kept = list_push(kept, header)
    return Ok(Response(response.status, kept, response.body))

pub fn response_header_values(response: Response, name: Text) -> List[Text]:
    let wanted = text_casefold(name)
    var found: List[Text] = []
    var index = 0
    while index < len(response.headers):
        if text_casefold(response.headers[index].name) == wanted:
            set found = list_push(found, response.headers[index].value)
        set index = index + 1
    return found

pub fn response_header(response: Response, name: Text) -> Option[Text]:
    let values = response_header_values(response, name)
    if len(values) == 0:
        return None
    return Some(values[0])

# A redirect with an empty body. The status must be 300 to 399 and the location is checked like any
# header value, so a CR or LF in it is refused.
pub fn response_redirect(status: Int, location: Text) -> Result[Response, HttpFailure]:
    if status < 300 or status > 399:
        return Err(HttpFailure(500, "E_HTTP_STATUS_INVALID", "a redirect status is 300 to 399"))
    return response_add_header(response_text(status, ""), "Location", location)

pub fn request_new(method: Text, path: Text) -> Request:
    let query: Map[Text, List[Text]] = {}
    let params: Map[Text, Text] = {}
    return Request(method, path, query, [], bytes_from_ints([]), params)

# The first header of that name, compared without case.
pub fn request_header(request: Request, name: Text) -> Option[Text]:
    let wanted = text_casefold(name)
    var index = 0
    while index < len(request.headers):
        if text_casefold(request.headers[index].name) == wanted:
            return Some(request.headers[index].value)
        set index = index + 1
    return None

fn hr_hex(value: Int) -> Text:
    if value == 0:
        return "0"
    let digits = "0123456789abcdef"
    var out = ""
    var rest = value
    while rest > 0:
        let digit = rest % 16
        set out = text_slice(digits, digit, digit + 1) + out
        set rest = rest // 16
    return out

fn hr_frame(data: Bytes) -> Bytes:
    return bytes_join([bytes_from_text(hr_hex(len(data)) + "\r\n"), data, bytes_from_text("\r\n")])

# Splits a block of bytes into chunk frames of at most 16384 bytes.
fn hr_frames(data: Bytes) -> List[Bytes]:
    var frames: List[Bytes] = []
    var start = 0
    while start < len(data):
        var stop = start + 16384
        if stop > len(data):
            set stop = len(data)
        set frames = list_push(frames, hr_frame(bytes_slice(data, start, stop)))
        set start = stop
    return frames

# Frames for a stream whose chunks are held in the value (a file stream has none here).
fn hr_list_frames(stream: Stream) -> List[Bytes]:
    var frames: List[Bytes] = []
    if stream.kind != "list":
        return frames
    var index = 0
    while index < len(stream.chunks):
        if len(stream.chunks[index]) > 0:
            set frames = list_push(frames, hr_frame(stream.chunks[index]))
        set index = index + 1
    return frames

fn hr_is_file_stream(response: Response) -> Bool:
    return response.body.kind == "stream" and (response.body.stream.kind == "file" or response.body.stream.kind == "file_range")

fn hr_stream_kind(response: Response) -> Text:
    if response.body.kind == "stream":
        return response.body.stream.kind
    return ""

# A stream whose length is stated by Content-Length and not by chunking.
fn hr_is_sized(response: Response) -> Bool:
    let kind = hr_stream_kind(response)
    return kind == "file_range" or kind == "sized" or kind == "headers_only"

fn hr_chunk_int(stream: Stream, index: Int) -> Int:
    if index >= len(stream.chunks):
        return -1
    match text_from_bytes(stream.chunks[index]):
        Some(text):
            match text_parse_int(text):
                Ok(value):
                    return value
                Err(problem):
                    return -1
        None:
            return -1

# The length a sized stream states, or -1 when it is malformed.
fn hr_sized_length(response: Response) -> Int:
    let stream = response.body.stream
    if stream.kind == "file_range":
        return hr_chunk_int(stream, 1)
    if stream.kind == "sized":
        return hr_chunk_int(stream, 0)
    return 0

# The head: status line, the headers that are the caller's, a default Content-Type, the framing line
# (for example `Content-Length: 12\r\n`) and Connection, ending at the blank line.
fn hr_head(response: Response, keep_alive: Bool, framing: Text) -> Result[Text, HttpFailure]:
    if response.status < 100 or response.status > 599:
        return Err(HttpFailure(500, "E_HTTP_STATUS_INVALID", "status is outside 100 to 599"))
    var head = "HTTP/1.1 " + int_to_text(response.status) + " " + hr_reason(response.status) + "\r\n"
    var has_type = false
    var index = 0
    while index < len(response.headers):
        let header = header_new(response.headers[index].name, response.headers[index].value)?
        let lowered = text_casefold(header.name)
        if lowered == "content-type":
            set has_type = true
        if lowered != "content-length" and lowered != "transfer-encoding" and lowered != "connection":
            set head = head + header.name + ": " + header.value + "\r\n"
        set index = index + 1
    if not has_type:
        if response.body.kind == "text":
            set head = head + "Content-Type: text/plain; charset=utf-8\r\n"
        else:
            set head = head + "Content-Type: application/octet-stream\r\n"
    var connection = "close"
    if keep_alive:
        set connection = "keep-alive"
    return Ok(head + framing + "Connection: " + connection + "\r\n\r\n")

fn hr_sized_framing(response: Response) -> Result[Text, HttpFailure]:
    if response.body.stream.kind == "headers_only":
        return Ok("")
    let length = hr_sized_length(response)
    if length < 0:
        return Err(HttpFailure(500, "E_HTTP_STREAM_RANGE", "a sized stream holds a malformed length"))
    return Ok("Content-Length: " + int_to_text(length) + "\r\n")

# Puts the pieces together: the head, then (for a bytes or text body) the body in the same piece or
# (for a chunked stream) one piece per frame and the closing `0` chunk, or (for a sized stream) the
# raw pieces given.
fn hr_assemble(response: Response, keep_alive: Bool, frames: List[Bytes]) -> Result[List[Bytes], HttpFailure]:
    if hr_is_sized(response):
        let framing = hr_sized_framing(response)?
        let head = hr_head(response, keep_alive, framing)?
        var parts: List[Bytes] = [bytes_from_text(head)]
        var next = 0
        while next < len(frames):
            set parts = list_push(parts, frames[next])
            set next = next + 1
        return Ok(parts)
    if response.body.kind == "stream":
        let head = hr_head(response, keep_alive, "Transfer-Encoding: chunked\r\n")?
        var parts: List[Bytes] = [bytes_from_text(head)]
        var next = 0
        while next < len(frames):
            set parts = list_push(parts, frames[next])
            set next = next + 1
        set parts = list_push(parts, bytes_from_text("0\r\n\r\n"))
        return Ok(parts)
    let head = hr_head(response, keep_alive, "Content-Length: " + int_to_text(len(response.body.data)) + "\r\n")?
    return Ok([bytes_join([bytes_from_text(head), response.body.data])])

# The wire form of a response as pieces to send in order: the head (with the whole body for a bytes
# or text body), then one piece per chunk and the closing `0` chunk for a stream. Content-Length,
# Transfer-Encoding and Connection are set here, so a header of those names on the value is not sent.
# A missing Content-Type becomes text/plain for a text body and application/octet-stream otherwise.
# This form touches no file, so it carries no file effect: a stream from stream_from_file or a file
# range is refused with E_HTTP_STREAM_FILE (use response_wire, which reads the file).
pub fn response_wire_memory(response: Response, keep_alive: Bool) -> Result[List[Bytes], HttpFailure]:
    if hr_is_file_stream(response):
        return Err(HttpFailure(500, "E_HTTP_STREAM_FILE", "a file stream is read by response_wire, not response_wire_memory"))
    return hr_assemble(response, keep_alive, hr_list_frames(response.body.stream))

# The same pieces, reading the file of a stream_from_file stream or a file range (effect
# filesystem.read). A whole file is read into memory here, in chunks of at most 16384 bytes; a range
# is read at most 16 MiB at a time. std:http_server does not use this form to send a file: it sends
# in blocks (see response_file_plan). An unreadable file is E_HTTP_STREAM_READ.
pub fn response_wire(response: Response, keep_alive: Bool) -> Result[List[Bytes], HttpFailure]:
    if hr_stream_kind(response) == "file_range":
        let plan = hr_range_plan(response)?
        match native_fs_read_range(plan.path, int_to_text(plan.start), int_to_text(plan.length)):
            Ok(data):
                if len(data) != plan.length:
                    return Err(HttpFailure(500, "E_HTTP_STREAM_READ", "the file is shorter than the range"))
                return hr_assemble(response, keep_alive, [data])
            Err(problem):
                return Err(HttpFailure(500, "E_HTTP_STREAM_READ", file_error_message(problem)))
    if hr_is_file_stream(response):
        match read_bytes(response.body.stream.path):
            Ok(data):
                return hr_assemble(response, keep_alive, hr_frames(data))
            Err(problem):
                return Err(HttpFailure(500, "E_HTTP_STREAM_READ", file_error_message(problem)))
    return hr_assemble(response, keep_alive, hr_list_frames(response.body.stream))

fn hr_range_plan(response: Response) -> Result[FilePlan, HttpFailure]:
    let stream = response.body.stream
    let start = hr_chunk_int(stream, 0)
    let length = hr_chunk_int(stream, 1)
    if start < 0 or length < 0:
        return Err(HttpFailure(500, "E_HTTP_STREAM_RANGE", "a file range holds a malformed start or length"))
    return Ok(FilePlan(stream.path, start, length, false))

fn hr_some_plan(plan: FilePlan) -> Option[FilePlan]:
    return Some(plan)

fn hr_no_plan() -> Option[FilePlan]:
    return None

# For a response whose body is a file (stream_from_file or a file range), how to send it in blocks:
# the path, the first byte, the number of bytes and whether the body is chunked. None for any other
# body. A whole-file stream is sized by the file's current size (effect filesystem.read).
pub fn response_file_plan(response: Response) -> Result[Option[FilePlan], HttpFailure]:
    if hr_stream_kind(response) == "file_range":
        let plan = hr_range_plan(response)?
        return Ok(hr_some_plan(plan))
    if hr_stream_kind(response) == "file":
        match native_fs_size(response.body.stream.path):
            Ok(size):
                return Ok(hr_some_plan(FilePlan(response.body.stream.path, 0, size, true)))
            Err(problem):
                return Err(HttpFailure(500, "E_HTTP_STREAM_READ", file_error_message(problem)))
    return Ok(hr_no_plan())

# The head to send before the blocks of a file body (Content-Length for a range, chunked for a whole
# file). Touches no file.
pub fn response_file_head(response: Response, keep_alive: Bool) -> Result[Bytes, HttpFailure]:
    if hr_stream_kind(response) == "file_range":
        let plan = hr_range_plan(response)?
        let head = hr_head(response, keep_alive, "Content-Length: " + int_to_text(plan.length) + "\r\n")?
        return Ok(bytes_from_text(head))
    let head = hr_head(response, keep_alive, "Transfer-Encoding: chunked\r\n")?
    return Ok(bytes_from_text(head))

# How many file bytes one block of a plan holds: 65536, or 16384 when chunked.
pub fn response_file_block_size(plan: FilePlan) -> Int:
    if plan.chunked:
        return 16384
    return 65536

# The next piece of a planned file body, starting `offset` bytes into it: at most 65536 bytes, or
# 16384 when chunked, framed as a chunk when the plan is chunked. Empty once offset reaches the end.
# The file shrinking underneath is E_HTTP_STREAM_READ.
pub fn response_file_block(plan: FilePlan, offset: Int) -> Result[Bytes, HttpFailure]:
    if offset >= plan.length:
        return Ok(bytes_from_ints([]))
    let block = response_file_block_size(plan)
    var take = plan.length - offset
    if take > block:
        set take = block
    match native_fs_read_range(plan.path, int_to_text(plan.start + offset), int_to_text(take)):
        Ok(data):
            if len(data) != take:
                return Err(HttpFailure(500, "E_HTTP_STREAM_READ", "the file changed while it was being sent"))
            if plan.chunked:
                return Ok(hr_frame(data))
            return Ok(data)
        Err(problem):
            return Err(HttpFailure(500, "E_HTTP_STREAM_READ", file_error_message(problem)))

# What follows the last block: the closing `0` chunk when chunked, nothing otherwise.
pub fn response_file_end(plan: FilePlan) -> Bytes:
    if plan.chunked:
        return bytes_from_text("0\r\n\r\n")
    return bytes_from_ints([])

pub fn response_serialize_for(response: Response, keep_alive: Bool) -> Result[Bytes, HttpFailure]:
    let parts = response_wire(response, keep_alive)?
    return Ok(bytes_join(parts))

# The bytes a client would read, with `Connection: close`.
pub fn response_serialize(response: Response) -> Result[Bytes, HttpFailure]:
    return response_serialize_for(response, false)
