import "std:types"

# std:yaml: a read-only reader for a small, documented subset of YAML.
# There is no writer; use std:toml or std:json for output.
#
# yaml_parse(text) reads ONE YAML document and returns it as Json, or Err(StdError) with the
# line and column (both 1-based, in `line` and `column`) of the problem. The result is never
# partial: either the whole document parses or there is an error.
#
# Supported: block mappings and block sequences; plain, 'single-quoted' and "double-quoted"
# scalars (quoted scalars may span lines); literal `|` and folded `>` block scalars with the
# chomping (`+`, `-`) and indentation-digit indicators; flow sequences `[a, b]` and flow
# mappings `{a: 1}`; comments; nesting up to 64 levels; one optional leading `---` and a
# trailing `...`. Mapping keys are always text.
#
# Scalar policy. A plain (unquoted) scalar is TEXT, except:
#   true and false         booleans (lowercase only)
#   null and ~             null
#   42, -7, 2.75           an integer or decimal that reads back unchanged
# So NO, yes, on, off, True and Null are the text they spell. 1.10 is the text "1.10" (as a
# number it would become 1.1 and lose a digit), and so are 007, 1e3, 0x1F and an integer too
# large for 64 bits. A quoted scalar is always text: "NO", '1.10' and "5" stay text.
#
# Rejected, never partly parsed. These are the typed error YAML_UNSUPPORTED, whose message names
# the feature: anchors (&name), aliases (*name), tags (!!str, !name), the merge key `<<`,
# complex `?` keys, directives (%YAML) and a stream of more than one document. Other errors:
# YAML_SYNTAX (bad indentation, a tab used as indentation, an unterminated quote or flow
# collection, an invalid escape, `a: b: c`), YAML_DUPLICATE_KEY (a key repeated in one mapping)
# and YAML_LIMIT (nesting deeper than 64 levels). It never panics on malformed input.
#
# Needs no grant. The input is a Text value, so `read_text` (which needs the file-read grant)
# is the way to read a file.
pub fn yaml_parse(text: Text) -> Result[Json, StdError]:
    return native_yaml_parse(text)
