import "std:text"

record HtmlAttribute:
    name: Text
    value: Text

record HtmlTag:
    name: Text
    attributes: List[HtmlAttribute]
    next_index: Int
    closing: Bool
    self_closing: Bool
    error: Text

record MarkerReplacement:
    value: Text
    hello_hits: Int
    option_hits: Int
    record_hits: Int

fn main() -> Int:
    let page = build_page()
    let problem = validate_html_error(page)
    if problem != "":
        print("HTML validation failed: " + problem)
        return 1
    let written = write_text_atomic("guion-showcase.html", page)
    if is_ok(written):
        print("Built guion-showcase.html atomically")
        return 0
    else:
        print("Could not write guion-showcase.html: " + file_error_code(error(written)))
        return 1

pub fn build_page() -> Text:
    let template = unwrap(read_text("guion-site.template.html"))
    let hello = strip_trailing_line_feeds(unwrap(read_text("examples/hello.gu")))
    let option = strip_trailing_line_feeds(unwrap(read_text("examples/option.gu")))
    let records = strip_trailing_line_feeds(unwrap(read_text("examples/records.gu")))
    let hello_code = highlight_guion(hello)
    let option_code = highlight_guion(option)
    let records_code = highlight_guion(records)
    let rendered = replace_markers(template, hello_code, option_code, records_code)
    if rendered.hello_hits != 1 or rendered.option_hits != 1 or rendered.record_hits != 1:
        return ""
    return rendered.value

fn replace_markers(source: Text, hello_code: Text, option_code: Text, record_code: Text) -> MarkerReplacement:
    let characters = text_chars(source)
    let hello_marker = text_chars("{{CODE_HELLO}}")
    let option_marker = text_chars("{{CODE_OPTION}}")
    let record_marker = text_chars("{{CODE_RECORD}}")
    var result = ""
    var cursor = 0
    var segment_start = 0
    var hello_hits = 0
    var option_hits = 0
    var record_hits = 0
    while cursor < len(characters):
        if characters[cursor] == "{" and cursor + 1 < len(characters) and characters[cursor + 1] == "{":
            if text_matches_at(characters, hello_marker, cursor):
                set result = result + text_slice(source, segment_start, cursor) + hello_code
                set cursor = cursor + len(hello_marker)
                set segment_start = cursor
                set hello_hits = hello_hits + 1
            else:
                if text_matches_at(characters, option_marker, cursor):
                    set result = result + text_slice(source, segment_start, cursor) + option_code
                    set cursor = cursor + len(option_marker)
                    set segment_start = cursor
                    set option_hits = option_hits + 1
                else:
                    if text_matches_at(characters, record_marker, cursor):
                        set result = result + text_slice(source, segment_start, cursor) + record_code
                        set cursor = cursor + len(record_marker)
                        set segment_start = cursor
                        set record_hits = record_hits + 1
                    else:
                        set cursor = cursor + 1
        else:
            set cursor = cursor + 1
    set result = result + text_slice(source, segment_start, len(characters))
    return MarkerReplacement(result, hello_hits, option_hits, record_hits)

fn strip_trailing_line_feeds(source: Text) -> Text:
    let characters = text_chars(source)
    var end = len(characters)
    while end > 0 and characters[end - 1] == "\n":
        set end = end - 1
    var result = ""
    var index = 0
    while index < end:
        set result = result + characters[index]
        set index = index + 1
    return result

pub fn validate_html(html: Text) -> Bool:
    return validate_html_error(html) == ""

pub fn validate_html_error(html: Text) -> Text:
    return html_document_error(text_chars(html))

pub fn highlight_guion(source: Text) -> Text:
    let source_chars = text_chars(source)
    var rendered = ""
    var index = 0
    while index < len(source_chars):
        let current = source_chars[index]
        if current == "\"":
            var cursor = index + 1
            var escaped = false
            var closed = false
            while cursor < len(source_chars) and not closed:
                let next = source_chars[cursor]
                if escaped:
                    set escaped = false
                else:
                    if next == "\\":
                        set escaped = true
                    else:
                        if next == "\"":
                            set closed = true
                set cursor = cursor + 1
            if closed:
                let token = chars_to_text(source_chars, index, cursor)
                set rendered = rendered + "<span class=\"str\">" + escape_html(token) + "</span>"
                set index = cursor
            else:
                set rendered = rendered + escape_html(current)
                set index = index + 1
        else:
            if is_identifier_start(current):
                var cursor = index + 1
                while cursor < len(source_chars) and is_identifier_continue(source_chars[cursor]):
                    set cursor = cursor + 1
                let token = chars_to_text(source_chars, index, cursor)
                if is_showcase_keyword(token):
                    set rendered = rendered + "<span class=\"kw\">" + escape_html(token) + "</span>"
                else:
                    if is_showcase_type(token):
                        set rendered = rendered + "<span class=\"ty\">" + escape_html(token) + "</span>"
                    else:
                        set rendered = rendered + escape_html(token)
                set index = cursor
            else:
                if is_digit(current):
                    var cursor = index + 1
                    while cursor < len(source_chars) and is_digit(source_chars[cursor]):
                        set cursor = cursor + 1
                    let token = chars_to_text(source_chars, index, cursor)
                    set rendered = rendered + "<span class=\"num\">" + token + "</span>"
                    set index = cursor
                else:
                    set rendered = rendered + escape_html(current)
                    set index = index + 1
    return rendered

fn chars_to_text(characters: List[Text], start: Int, end: Int) -> Text:
    var result = ""
    var index = start
    while index < end:
        set result = result + characters[index]
        set index = index + 1
    return result

fn escape_html(value: Text) -> Text:
    let characters = text_chars(value)
    var escaped = ""
    var index = 0
    while index < len(characters):
        let current = characters[index]
        if current == "&":
            set escaped = escaped + "&amp;"
        else:
            if current == "<":
                set escaped = escaped + "&lt;"
            else:
                if current == ">":
                    set escaped = escaped + "&gt;"
                else:
                    if current == "\"":
                        set escaped = escaped + "&quot;"
                    else:
                        if current == "'":
                            set escaped = escaped + "&#x27;"
                        else:
                            set escaped = escaped + current
        set index = index + 1
    return escaped

fn is_showcase_keyword(value: Text) -> Bool:
    return value == "fn" or value == "let" or value == "var" or value == "set" or value == "if" or value == "else" or value == "while" or value == "return" or value == "record"

fn is_showcase_type(value: Text) -> Bool:
    return value == "Int" or value == "Text" or value == "Bool" or value == "Option" or value == "Result" or value == "Some" or value == "None" or value == "Point"

fn is_ascii_letter(value: Text) -> Bool:
    return (value >= "a" and value <= "z") or (value >= "A" and value <= "Z")

fn is_digit(value: Text) -> Bool:
    return value >= "0" and value <= "9"

fn is_identifier_start(value: Text) -> Bool:
    return is_ascii_letter(value) or value == "_"

fn is_identifier_continue(value: Text) -> Bool:
    return is_identifier_start(value) or is_digit(value)

fn is_space(value: Text) -> Bool:
    return value == " " or value == "\t" or value == "\n" or value == "\r" or value == "\u{000b}" or value == "\u{000c}" or value == "\u{00a0}" or value == "\u{1680}" or value == "\u{2000}" or value == "\u{2001}" or value == "\u{2002}" or value == "\u{2003}" or value == "\u{2004}" or value == "\u{2005}" or value == "\u{2006}" or value == "\u{2007}" or value == "\u{2008}" or value == "\u{2009}" or value == "\u{200a}" or value == "\u{2028}" or value == "\u{2029}" or value == "\u{202f}" or value == "\u{205f}" or value == "\u{3000}"

fn is_tag_name_char(value: Text) -> Bool:
    return is_ascii_letter(value) or is_digit(value) or value == "-" or value == ":"

fn is_attribute_name_char(value: Text) -> Bool:
    return not is_space(value) and value != ">" and value != "/" and value != "=" and value != "\"" and value != "'"

fn is_void_tag(name: Text) -> Bool:
    return name == "area" or name == "base" or name == "br" or name == "col" or name == "embed" or name == "hr" or name == "img" or name == "input" or name == "link" or name == "meta" or name == "param" or name == "source" or name == "track" or name == "wbr"

fn text_matches_at(source: List[Text], needle: List[Text], start: Int) -> Bool:
    if start < 0 or len(needle) == 0 or start + len(needle) > len(source):
        return false
    var offset = 0
    while offset < len(needle):
        if source[start + offset] != needle[offset]:
            return false
        set offset = offset + 1
    return true

fn text_starts_with(value: Text, prefix: Text) -> Bool:
    return text_matches_at(text_chars(value), text_chars(prefix), 0)

fn text_list_contains(values: List[Text], value: Text) -> Bool:
    var index = 0
    while index < len(values):
        if values[index] == value:
            return true
        set index = index + 1
    return false

fn html_attribute_value(attributes: List[HtmlAttribute], name: Text) -> Text:
    var result = ""
    var index = 0
    while index < len(attributes):
        if attributes[index].name == name:
            set result = attributes[index].value
        set index = index + 1
    return result

fn html_tag_error(tag: HtmlTag) -> Text:
    return tag.error

fn parse_html_tag(document: List[Text], start: Int) -> HtmlTag:
    var cursor = start + 1
    var closing = false
    if cursor < len(document) and document[cursor] == "/":
        set closing = true
        set cursor = cursor + 1
    if cursor >= len(document) or not is_ascii_letter(document[cursor]):
        return HtmlTag("", [], start + 1, false, false, "Malformed tag name")
    var name = ""
    while cursor < len(document) and is_tag_name_char(document[cursor]):
        set name = name + document[cursor]
        set cursor = cursor + 1
    set name = text_casefold(name)
    if closing:
        while cursor < len(document) and is_space(document[cursor]):
            set cursor = cursor + 1
        if cursor >= len(document) or document[cursor] != ">":
            return HtmlTag(name, [], start + 1, true, false, "Malformed closing tag")
        return HtmlTag(name, [], cursor + 1, true, false, "")
    var attributes: List[HtmlAttribute] = []
    var self_closing = false
    while cursor < len(document):
        while cursor < len(document) and is_space(document[cursor]):
            set cursor = cursor + 1
        if cursor >= len(document):
            return HtmlTag(name, attributes, start + 1, false, self_closing, "Unclosed opening tag: " + name)
        if document[cursor] == ">":
            return HtmlTag(name, attributes, cursor + 1, false, self_closing, "")
        if document[cursor] == "/":
            set self_closing = true
            set cursor = cursor + 1
            while cursor < len(document) and is_space(document[cursor]):
                set cursor = cursor + 1
            if cursor < len(document) and document[cursor] == ">":
                return HtmlTag(name, attributes, cursor + 1, false, true, "")
            return HtmlTag(name, attributes, start + 1, false, true, "Malformed self-closing tag: " + name)
        let attribute_start = cursor
        while cursor < len(document) and is_attribute_name_char(document[cursor]):
            set cursor = cursor + 1
        if cursor == attribute_start:
            return HtmlTag(name, attributes, start + 1, false, self_closing, "Malformed attribute in: " + name)
        let attribute_name = text_casefold(chars_to_text(document, attribute_start, cursor))
        while cursor < len(document) and is_space(document[cursor]):
            set cursor = cursor + 1
        var attribute_value = ""
        if cursor < len(document) and document[cursor] == "=":
            set cursor = cursor + 1
            while cursor < len(document) and is_space(document[cursor]):
                set cursor = cursor + 1
            if cursor < len(document) and (document[cursor] == "\"" or document[cursor] == "'"):
                let quote = document[cursor]
                set cursor = cursor + 1
                var closed = false
                while cursor < len(document) and not closed:
                    if document[cursor] == quote:
                        set closed = true
                    else:
                        set attribute_value = attribute_value + document[cursor]
                    set cursor = cursor + 1
                if not closed:
                    return HtmlTag(name, attributes, start + 1, false, self_closing, "Unclosed quoted attribute in: " + name)
            else:
                while cursor < len(document) and not is_space(document[cursor]) and document[cursor] != ">":
                    set attribute_value = attribute_value + document[cursor]
                    set cursor = cursor + 1
        set attributes = list_push(attributes, HtmlAttribute(attribute_name, attribute_value))
    return HtmlTag(name, attributes, start + 1, false, self_closing, "Unclosed opening tag: " + name)

fn css_import_at(characters: List[Text], start: Int) -> Bool:
    let css_import = text_chars("@import")
    if not text_matches_at(characters, css_import, start):
        return false
    let after_import = start + len(css_import)
    return after_import >= len(characters) or not is_identifier_continue(characters[after_import])

fn css_remote_url_at(characters: List[Text], start: Int) -> Bool:
    let css_url = text_chars("url(")
    let external_http = text_chars("http://")
    let external_https = text_chars("https://")
    if not text_matches_at(characters, css_url, start):
        return false
    var cursor = start + len(css_url)
    while cursor < len(characters) and is_space(characters[cursor]):
        set cursor = cursor + 1
    if cursor < len(characters) and (characters[cursor] == "\"" or characters[cursor] == "'"):
        set cursor = cursor + 1
    return text_matches_at(characters, external_http, cursor) or text_matches_at(characters, external_https, cursor)

fn css_has_external_reference(characters: List[Text]) -> Bool:
    var index = 0
    while index < len(characters):
        if characters[index] == "@" and css_import_at(characters, index):
            return true
        if characters[index] == "u" and css_remote_url_at(characters, index):
            return true
        set index = index + 1
    return false

fn is_external_asset_tag(name: Text) -> Bool:
    return name == "img" or name == "iframe" or name == "video" or name == "audio" or name == "source"

fn attribute_references(attributes: List[HtmlAttribute], references: List[Text]) -> List[Text]:
    var result = references
    var index = 0
    while index < len(attributes):
        let attribute = attributes[index]
        if attribute.name == "popovertarget" or attribute.name == "commandfor":
            if attribute.value != "":
                set result = list_push(result, attribute.value)
        if attribute.name == "href" and text_starts_with(attribute.value, "#"):
            let target_chars = text_chars(attribute.value)
            if len(target_chars) > 1:
                set result = list_push(result, chars_to_text(target_chars, 1, len(target_chars)))
        set index = index + 1
    return result

fn html_document_error(document: List[Text]) -> Text:
    let doctype = text_chars("<!doctype html>")
    let comment_open = text_chars("<!--")
    let comment_close = text_chars("-->")
    let code_placeholder = text_chars("{{CODE_")
    var stack: List[Text] = []
    var ids: List[Text] = []
    var references: List[Text] = []
    var depth = 0
    var index = 0
    var has_doctype = false
    var has_html = false
    var has_head = false
    var has_body = false
    var duplicate_id = false
    var external_asset = false
    var external_stylesheet = false
    var script_element = false
    var inline_svg = 0
    var h1_count = 0
    var unexpanded_code = false
    while index < len(document):
        let current = document[index]
        var following = ""
        if index + 1 < len(document):
            set following = document[index + 1]
        if current == "{" and following == "{" and text_matches_at(document, code_placeholder, index):
            set unexpanded_code = true
        if current != "<":
            if current == "@" and following == "i" and css_import_at(document, index):
                set external_stylesheet = true
            if current == "u" and following == "r" and css_remote_url_at(document, index):
                set external_stylesheet = true
            set index = index + 1
        else:
            if following == "!" and text_matches_at(document, doctype, index):
                set has_doctype = true
                set index = index + len(doctype)
            else:
                if following == "!" and text_matches_at(document, comment_open, index):
                    var scan = index + 4
                    var ended = false
                    while scan + 2 < len(document) and not ended:
                        if document[scan] == "-" and text_matches_at(document, comment_close, scan):
                            set ended = true
                        else:
                            set scan = scan + 1
                    if not ended:
                        return "Unclosed HTML comment"
                    var comment_index = index
                    while comment_index < scan + 3:
                        if document[comment_index] == "{" and text_matches_at(document, code_placeholder, comment_index):
                            set unexpanded_code = true
                        if document[comment_index] == "@" and css_import_at(document, comment_index):
                            set external_stylesheet = true
                        if document[comment_index] == "u" and css_remote_url_at(document, comment_index):
                            set external_stylesheet = true
                        set comment_index = comment_index + 1
                    set index = scan + 3
                else:
                    if following == "!" or following == "?":
                        var scan = index + 2
                        while scan < len(document) and document[scan] != ">":
                            set scan = scan + 1
                        if scan >= len(document):
                            return "Unclosed declaration"
                        set index = scan + 1
                    else:
                        let tag = parse_html_tag(document, index)
                        if html_tag_error(tag) != "":
                            return html_tag_error(tag)
                        if tag.name == "script":
                            set script_element = true
                        if tag.name == "svg" and not tag.closing:
                            set inline_svg = inline_svg + 1
                        if tag.name == "h1" and not tag.closing:
                            set h1_count = h1_count + 1
                        if tag.closing:
                            if depth == 0:
                                return "Unexpected closing tag: " + tag.name
                            if stack[depth - 1] != tag.name:
                                return "Mismatched closing tag: " + tag.name
                            set depth = depth - 1
                        else:
                            if tag.name == "html":
                                set has_html = true
                            if tag.name == "head":
                                set has_head = true
                            if tag.name == "body":
                                set has_body = true
                            let rel = html_attribute_value(tag.attributes, "rel")
                            if tag.name == "link" and rel == "stylesheet":
                                set external_stylesheet = true
                            if is_external_asset_tag(tag.name):
                                let source = html_attribute_value(tag.attributes, "src")
                                if source != "" and not text_starts_with(source, "data:") and not text_starts_with(source, "#"):
                                    set external_asset = true
                            let attributes = tag.attributes
                            var attribute_index = 0
                            while attribute_index < len(attributes):
                                let attribute = attributes[attribute_index]
                                if attribute.name == "id" and attribute.value != "":
                                    if text_list_contains(ids, attribute.value):
                                        set duplicate_id = true
                                    else:
                                        set ids = list_push(ids, attribute.value)
                                set references = attribute_references([attribute], references)
                                let attribute_chars = text_chars(attribute.value)
                                if css_has_external_reference(attribute_chars):
                                    set external_stylesheet = true
                                var marker_index = 0
                                while marker_index < len(attribute_chars):
                                    if attribute_chars[marker_index] == "{" and text_matches_at(attribute_chars, code_placeholder, marker_index):
                                        set unexpanded_code = true
                                    set marker_index = marker_index + 1
                                set attribute_index = attribute_index + 1
                            if not is_void_tag(tag.name) and not tag.self_closing:
                                if depth < len(stack):
                                    set stack = list_set(stack, depth, tag.name)
                                else:
                                    set stack = list_push(stack, tag.name)
                                set depth = depth + 1
                        set index = tag.next_index
    if not has_doctype:
        return "Missing HTML doctype"
    if not has_html:
        return "Missing html root element"
    if not has_head:
        return "Missing head element"
    if not has_body:
        return "Missing body element"
    if depth != 0:
        return "Unclosed HTML tag: " + stack[depth - 1]
    if script_element:
        return "Script elements are not allowed"
    if external_asset:
        return "External runtime assets are not allowed"
    if external_stylesheet:
        return "External stylesheets are not allowed"
    if duplicate_id:
        return "Duplicate HTML id"
    if unexpanded_code:
        return "Unexpanded source-code placeholder"
    if inline_svg == 0:
        return "Inline SVG is required"
    if h1_count != 1:
        return "Expected exactly one h1 element"
    var reference_index = 0
    while reference_index < len(references):
        if not text_list_contains(ids, references[reference_index]):
            return "Unresolved internal target: " + references[reference_index]
        set reference_index = reference_index + 1
    return ""

fn valid_document(body: Text) -> Text:
    return "<!doctype html><html><head><title>ok</title></head><body><h1>Example</h1><svg viewBox=\"0 0 1 1\"></svg>" + body + "</body></html>"

fn test_validator_accepts_balanced_document() -> Unit:
    assert(validate_html(valid_document("<p>ok</p>")))

fn test_validator_rejects_script() -> Unit:
    assert(not validate_html(valid_document("<script>bad()</script>")))

fn test_validator_rejects_external_assets() -> Unit:
    assert(not validate_html(valid_document("<img src=\"https://cdn.example/image.svg\">")))
    assert(not validate_html(valid_document("<link rel=\"stylesheet\" href=\"https://cdn.example/site.css\">")))

fn test_validator_rejects_source_attributes_even_with_spacing() -> Unit:
    assert(not validate_html(valid_document("<img src = 'local.svg'>")))

fn test_validator_rejects_external_css_references() -> Unit:
    assert(not validate_html(valid_document("<style>@import 'local.css';</style>")))
    assert(not validate_html(valid_document("<style>.hero { background: url(https://cdn.example/image.svg); }</style>")))
    assert(not validate_html(valid_document("<!-- @import 'local.css'; -->")))
    assert(validate_html(valid_document("<style>.hero { background: url(local.svg); }</style>")))

fn test_validator_allows_external_navigation_links() -> Unit:
    assert(validate_html(valid_document("<a href=\"https://example.com/\">reference</a>")))

fn test_validator_rejects_duplicate_ids() -> Unit:
    assert(not validate_html(valid_document("<p id=\"same\"></p><div id=\"same\"></div>")))

fn test_validator_rejects_unresolved_internal_targets() -> Unit:
    assert(not validate_html(valid_document("<a href=\"#missing\">jump</a>")))

fn test_validator_accepts_resolved_native_targets() -> Unit:
    assert(validate_html(valid_document("<a href=\"#note\">jump</a><div id=\"note\"></div><button popovertarget=\"note\">open</button>")))

fn test_validator_requires_document_showcase_features() -> Unit:
    assert(not validate_html("<!doctype html><html><head></head><body><h1>one</h1><h1>two</h1><svg></svg></body></html>"))
    assert(not validate_html("<!doctype html><html><head></head><body><h1>one</h1></body></html>"))

fn test_validator_rejects_code_placeholders() -> Unit:
    assert(not validate_html(valid_document("<code>{{CODE_HELLO}}</code>")))
    assert(not validate_html(valid_document("<!-- {{CODE_HELLO}} -->")))
    assert(not validate_html(valid_document("<div title=\"{{CODE_HELLO}}\"></div>")))

fn test_validator_rejects_mismatched_tags() -> Unit:
    assert(not validate_html(valid_document("<section></main>")))

fn test_validator_handles_greater_than_inside_quoted_attribute() -> Unit:
    assert(validate_html(valid_document("<p title=\"a > b\">ok</p>")))

fn test_validator_rejects_unclosed_tag() -> Unit:
    assert(not validate_html(valid_document("<main>open")))

fn test_highlighter_escapes_source_markup() -> Unit:
    let highlighted = highlight_guion("let body = \"<script>&\"")
    assert(highlighted == "<span class=\"kw\">let</span> body = <span class=\"str\">&quot;&lt;script&gt;&amp;&quot;</span>")

fn test_highlighter_matches_showcase_token_classes() -> Unit:
    let highlighted = highlight_guion("fn main() -> Int:\n    return 2")
    assert(highlighted == "<span class=\"kw\">fn</span> main() -&gt; <span class=\"ty\">Int</span>:\n    <span class=\"kw\">return</span> <span class=\"num\">2</span>")

fn test_highlighter_matches_python_escape_for_apostrophe() -> Unit:
    assert(escape_html("'a'") == "&#x27;a&#x27;")

fn test_build_page_is_complete() -> Unit:
    let page = build_page()
    assert(validate_html(page))
    assert(len(page) > 40000)

fn test_showcase_links_optional_browser_playground() -> Unit:
    let page = text_chars(build_page())
    let needle = text_chars("href=\"./playground/guion-playground.html\"")
    var found = false
    var index = 0
    while index + len(needle) <= len(page):
        if page[index] == "h" and text_matches_at(page, needle, index):
            set found = true
        set index = index + 1
    assert(found)
