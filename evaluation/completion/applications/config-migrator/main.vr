import "std:toml"
import "std:types"

fn valid_positive_int(document: TomlDocument, path: List[Text]) -> Bool:
    let value = toml_get_int(document, path)
    if not is_ok(value):
        return false
    return unwrap(value) > 0

fn main() -> Int:
    let arguments = args()
    var operation = ""
    var path = ""
    var index = 0
    while index < len(arguments):
        if arguments[index] == "check" or arguments[index] == "migrate":
            if operation != "":
                eprint("specify exactly one operation")
                return 2
            set operation = arguments[index]
            set index = index + 1
        else:
            if arguments[index] == "--file" and index + 1 < len(arguments):
                set path = arguments[index + 1]
                set index = index + 2
            else:
                eprint("unknown or incomplete argument")
                return 2
    if operation == "" or path == "":
        eprint("usage: config-migrator check|migrate --file PATH")
        return 2
    let source_result = read_text(path)
    if not is_ok(source_result):
        eprint("cannot read configuration")
        return 1
    let source = unwrap(source_result)
    let parsed = toml_parse(source)
    if not is_ok(parsed):
        let problem = error(parsed)
        eprint("invalid TOML: " + problem.message)
        return 1
    let document = unwrap(parsed)
    let version_result = toml_get_int(document, ["version"])
    if not is_ok(version_result):
        eprint("version must be an integer")
        return 1
    let version = unwrap(version_result)
    if version < 1 or version > 3:
        eprint("unsupported schema version")
        return 1
    let name_result = toml_get_text(document, ["name"])
    if not is_ok(name_result) or unwrap(name_result) == "":
        eprint("name must be non-empty text")
        return 1

    if version >= 2:
        if not toml_has(document, ["sync"]):
            eprint("sync section is required")
            return 1
        if not valid_positive_int(document, ["sync", "timeout_seconds"]):
            eprint("sync.timeout_seconds must be a positive integer")
            return 1
    if version == 2 and toml_has(document, ["sync", "parallelism"]):
        if not valid_positive_int(document, ["sync", "parallelism"]):
            eprint("sync.parallelism must be a positive integer")
            return 1
    if version == 3:
        if not valid_positive_int(document, ["sync", "parallelism"]):
            eprint("sync.parallelism must be a positive integer")
            return 1
    if operation == "check":
        return 0
    if version == 3:
        return 0

    var edited = document
    if version == 1:
        if toml_has(edited, ["sync", "timeout_seconds"]):
            if not valid_positive_int(edited, ["sync", "timeout_seconds"]):
                eprint("sync.timeout_seconds must be a positive integer")
                return 1
        else:
            let timeout_write = toml_put_int(edited, ["sync", "timeout_seconds"], 30)
            if not is_ok(timeout_write):
                eprint("sync must be a table")
                return 1
        let version_write = toml_put_int(edited, ["version"], 2)
        if not is_ok(version_write):
            eprint("cannot update schema version")
            return 1
    else:
        if not toml_has(edited, ["sync", "parallelism"]):
            let parallelism_write = toml_put_int(edited, ["sync", "parallelism"], 4)
            if not is_ok(parallelism_write):
                eprint("sync must be a table")
                return 1
        let version_write = toml_put_int(edited, ["version"], 3)
        if not is_ok(version_write):
            eprint("cannot update schema version")
            return 1
    let rendered = toml_render(edited)
    let written = write_text_atomic(path, rendered)
    if not is_ok(written):
        eprint("cannot atomically update configuration")
        return 1
    return 0
