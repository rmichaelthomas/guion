import "std:types"
import "std:csv"
import "std:text"

fn main() -> Int:
    let opened = csv_open_reader("data.csv")
    if not is_ok(opened):
        return 1
    let reader = unwrap(opened)
    var total = 0
    var first = true
    while true:
        let next = csv_next_row(reader)
        if not is_ok(next):
            return 2
        let row = unwrap(next)
        if not is_some(row):
            print("total: " + int_to_text(total))
            return 0
        if first:
            set first = false
        else:
            let parsed = text_parse_integer(unwrap(list_get(unwrap(row).fields, 1)))
            if is_ok(parsed):
                set total = total + unwrap(parsed)
    return 0
