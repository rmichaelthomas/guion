extern python "jsonl_support:parse_events" fn parse_events(source: Text) -> Json
extern python "jsonl_support:parse_services" fn parse_services(source: Text) -> List[Text]

fn main() -> Int:
    let arguments = args()
    var events_path = ""
    var policy_path = ""
    var output_path = ""
    var services_path = ""
    var strict = false
    var i = 0
    while i < len(arguments):
        if arguments[i] == "--events" and i + 1 < len(arguments):
            set events_path = arguments[i + 1]
            set i = i + 2
        else:
            if arguments[i] == "--policy" and i + 1 < len(arguments):
                set policy_path = arguments[i + 1]
                set i = i + 2
            else:
                if arguments[i] == "--output" and i + 1 < len(arguments):
                    set output_path = arguments[i + 1]
                    set i = i + 2
                else:
                    if arguments[i] == "--services" and i + 1 < len(arguments):
                        set services_path = arguments[i + 1]
                        set i = i + 2
                    else:
                        if arguments[i] == "--strict":
                            set strict = true
                            set i = i + 1
                        else:
                            eprint("unknown or incomplete argument")
                            return 2

    if events_path == "" or policy_path == "" or output_path == "":
        eprint("usage: jsonl-retention --events PATH --policy PATH --output PATH [--strict] [--services PATH]")
        return 2

    let events_text = read_text(events_path)
    let policy_text = read_text(policy_path)
    if not is_ok(events_text) or not is_ok(policy_text):
        eprint("cannot read events or policy file")
        return 1
    let policy = json_parse(unwrap(policy_text))
    if not is_ok(policy):
        eprint("invalid policy JSON")
        return 1

    let parsed = parse_events(unwrap(events_text))
    let events = json_get(parsed, "events")
    let invalid = json_get(parsed, "invalid")
    if strict and json_len(invalid) > 0:
        eprint("invalid event at line " + json_stringify(json_get(json_index(invalid, 0), "line")))
        return 1

    var allowed: Map[Text, Bool] = {}
    if services_path != "":
        let services_text = read_text(services_path)
        if not is_ok(services_text):
            eprint("cannot read services file")
            return 1
        let service_values = parse_services(unwrap(services_text))
        for service in service_values:
            set allowed = map_set(allowed, service, true)

    var grouped: Map[Text, Map[Text, Json]] = {}
    var ignored_count = 0
    var event_index = 0
    while event_index < json_len(events):
        let event = json_index(events, event_index)
        let service = json_as_text(json_get(event, "service"))
        let date = json_as_text(json_get(event, "date"))
        if services_path != "" and not map_has(allowed, service):
            set ignored_count = ignored_count + 1
        else:
            var by_date: Map[Text, Json] = {}
            if map_has(grouped, service):
                set by_date = grouped[service]
            if map_has(by_date, date):
                let old = by_date[date]
                let at = json_as_text(json_get(event, "at"))
                let epoch_us = json_as_int(json_get(event, "epoch_us"))
                let old_first_epoch = json_as_int(json_get(old, "first_epoch_us"))
                let old_last_epoch = json_as_int(json_get(old, "last_epoch_us"))
                var updated = old
                if epoch_us < old_first_epoch:
                    set updated = json_set(updated, "oldest", json_text(at))
                    set updated = json_set(updated, "first_epoch_us", json_int(epoch_us))
                if epoch_us > old_last_epoch:
                    set updated = json_set(updated, "newest", json_text(at))
                    set updated = json_set(updated, "last_epoch_us", json_int(epoch_us))
                set updated = json_set(updated, "count", json_int(json_as_int(json_get(old, "count")) + 1))
                set by_date = map_set(by_date, date, updated)
            else:
                var group = json_object()
                set group = json_set(group, "service", json_text(service))
                set group = json_set(group, "date", json_text(date))
                set group = json_set(group, "count", json_int(1))
                set group = json_set(group, "oldest", json_get(event, "at"))
                set group = json_set(group, "newest", json_get(event, "at"))
                set group = json_set(group, "first_epoch_us", json_get(event, "epoch_us"))
                set group = json_set(group, "last_epoch_us", json_get(event, "epoch_us"))
                set by_date = map_set(by_date, date, group)
            set grouped = map_set(grouped, service, by_date)
        set event_index = event_index + 1

    var groups = json_array()
    for service in grouped:
        let by_date = grouped[service]
        for date in by_date:
            let internal = by_date[date]
            var public_group = json_object()
            set public_group = json_set(public_group, "service", json_text(service))
            set public_group = json_set(public_group, "date", json_text(date))
            set public_group = json_set(public_group, "count", json_get(internal, "count"))
            set public_group = json_set(public_group, "oldest", json_get(internal, "oldest"))
            set public_group = json_set(public_group, "newest", json_get(internal, "newest"))
            set groups = json_push(groups, public_group)

    var report = json_object()
    set report = json_set(report, "groups", groups)
    set report = json_set(report, "invalid", invalid)
    set report = json_set(report, "ignored_count", json_int(ignored_count))
    let written = write_text_atomic(output_path, json_stringify(report) + "\n")
    if not is_ok(written):
        eprint("cannot write report")
        return 1
    return 0
