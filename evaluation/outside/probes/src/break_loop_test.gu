import "break_loop.gu"

fn main() -> Int:
    return 0

fn test_while_true_exits_with_break() -> Unit:
    assert(count_past(2) == 3)
    assert(count_past(0) == 1)

fn test_break_in_a_for_loop_stops_at_the_first_match() -> Unit:
    assert(first_negative([4, 5, -6, -7]) == -6)
    assert(first_negative([1, 2]) == 0)
