import "higher_order.gu"

fn main() -> Int:
    return 0

fn test_apply_twice_with_a_named_function() -> Unit:
    assert(apply_twice(double, 3) == 12)
    assert(apply_twice(add_one, 3) == 5)

fn test_a_function_value_can_be_stored_and_passed_on() -> Unit:
    let f = double
    assert(apply_twice(f, 1) == 4)
    let chosen = choose(false, add_one, double)
    assert(chosen(5) == 10)

fn test_a_retry_wrapper_takes_a_function_that_returns_a_result() -> Unit:
    assert(unwrap(retry(succeeds_on_third, 5)) == 2)
    assert(is_ok(retry(succeeds_on_third, 1)) == false)
