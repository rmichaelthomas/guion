# Evaluator probe: a user-defined higher-order function (the outside program's `p_map.gu`
# and `p_reduce.gu` had no way to take a function at all).

pub fn apply_twice(f: fn (Int) -> Int, x: Int) -> Int:
    return f(f(x))

pub fn choose(first: Bool, f: fn (Int) -> Int, g: fn (Int) -> Int) -> fn (Int) -> Int:
    if first:
        return f
    return g

pub fn retry(attempt: fn (Int) -> Result[Int, Text], limit: Int) -> Result[Int, Text]:
    var tries = 0
    var last: Result[Int, Text] = attempt(0)
    while tries < limit:
        let outcome = attempt(tries)
        if is_ok(outcome):
            return outcome
        set last = outcome
        set tries = tries + 1
    return last

pub fn double(x: Int) -> Int:
    return x * 2

pub fn add_one(x: Int) -> Int:
    return x + 1

pub fn succeeds_on_third(attempt: Int) -> Result[Int, Text]:
    if attempt >= 2:
        return Ok(attempt)
    return Err("not yet")

fn main() -> Int:
    print(apply_twice(double, 3))
    return 0
