fn main() -> Int:
    let response = unwrap(http_request_with_timeout("GET", "__URL__", {}, "", 1000))
    assert(json_as_int(json_get(response, "status")) == 200)
    let body = json_as_text(json_get(response, "body"))
    let parsed = unwrap(json_parse(body))
    assert(json_as_int(json_get(parsed, "count")) == 42)
    let payload = json_as_text(json_get(parsed, "payload"))
    assert(len(payload) == __PAYLOAD_LENGTH__)
    print(json_as_text(json_get(parsed, "message")))
    print(json_as_int(json_get(parsed, "count")))
    print(len(payload))
    return 0
