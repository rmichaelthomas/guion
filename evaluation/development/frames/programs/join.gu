import "pkg:frames/src/lib.gu"

fn main() -> Unit:
    let frame = unwrap(frame_read_csv("data/rows.csv"))
    let lookup = unwrap(frame_read_csv("data/lookup.csv"))
    let joined = unwrap(frame_join(frame, lookup, ["group"], "inner"))
    print(frame_rows(joined))
    print(column_sum(unwrap(frame_column(joined, "weight"))))
