extern python "config_support:inspect_and_migrate" fn inspect_and_migrate(source: Text, operation: Text) -> Json

fn main() -> Int:
    let arguments = args()
    var operation = ""
    var path = ""
    var i = 0
    while i < len(arguments):
        if arguments[i] == "check" or arguments[i] == "migrate":
            set operation = arguments[i]
            set i = i + 1
        else:
            if arguments[i] == "--file" and i + 1 < len(arguments):
                set path = arguments[i + 1]
                set i = i + 2
            else:
                eprint("unknown or incomplete argument")
                return 2
    if operation == "" or path == "":
        eprint("usage: config-migrator check|migrate --file PATH")
        return 2

    let source = read_text(path)
    if not is_ok(source):
        eprint("cannot read configuration")
        return 1
    let outcome = inspect_and_migrate(unwrap(source), operation)
    if not json_as_bool(json_get(outcome, "ok")):
        eprint(json_as_text(json_get(outcome, "error")))
        return 1
    if operation == "migrate":
        let updated = json_as_text(json_get(outcome, "updated"))
        let written = write_text_atomic(path, updated)
        if not is_ok(written):
            eprint("cannot atomically update configuration")
            return 1
    return 0
