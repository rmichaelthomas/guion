pub fn show_tasks(tasks: Json) -> Unit:
    let count = json_len(tasks)
    var index = 0
    if count == 0:
        print("No tasks.")
    while index < count:
        let task = json_index(tasks, index)
        let title = json_as_text(json_get(task, "title"))
        let note = json_as_text(json_get(task, "note"))
        if json_as_bool(json_get(task, "done")):
            print("[x] " + title + " — " + note)
        else:
            print("[ ] " + title + " — " + note)
        set index = index + 1

pub fn show_summary(tasks: Json) -> Unit:
    let count = json_len(tasks)
    var index = 0
    var done_count = 0
    while index < count:
        let task = json_index(tasks, index)
        if json_as_bool(json_get(task, "done")):
            set done_count = done_count + 1
        set index = index + 1
    print("Total tasks:")
    print(count)
    print("Completed tasks:")
    print(done_count)
    print("Open tasks:")
    print(count - done_count)
