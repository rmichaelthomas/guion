record EventSummary:
    count: Int
    oldest: Int
    newest: Int

fn main() -> Int:
    let iterations = 120000
    let keys: List[Text] = ["service-0/date-0", "service-0/date-1", "service-0/date-2", "service-0/date-3", "service-0/date-4", "service-1/date-0", "service-1/date-1", "service-1/date-2", "service-1/date-3", "service-1/date-4", "service-2/date-0", "service-2/date-1", "service-2/date-2", "service-2/date-3", "service-2/date-4", "service-3/date-0", "service-3/date-1", "service-3/date-2", "service-3/date-3", "service-3/date-4"]
    var groups: Map[Text, EventSummary] = {}
    for key in keys:
        set groups = map_set(groups, key, EventSummary(0, -1, 0))
    var index = 0
    while index < iterations:
        let key = keys[index % 20]
        let timestamp = index + 1
        let previous = groups[key]
        var oldest = previous.oldest
        if oldest < 0 or timestamp < oldest:
            set oldest = timestamp
        var newest = previous.newest
        if timestamp > newest:
            set newest = timestamp
        let updated = EventSummary(previous.count + 1, oldest, newest)
        set groups = map_set(groups, key, updated)
        set index = index + 1
    for key in groups:
        let summary = groups[key]
        print(key)
        print(summary.count)
        print(summary.oldest)
        print(summary.newest)
    return 0
