import "std:json"

fn main() -> Int:
    let iterations = 120000
    let keys: List[Text] = ["service-0/date-0", "service-0/date-1", "service-0/date-2", "service-0/date-3", "service-0/date-4", "service-1/date-0", "service-1/date-1", "service-1/date-2", "service-1/date-3", "service-1/date-4", "service-2/date-0", "service-2/date-1", "service-2/date-2", "service-2/date-3", "service-2/date-4", "service-3/date-0", "service-3/date-1", "service-3/date-2", "service-3/date-3", "service-3/date-4"]
    var groups: Map[Text, Json] = {}
    for key in keys:
        var initial = json_object()
        set initial = json_set(initial, "count", json_int(0))
        set initial = json_set(initial, "oldest", json_int(2147483647))
        set initial = json_set(initial, "newest", json_int(0))
        set groups = map_set(groups, key, initial)
    var index = 0
    while index < iterations:
        let key = keys[index % 20]
        let timestamp = index + 1
        let previous = groups[key]
        let count = json_as_int(json_get(previous, "count"))
        var oldest = json_as_int(json_get(previous, "oldest"))
        if timestamp < oldest:
            set oldest = timestamp
        var newest = json_as_int(json_get(previous, "newest"))
        if timestamp > newest:
            set newest = timestamp
        var updated = json_set(previous, "count", json_int(count + 1))
        set updated = json_set(updated, "oldest", json_int(oldest))
        set updated = json_set(updated, "newest", json_int(newest))
        set groups = map_set(groups, key, updated)
        set index = index + 1
    for key in groups:
        let summary = groups[key]
        print(key)
        print(json_as_int(json_get(summary, "count")))
        print(json_as_int(json_get(summary, "oldest")))
        print(json_as_int(json_get(summary, "newest")))
    return 0
