import "std:fs"
import "std:json"
import "std:jsonl"
import "std:text"
import "std:time"
import "std:unicode"

record EventSummary:
    count: Int
    oldest_us: Int
    newest_us: Int

fn main() -> Int:
    let arguments = args()
    var events_path = ""
    var output_path = ""
    var services_path = ""
    var strict = false
    var index = 0
    while index < len(arguments):
        if arguments[index] == "--events" and index + 1 < len(arguments):
            set events_path = arguments[index + 1]
            set index = index + 2
        else:
            if arguments[index] == "--output" and index + 1 < len(arguments):
                set output_path = arguments[index + 1]
                set index = index + 2
            else:
                if arguments[index] == "--services" and index + 1 < len(arguments):
                    set services_path = arguments[index + 1]
                    set index = index + 2
                else:
                    if arguments[index] == "--strict":
                        set strict = true
                        set index = index + 1
                    else:
                        eprint("unknown or incomplete argument")
                        return 2
    if events_path == "" or output_path == "":
        eprint("usage: jsonl-summary --events PATH --output PATH [--strict] [--services PATH]")
        return 2

    var allowed: Map[Text, Bool] = {}
    if services_path != "":
        let services_result = fs_open_lines(services_path)
        if not is_ok(services_result):
            eprint("cannot read services allow-list")
            return 1
        let services_reader = unwrap(services_result)
        var services_done = false
        while not services_done:
            let line_result = fs_next_line(services_reader)
            if not is_ok(line_result):
                eprint("cannot read services allow-list")
                return 1
            let maybe_service = unwrap(line_result)
            if not is_some(maybe_service):
                set services_done = true
            else:
                let line = unwrap(maybe_service).text
                let characters = text_chars(line)
                var service = ""
                var character_index = 0
                while character_index < len(characters):
                    if not (character_index == len(characters) - 1 and characters[character_index] == "\r"):
                        set service = service + characters[character_index]
                    set character_index = character_index + 1
                set allowed = map_set(allowed, service, true)
        let closed_services = fs_close_reader(services_reader)

    let reader_result = jsonl_open(events_path)
    if not is_ok(reader_result):
        eprint("cannot read events JSONL")
        return 1
    let reader = unwrap(reader_result)
    var groups: Map[Text, Map[Text, EventSummary]] = {}
    var invalid = json_array()
    var ignored_count = 0
    var invalid_count = 0
    var done = false
    while not done:
        let next_result = jsonl_next(reader)
        if not is_ok(next_result):
            eprint("cannot read events JSONL")
            return 1
        let maybe_line = unwrap(next_result)
        if not is_some(maybe_line):
            set done = true
        else:
            let line = unwrap(maybe_line)
            if unicode_collapse_whitespace(line.raw) != "":
                var valid = true
                var service = ""
                var instant: Instant = Instant(0)
                if not is_some(line.value):
                    set valid = false
                else:
                    let record = unwrap(line.value)
                    let service_result = json_get_safe(record, "service")
                    let at_result = json_get_safe(record, "at")
                    if not is_ok(service_result) or not is_ok(at_result):
                        set valid = false
                    else:
                        let service_text = json_text_safe(unwrap(service_result))
                        let at_text = json_text_safe(unwrap(at_result))
                        if not is_ok(service_text) or not is_ok(at_text) or unwrap(service_text) == "":
                            set valid = false
                        else:
                            set service = unwrap(service_text)
                            let parsed_time = parse_timestamp(unwrap(at_text))
                            if not is_ok(parsed_time):
                                set valid = false
                            else:
                                set instant = unwrap(parsed_time)
                if not valid:
                    var invalid_row = json_object()
                    set invalid_row = json_set(invalid_row, "line", json_int(line.number))
                    set invalid = json_push(invalid, invalid_row)
                    set invalid_count = invalid_count + 1
                else:
                    if services_path != "" and not map_has(allowed, service):
                        set ignored_count = ignored_count + 1
                    else:
                        let at = format_utc(instant)
                        let date = text_slice(at, 0, 10)
                        if map_has(groups, service) and map_has(groups[service], date):
                            let count = map_record_get(groups, service, date, "count")
                            var oldest_us = map_record_get(groups, service, date, "oldest_us")
                            if instant.unix_microseconds < oldest_us:
                                set oldest_us = instant.unix_microseconds
                            var newest_us = map_record_get(groups, service, date, "newest_us")
                            if instant.unix_microseconds > newest_us:
                                set newest_us = instant.unix_microseconds
                            set groups = map_record_set(groups, service, date, "count", count + 1)
                            set groups = map_record_set(groups, service, date, "oldest_us", oldest_us)
                            set groups = map_record_set(groups, service, date, "newest_us", newest_us)
                        else:
                            var by_date: Map[Text, EventSummary] = {}
                            if map_has(groups, service):
                                set by_date = groups[service]
                            let initial = EventSummary(1, instant.unix_microseconds, instant.unix_microseconds)
                            set by_date = map_set(by_date, date, initial)
                            set groups = map_set(groups, service, by_date)
    let closed_events = jsonl_close(reader)
    if strict and invalid_count > 0:
        eprint("invalid JSONL event at physical line " + json_stringify(json_get(json_index(invalid, 0), "line")))
        return 1

    var output_groups = json_array()
    for service in groups:
        let by_date = groups[service]
        for date in by_date:
            let internal = by_date[date]
            var group = json_object()
            set group = json_set(group, "service", json_text(service))
            set group = json_set(group, "date", json_text(date))
            set group = json_set(group, "count", json_int(internal.count))
            set group = json_set(group, "oldest", json_text(format_utc(Instant(internal.oldest_us))))
            set group = json_set(group, "newest", json_text(format_utc(Instant(internal.newest_us))))
            set output_groups = json_push(output_groups, group)
    var report = json_object()
    set report = json_set(report, "groups", output_groups)
    set report = json_set(report, "invalid", invalid)
    set report = json_set(report, "ignored_count", json_int(ignored_count))
    let written = write_text_atomic(output_path, json_stringify(report) + "\n")
    if not is_ok(written):
        eprint("cannot write JSONL summary")
        return 1
    return 0
