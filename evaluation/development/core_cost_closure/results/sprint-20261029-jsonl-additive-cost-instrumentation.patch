+struct CostLedgerTimer {
+    started: Instant,
+    vm_nanoseconds: Cell<u64>,
+    frame_start_nanoseconds: Cell<u64>,
+    host_nanoseconds: Cell<u64>,
+    vm_segments: Cell<u64>,
+    frame_starts: Cell<u64>,
+    host_calls: Cell<u64>,
+}
+
+impl CostLedgerTimer {
+    fn new() -> Self {
+        Self {
+            started: Instant::now(),
+            vm_nanoseconds: Cell::new(0),
+            frame_start_nanoseconds: Cell::new(0),
+            host_nanoseconds: Cell::new(0),
+            vm_segments: Cell::new(0),
+            frame_starts: Cell::new(0),
+            host_calls: Cell::new(0),
+        }
+    }
+
+    fn add_vm(&self, elapsed: std::time::Duration) {
+        self.vm_nanoseconds.set(self.vm_nanoseconds.get().saturating_add(elapsed.as_nanos() as u64));
+        self.vm_segments.set(self.vm_segments.get() + 1);
+    }
+
+    fn add_frame_start(&self, elapsed: std::time::Duration) {
+        self.frame_start_nanoseconds.set(self.frame_start_nanoseconds.get().saturating_add(elapsed.as_nanos() as u64));
+        self.frame_starts.set(self.frame_starts.get() + 1);
+    }
+
+    fn add_host(&self, elapsed: std::time::Duration) {
+        self.host_nanoseconds.set(self.host_nanoseconds.get().saturating_add(elapsed.as_nanos() as u64));
+        self.host_calls.set(self.host_calls.get() + 1);
+    }
+}
+
+impl Drop for CostLedgerTimer {
+    fn drop(&mut self) {
+        let run = self.started.elapsed().as_nanos() as u64;
+        let vm = self.vm_nanoseconds.get();
+        let frame_start = self.frame_start_nanoseconds.get();
+        let host = self.host_nanoseconds.get();
+        eprintln!(
+            "GUION_COST_LEDGER {{\"run_ns\":{run},\"vm_segment_ns\":{vm},\"frame_start_ns\":{frame_start},\"host_ns\":{host},\"vm_guest_ns\":{},\"driver_ns\":{},\"vm_segments\":{},\"frame_starts\":{},\"host_calls\":{}}}",
+            vm.saturating_sub(host),
+            run.saturating_sub(vm).saturating_sub(frame_start),
+            self.vm_segments.get(),
+            self.frame_starts.get(),
+            self.host_calls.get(),
+        );
+    }
+}
