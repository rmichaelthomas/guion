import "std:types"
import "std:text"

# Multiformats for beacons: lower-case base32 without padding (multibase "b"), unsigned varints,
# and CIDv1 text. CURBy and Twine name records by CIDv1 (codec 0x71 DAG-CBOR, multihash 0x14
# SHA3-512), so these are the pieces to build and take apart those names.
#
# base32_lower_encode / base32_lower_decode use RFC 4648's alphabet in lower case with no "="
# padding. Decoding refuses upper case, characters outside the alphabet, a length no byte string
# can have (1, 3 or 6 mod 8) and non-zero leftover bits in the last character, so each byte string
# has exactly one spelling. Failures are E_BASE32.
#
# varint_encode writes a non-negative Int as an unsigned LEB128 varint.
#
# cid_v1(codec, multihash_code, digest) gives the multibase text "b" + base32(version, codec,
# multihash code, digest length, digest). cid_parse reads that text back into CidParts; it accepts
# only CIDv1 with multibase "b", a canonical varint for each field, and a digest whose length
# matches the length field exactly. Failures are E_CID.

pub record CidParts:
    version: Int
    codec: Int
    hash_code: Int
    digest: Bytes

record VarintRead:
    value: Int
    next: Int

fn alphabet() -> Text:
    return "abcdefghijklmnopqrstuvwxyz234567"

pub fn base32_lower_encode(data: Bytes) -> Text:
    let octets = bytes_to_ints(data)
    let table = alphabet()
    var out = ""
    var acc = 0
    var bits = 0
    var index = 0
    while index < len(octets):
        set acc = int_or(int_shift_left(acc, 8), octets[index])
        set bits = bits + 8
        set index = index + 1
        while bits >= 5:
            set bits = bits - 5
            set out = out + table[int_and(int_shift_right(acc, bits), 31)]
        set acc = int_and(acc, int_shift_left(1, bits) - 1)
    if bits > 0:
        set out = out + table[int_and(int_shift_left(acc, 5 - bits), 31)]
    return out

fn base32_error(message: Text) -> StdError:
    return std_error("E_BASE32", message)

pub fn base32_lower_decode(text: Text) -> Result[Bytes, StdError]:
    let table = alphabet()
    let size = len(text)
    let leftover = size % 8
    if leftover == 1 or leftover == 3 or leftover == 6:
        return Err(base32_error("base32 text has a length no byte string encodes to"))
    var octets: List[Int] = []
    var acc = 0
    var bits = 0
    var index = 0
    while index < size:
        let value = text_find(table, text[index], 0)
        if value < 0:
            return Err(base32_error(f"base32 text has a character outside a-z2-7 at position {index}"))
        set acc = int_or(int_shift_left(acc, 5), value)
        set bits = bits + 5
        set index = index + 1
        if bits >= 8:
            set bits = bits - 8
            set octets = list_push(octets, int_and(int_shift_right(acc, bits), 255))
            set acc = int_and(acc, int_shift_left(1, bits) - 1)
    if acc != 0:
        return Err(base32_error("base32 text has non-zero bits after its last byte"))
    return Ok(bytes_from_ints(octets))

pub fn varint_encode(value: Int) -> Bytes:
    var octets: List[Int] = []
    var rest = value
    while rest >= 128:
        set octets = list_push(octets, int_or(int_and(rest, 127), 128))
        set rest = int_shift_right(rest, 7)
    set octets = list_push(octets, rest)
    return bytes_from_ints(octets)

fn cid_error(message: Text) -> StdError:
    return std_error("E_CID", message)

pub fn cid_v1(codec: Int, multihash_code: Int, digest: Bytes) -> Text:
    let header = bytes_join([varint_encode(1), varint_encode(codec), varint_encode(multihash_code), varint_encode(len(digest))])
    return "b" + base32_lower_encode(bytes_join([header, digest]))

# Reads one varint from `octets` at `start`. It must end inside the list and must be the shortest
# spelling of its value (no trailing zero group).
fn varint_read(octets: List[Int], start: Int) -> Result[VarintRead, StdError]:
    var value = 0
    var shift = 0
    var index = start
    while index < len(octets) and index < start + 9:
        let octet = octets[index]
        set value = int_or(value, int_shift_left(int_and(octet, 127), shift))
        set index = index + 1
        if octet < 128:
            if octet == 0 and index - start > 1:
                return Err(cid_error("CID has a varint that is not in its shortest form"))
            return Ok(VarintRead(value, index))
        set shift = shift + 7
    return Err(cid_error("CID has a varint that does not end"))

pub fn cid_parse(text: Text) -> Result[CidParts, StdError]:
    if len(text) < 2 or text[0] != "b":
        return Err(cid_error("CID text must start with the multibase prefix b"))
    var decoded = bytes_from_ints([])
    match base32_lower_decode(text_slice(text, 1, len(text))):
        Ok(data):
            set decoded = data
        Err(problem):
            return Err(cid_error("CID text is not base32: " + problem.message))
    let octets = bytes_to_ints(decoded)
    let version = varint_read(octets, 0)?
    if version.value != 1:
        return Err(cid_error(f"only CIDv1 is supported, this is version {version.value}"))
    let codec = varint_read(octets, version.next)?
    let hash_code = varint_read(octets, codec.next)?
    let size = varint_read(octets, hash_code.next)?
    if len(decoded) - size.next != size.value:
        return Err(cid_error("CID digest length does not match its length field"))
    return Ok(CidParts(1, codec.value, hash_code.value, bytes_slice(decoded, size.next, len(decoded))))
