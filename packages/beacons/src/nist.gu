# The certificateId of the certificate "DigiCert SHA2 Secure Server CA" signed: valid 2020-06-10 to 2021-06-11.
pub fn nist_chain1_secure_server_certificate_ids() -> List[Text]:
    return ["a2898303d179a120f622e7df9da92bff3f41cecb9f174aedf0b9915728823e7cb180464cb3019f5ce9386c116ed26e53a39df17f0ca88f04e36d8c7470ecc3a4"]

# NIST kept signing with its first chain 1 certificate after it expired (notAfter 2019-01-11T12:00Z): the
# beacon stopped from 2018-12-26 to 2019-01-28 (pulses 220394 and 220395), then ran under the same certificate
# until pulse 502024 (2019-08-16T14:11:00Z); pulse 502025 names the next one. These pulses are genuine and their
# signatures verify, so for this one id the validity window is extended to that last pulse (unix seconds), and
# no further. Every other id keeps the certificate's own notAfter. 0 means no extension.
# nist_validity_end gives the last unix second a pulse under the id may carry.
pub fn nist_validity_extension(certificate_id: Text) -> Int:
    if certificate_id == "5501e3d72bc42f3b96e16de4dcadcb16768e109662bd16d667d5fd9aee585af31bbdc5dd4f53592276064b53dddd76c8f3604b2a41db6e09f78f82bb5d6569e7":
        return 1565964660
    return 0

# True when the certificate (PEM) was signed by the key of the issuer certificate (PEM) and names it
# as its issuer. One link only: no validity dates, no CA flag, no revocation. Err for text that is
# not a certificate (E_CRYPTO_INPUT, E_X509) or a signature algorithm outside RSA PKCS#1 v1.5 / PSS
# and ECDSA P-256 / P-384 with SHA-256, SHA-384 or SHA-512 (E_X509_ALG).
pub fn nist_verify_certificate(certificate_pem: Text, issuer_pem: Text) -> Result[Bool, StdError]:
    let certificate = crypto_pem_decode(certificate_pem)?
    let issuer = crypto_pem_decode(issuer_pem)?
    return crypto_x509_verify_issued_by(certificate, issuer)

# The host name NIST's beacon certificate is for (its SubjectAltName), read from the live
# certificate. nist_verify requires the certificate to name it.
pub fn nist_beacon_host() -> Text:
    return "engine.beacon.nist.gov"

# The certificateId values (SHA-512 of the certificate's DER, lower-case hex) of the NIST beacon
# certificates this package trusts: the ones for engine.beacon.nist.gov that the pinned issuer
# signed. The same list is saved, with their validity dates, as fixtures/nist-certificate-ids.txt and a
# test keeps the two equal; README.md says how to refresh it when NIST rotates its certificate.
pub fn nist_known_certificate_ids() -> List[Text]:
    return ["aa1e1ed43ed72a4a8e8535687074690c593adc683c122dbed16842acbfd697020ddb1c382bf06893b11836da1fc9df982ec34e4d9dc3c105a816950948a25005", "e692b0f6b208322ac84c963e167245f6356c21f31fa95274b25e92329510b5a210d5179afb6ee25e12dd9fc2691f49ed778d9a709aa3c2ea0f3ff2eaf8c47a62", "528943a555f5f8ca54423be6dfb95925a35c7b552046420e7d7cd072058a14d6536ad3a8e9754b6582f164a90b0cd86a65d659f5426a2659a947595d1c816c8c", "87f27f431da3f584af6007fe045df13aaa81d831f335b6ee73f6334768f32d3ae10491e669b93a43e548b20370a6526c3def99643c25d8ad7bf5df95a3c2b45d", "5b6386e6ac8a993bac8d99d6549deda44af82f2fa4a0e9c0025b6474ab0cbfcab67bfff264fda41aac003b0c9ee7fb77d2938dc0f286fb73cc8fa79864ec0c18"]

fn list_has(items: List[Text], wanted: Text) -> Bool:
    var index = 0
    while index < len(items):
        if items[index] == wanted:
            return true
        set index = index + 1
    return false

# `digits` characters of `text` from `start` as a number, or -1 when one is not a digit.
fn digits_at(text: Text, start: Int, count: Int) -> Int:
    var value = 0
    var index = 0
    while index < count:
        let found = text_find("0123456789", text_slice(text, start + index, start + index + 1), 0)
        if found < 0:
            return -1
        set value = value * 10 + found
        set index = index + 1
    return value

# True when the `count` characters of `text` from `start` are all digits. Nothing is accumulated, so a
# fraction of any length (a caller-supplied timeStamp) cannot reach the integer digit limit.
fn all_digits(text: Text, start: Int, count: Int) -> Bool:
    var index = 0
    while index < count:
        if text_find("0123456789", text_slice(text, start + index, start + index + 1), 0) < 0:
            return false
        set index = index + 1
    return true

fn is_leap_year(year: Int) -> Bool:
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

# Days in a month of a Gregorian year; month must be 1 to 12.
fn days_in_month(year: Int, month: Int) -> Int:
    if month == 2:
        if is_leap_year(year):
            return 29
        return 28
    if month == 4 or month == 6 or month == 9 or month == 11:
        return 30
    return 31

# Days from 1970-01-01 to a civil date (proleptic Gregorian, year 1970 or later).
fn days_from_civil(year: Int, month: Int, day: Int) -> Int:
    var shifted = year
    if month <= 2:
        set shifted = year - 1
    let era = shifted // 400
    let year_of_era = shifted - era * 400
    var month_index = month - 3
    if month <= 2:
        set month_index = month + 9
    let day_of_year = (153 * month_index + 2) // 5 + day - 1
    let day_of_era = year_of_era * 365 + year_of_era // 4 - year_of_era // 100 + day_of_year
    return era * 146097 + day_of_era - 719468

# A pulse's timeStamp ("2026-11-22T08:23:00.000Z": ISO 8601 UTC, optional fraction) as unix
# seconds, fraction dropped. E_NIST_FORMAT for anything else.
fn pulse_seconds(stamp: Text) -> Result[Int, StdError]:
    let size = len(stamp)
    let bad = nist_error("E_NIST_FORMAT", "the pulse's timeStamp is not an ISO 8601 UTC time")
    if size < 20 or text_slice(stamp, size - 1, size) != "Z":
        return Err(bad)
    if text_slice(stamp, 4, 5) != "-" or text_slice(stamp, 7, 8) != "-" or text_slice(stamp, 10, 11) != "T":
        return Err(bad)
    if text_slice(stamp, 13, 14) != ":" or text_slice(stamp, 16, 17) != ":":
        return Err(bad)
    if size > 20:
        if text_slice(stamp, 19, 20) != "." or size < 22:
            return Err(bad)
        if not all_digits(stamp, 20, size - 21):
            return Err(bad)
    let year = digits_at(stamp, 0, 4)
    let month = digits_at(stamp, 5, 2)
    let day = digits_at(stamp, 8, 2)
    let hour = digits_at(stamp, 11, 2)
    let minute = digits_at(stamp, 14, 2)
    let second = digits_at(stamp, 17, 2)
    if year < 1970 or month < 1 or month > 12 or day < 1 or day > days_in_month(year, month) or hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59:
        return Err(bad)
    return Ok(days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second)

fn numbers_fit(pulse: NistPulse) -> Bool:
    return fits(pulse.cipher_suite, 4) and fits(pulse.period, 4) and fits(pulse.external_status_code, 4) and fits(pulse.status_code, 4) and fits(pulse.chain_index, 8) and fits(pulse.pulse_index, 8)

# nist_verify with the pins named instead of the package's own: `issuer_pem` is the issuer the
# certificate must come from, `host` the name it must carry, `known_ids` the certificateId values
# (lower-case hex) the pulse may name. Every check of nist_verify applies; Ok(true) needs all of them:
#  1. certificateId is SHA-512 of the certificate's DER and is one of `known_ids`;
#  2. the certificate was issued by `issuer_pem` (one link; algorithms as nist_verify_certificate);
#  3. its SubjectAltName (its subject CN only when it has no SubjectAltName) includes `host`;
#  4. the pulse's timeStamp lies within the certificate's notBefore and notAfter;
#  5. the RSA PKCS#1 v1.5 / SHA-512 signature verifies under the certificate's key;
#  6. outputValue is the hash of the serialization and signature.
# Ok(false) when any of them fails. E_NIST_SUITE for a cipher suite other than 0, E_NIST_FORMAT for
# a number the serialization cannot hold or a timeStamp that is not an ISO 8601 UTC time. This is how
# the tests prove each check on its own with a certificate that satisfies the others.
pub fn nist_verify_pinned(pulse: NistPulse, certificate_pem: Text, issuer_pem: Text, host: Text, known_ids: List[Text]) -> Result[Bool, StdError]:
    return verify_core(pulse, certificate_pem, issuer_pem, host, known_ids, 0)

fn nist_validity_end_with(not_after: Int, extension: Int) -> Int:
    if extension > not_after:
        return extension
    return not_after

pub fn nist_validity_end(certificate_id: Text, not_after: Int) -> Int:
    return nist_validity_end_with(not_after, nist_validity_extension(certificate_id))

# nist_verify_pinned with a validity extension: a pulse made after the certificate's notAfter but no later than
# `extended_until` (unix seconds; 0 for none) still counts as within its validity. Only nist_verify's own pins use it.
fn verify_core(pulse: NistPulse, certificate_pem: Text, issuer_pem: Text, host: Text, known_ids: List[Text], extended_until: Int) -> Result[Bool, StdError]:
    if pulse.cipher_suite != 0:
        return Err(nist_error("E_NIST_SUITE", f"cipher suite {pulse.cipher_suite} is not defined; only 0 is"))
    if not numbers_fit(pulse):
        return Err(nist_error("E_NIST_FORMAT", "a pulse number is out of range"))
    let made = pulse_seconds(pulse.time_stamp)?
    let der = crypto_pem_decode(certificate_pem)?
    if crypto_sha512(der) != pulse.certificate_id:
        return Ok(false)
    if not list_has(known_ids, hex_encode(pulse.certificate_id)):
        return Ok(false)
    let issued = crypto_x509_verify_issued_by(der, crypto_pem_decode(issuer_pem)?)?
    if not issued:
        return Ok(false)
    if not list_has(crypto_x509_dns_names(der)?, host):
        return Ok(false)
    let window = crypto_x509_validity(der)?
    if made < window[0] or made > nist_validity_end_with(window[1], extended_until):
        return Ok(false)
    let key = crypto_x509_rsa_public_key(der)?
    let signed = crypto_rsa_verify(key[0], key[1], nist_signed_bytes(pulse), pulse.signature, "pkcs1v15-sha512")?
    if not signed:
        return Ok(false)
    return Ok(nist_output_value(pulse) == pulse.output_value)

# Checks a pulse against the certificate PEM it names. Ok(true) only for NIST's own: the pulse names
# a certificate this package pins (nist_known_certificate_ids, nist_legacy_certificate_ids,
# nist_chain1_global_ca_g2_certificate_ids or nist_chain1_secure_server_certificate_ids), and the certificate
# was issued by the one issuer paired with that list (nist_pinned_issuer_pem, nist_legacy_issuer_pem,
# nist_chain1_global_ca_g2_issuer_pem or nist_chain1_secure_server_issuer_pem), never by another list's. It
# names nist_beacon_host, the pulse's timeStamp lies within its validity (its notAfter, or for chain 1's first
# certificate nist_validity_end, see nist_validity_extension), the RSA PKCS#1 v1.5 / SHA-512 signature
# verifies under its key, and outputValue is the hash of the serialization and signature. Ok(false) on any
# mismatch, including a certificate the paired issuer did not sign, one issued to another name, one that had
# expired or not begun, or one NIST is not known to use.
pub fn nist_verify(pulse: NistPulse, certificate_pem: Text) -> Result[Bool, StdError]:
    # Each certificateId is paired with the one issuer that must have signed it: an id one list names is
    # checked against that list's issuer only, every other id against the current issuer only, so no pinned
    # issuer stands for another's certificates.
    let id = hex_encode(pulse.certificate_id)
    let extension = nist_validity_extension(id)
    if list_has(nist_legacy_certificate_ids(), id):
        return verify_core(pulse, certificate_pem, nist_legacy_issuer_pem(), nist_beacon_host(), nist_legacy_certificate_ids(), extension)
    if list_has(nist_chain1_global_ca_g2_certificate_ids(), id):
        return verify_core(pulse, certificate_pem, nist_chain1_global_ca_g2_issuer_pem(), nist_beacon_host(), nist_chain1_global_ca_g2_certificate_ids(), extension)
    if list_has(nist_chain1_secure_server_certificate_ids(), id):
        return verify_core(pulse, certificate_pem, nist_chain1_secure_server_issuer_pem(), nist_beacon_host(), nist_chain1_secure_server_certificate_ids(), extension)
    return verify_core(pulse, certificate_pem, nist_pinned_issuer_pem(), nist_beacon_host(), nist_known_certificate_ids(), extension)

# True when `current` is the pulse right after `previous` in the same chain, names it as its
# previous, and previous's precommitmentValue is SHA-512 of current's localRandomValue. It does
# not check either pulse's signature (nist_verify does).
pub fn nist_verify_precommitment(previous: NistPulse, current: NistPulse) -> Result[Bool, StdError]:
    if previous.chain_index != current.chain_index or previous.pulse_index + 1 != current.pulse_index:
        return Ok(false)
    if previous.output_value != current.previous:
        return Ok(false)
    return Ok(previous.precommitment_value == crypto_sha512(current.local_random_value))

fn fetch_pulse(url: Text) -> Result[NistPulse, StdError]:
    match http_get(url):
        Err(failure):
            return Err(nist_error("E_NIST_FETCH", f"{url}: {http_error_message(failure)}"))
        Ok(body):
            match json_parse(body):
                Err(problem):
                    return Err(nist_error("E_NIST_FETCH", f"{url} answered with text that is not JSON"))
                Ok(value):
                    return nist_pulse_from_json(value)

# The newest pulse. Fetches only; check it with nist_verify.
pub fn nist_fetch_last() -> Result[NistPulse, StdError]:
    return fetch_pulse("https://beacon.nist.gov/beacon/2.0/pulse/last")

# A pulse by chain and index (the live chain is 2; chain 1, 2018 to 2022, verifies too). Fetches only.
pub fn nist_fetch(chain: Int, pulse: Int) -> Result[NistPulse, StdError]:
    return fetch_pulse(f"https://beacon.nist.gov/beacon/2.0/chain/{chain}/pulse/{pulse}")

# The PEM certificate a pulse names (certificateId). Fetches only; nist_verify checks that its hash
# matches.
pub fn nist_fetch_certificate(pulse: NistPulse) -> Result[Text, StdError]:
    let url = f"https://beacon.nist.gov/beacon/2.0/certificate/{hex_encode(pulse.certificate_id)}"
    match http_get(url):
        Err(failure):
            return Err(nist_error("E_NIST_FETCH", f"{url}: {http_error_message(failure)}"))
        Ok(body):
            return Ok(body)
