import "std:types"
import "std:crypto"
import "std:encoding"
import "std:json"
import "std:text"
import "twine.gu"

# The NIST Randomness Beacon, version 2.0 (https://beacon.nist.gov/beacon/2.0, NISTIR 8213), cipher
# suite 0: SHA-512 and RSA PKCS#1 v1.5 with SHA-512.
#
# A pulse is signed over its fields 1 to 19 in this order, each serialized as below, and signed with
# RSA PKCS#1 v1.5 / SHA-512 (the message is the serialization; SHA-512 happens inside the scheme):
#   uri, version, timeStamp, and every hex field (certificateId, localRandomValue, external.sourceId,
#   external.value, previous, hour, day, month, year, precommitmentValue):
#       a 4-byte big-endian length, then the bytes (UTF-8 text, or the hex decoded)
#   cipherSuite, period, external.statusCode, statusCode: 4 bytes big-endian
#   chainIndex, pulseIndex: 8 bytes big-endian
# in the order uri, version, cipherSuite, period, certificateId, chainIndex, pulseIndex, timeStamp,
# localRandomValue, external.sourceId, external.statusCode, external.value, previous, hour, day,
# month, year, precommitmentValue, statusCode. outputValue is SHA-512 of that same serialization
# followed by the raw signature bytes (no length prefix). certificateId is SHA-512 of the signing
# certificate's DER. A pulse n commits to the next with precommitmentValue[n] ==
# SHA-512(localRandomValue[n+1]), and pulse n+1's previous is pulse n's outputValue.
# NISTIR 8213 (draft) writes the length prefixes as 8 bytes and external.statusCode as 8; the live
# service uses 4 and 4. The README records how this was found.
# Chain 1 (2018 to 2022) is serialized the same way as chain 2: checked with openssl on pulses under each of its
# four certificates, the signature and outputValue both verify under this layout.
#
# Verifiers take an already-fetched pulse (and the certificate PEM); the fetch functions only fetch.
# Needs the network grant for beacon.nist.gov for the fetch functions.
#
# Errors: E_NIST_FETCH (a request or its answer is bad), E_NIST_FORMAT (not a pulse: a member is
# missing or mistyped, a number is out of range, the timeStamp is not an ISO 8601 UTC time), E_NIST_SUITE (a
# cipher suite other than 0), plus the crypto codes (a certificate that is not an RSA certificate, or one whose issuer algorithm is not supported).
# A pulse comes from the network, so nothing here stops the program on a bad shape.
#
# What makes a pulse NIST's (nist_verify): the certificate is one of the known NIST beacon
# certificates (the pulse's certificateId is in nist_known_certificate_ids), it was issued by the pinned
# DigiCert issuer, it names engine.beacon.nist.gov, it was valid when the pulse was made, and the RSA
# signature and outputValue check. The issuer alone would accept a certificate DigiCert issued to anyone.

pub record NistPulse:
    uri: Text
    version: Text
    cipher_suite: Int
    period: Int
    certificate_id: Bytes
    chain_index: Int
    pulse_index: Int
    time_stamp: Text
    local_random_value: Bytes
    external_source_id: Bytes
    external_status_code: Int
    external_value: Bytes
    previous: Bytes
    hour: Bytes
    day: Bytes
    month: Bytes
    year: Bytes
    precommitment_value: Bytes
    status_code: Int
    signature: Bytes
    output_value: Bytes

fn nist_error(code: Text, message: Text) -> StdError:
    return std_error(code, message)

fn base() -> Text:
    return "https://beacon.nist.gov"

fn field_text(value: Json, key: Text) -> Result[Text, StdError]:
    match json_try_get(value, key):
        Err(problem):
            return Err(nist_error("E_NIST_FORMAT", f"the pulse has no {key}"))
        Ok(found):
            match json_try_text(found):
                Ok(text):
                    return Ok(text)
                Err(problem):
                    return Err(nist_error("E_NIST_FORMAT", f"{key} is not text"))

# An integer member that is serialized in `bytes` big-endian bytes (4 or 8): 0 up to what the
# serialization holds (an 8-byte value is limited to 2^63 - 1, the largest Int the bit operations take).
fn field_int(value: Json, key: Text, bytes: Int) -> Result[Int, StdError]:
    match json_try_get(value, key):
        Err(problem):
            return Err(nist_error("E_NIST_FORMAT", f"the pulse has no {key}"))
        Ok(found):
            match json_try_int(found):
                Ok(number):
                    if not fits(number, bytes):
                        return Err(nist_error("E_NIST_FORMAT", f"{key} is out of range"))
                    return Ok(number)
                Err(problem):
                    return Err(nist_error("E_NIST_FORMAT", f"{key} is not an integer"))

# Does the number serialize in `bytes` big-endian bytes? 0 to 2^32 - 1 for 4, 0 to 2^63 - 1 for 8.
fn fits(number: Int, bytes: Int) -> Bool:
    if number < 0:
        return false
    if bytes == 4:
        return number <= 4294967295
    return number <= 9223372036854775807

fn decode_hex(text: Text, what: Text) -> Result[Bytes, StdError]:
    match hex_decode(text):
        Ok(bytes):
            return Ok(bytes)
        Err(problem):
            return Err(nist_error("E_NIST_FORMAT", f"{what} is not hex"))

fn field_hex(value: Json, key: Text) -> Result[Bytes, StdError]:
    let text = field_text(value, key)?
    return decode_hex(text, key)

# The value of the listValues entry of a type ("previous", "hour", "day", "month", "year").
fn list_value(entries: Json, kind: Text) -> Result[Bytes, StdError]:
    match json_items(entries):
        None:
            return Err(nist_error("E_NIST_FORMAT", "listValues is not an array"))
        Some(items):
            var index = 0
            while index < len(items):
                match json_try_get_text(items[index], "type"):
                    Ok(found):
                        if found == kind:
                            return field_hex(items[index], "value")
                    Err(problem):
                        return Err(nist_error("E_NIST_FORMAT", "a listValues entry has no type"))
                set index = index + 1
            return Err(nist_error("E_NIST_FORMAT", f"listValues has no {kind}"))

# A pulse from the JSON the service answers with ({"pulse": {...}}); a bare pulse object also works.
pub fn nist_pulse_from_json(answer: Json) -> Result[NistPulse, StdError]:
    var value = answer
    if has_key(answer, "pulse"):
        set value = json_get(answer, "pulse")
    if not has_key(value, "pulseIndex"):
        return Err(nist_error("E_NIST_FORMAT", "not a beacon pulse"))
    let external = match_key(value, "external")?
    let entries = match_key(value, "listValues")?
    return Ok(NistPulse(field_text(value, "uri")?, field_text(value, "version")?, field_int(value, "cipherSuite", 4)?, field_int(value, "period", 4)?, field_hex(value, "certificateId")?, field_int(value, "chainIndex", 8)?, field_int(value, "pulseIndex", 8)?, field_text(value, "timeStamp")?, field_hex(value, "localRandomValue")?, field_hex(external, "sourceId")?, field_int(external, "statusCode", 4)?, field_hex(external, "value")?, list_value(entries, "previous")?, list_value(entries, "hour")?, list_value(entries, "day")?, list_value(entries, "month")?, list_value(entries, "year")?, field_hex(value, "precommitmentValue")?, field_int(value, "statusCode", 4)?, field_hex(value, "signatureValue")?, field_hex(value, "outputValue")?))
fn match_key(value: Json, key: Text) -> Result[Json, StdError]:
    match json_try_get(value, key):
        Ok(found):
            return Ok(found)
        Err(problem):
            return Err(nist_error("E_NIST_FORMAT", f"the pulse has no {key}"))

fn big_endian(value: Int, width: Int) -> Bytes:
    var octets: List[Int] = []
    var shift = 8 * (width - 1)
    while shift >= 0:
        set octets = list_push(octets, int_and(int_shift_right(value, shift), 255))
        set shift = shift - 8
    return bytes_from_ints(octets)

fn prefixed(data: Bytes) -> Bytes:
    return bytes_join([big_endian(len(data), 4), data])

fn prefixed_text(text: Text) -> Bytes:
    return prefixed(bytes_from_text(text))

# The bytes the beacon signs: fields 1 to 19, serialized as the header describes. The numbers must
# fit their fields (nist_pulse_from_json and nist_verify check that; this stops the program with
# R_INTEGER_RANGE on a pulse built by hand with one that does not).
pub fn nist_signed_bytes(pulse: NistPulse) -> Bytes:
    return bytes_join([prefixed_text(pulse.uri), prefixed_text(pulse.version), big_endian(pulse.cipher_suite, 4), big_endian(pulse.period, 4), prefixed(pulse.certificate_id), big_endian(pulse.chain_index, 8), big_endian(pulse.pulse_index, 8), prefixed_text(pulse.time_stamp), prefixed(pulse.local_random_value), prefixed(pulse.external_source_id), big_endian(pulse.external_status_code, 4), prefixed(pulse.external_value), prefixed(pulse.previous), prefixed(pulse.hour), prefixed(pulse.day), prefixed(pulse.month), prefixed(pulse.year), prefixed(pulse.precommitment_value), big_endian(pulse.status_code, 4)])
# SHA-512 of the signed bytes followed by the signature: what outputValue must equal.
pub fn nist_output_value(pulse: NistPulse) -> Bytes:
    return crypto_sha512(bytes_join([nist_signed_bytes(pulse), pulse.signature]))

