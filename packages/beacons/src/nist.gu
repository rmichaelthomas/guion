    return ["ed8e1b9745e337e38745a54579d97b21562cb703e44926666a1d6499a9e3399448cdf6b1403ec056314c129910e82b0e8af48c1e062a88828e178dfc82983c2b", "ebcfbf3cb148288266e2cde0d71de23b0a2739c30356e32de68e040b82dec384359763f72905ba16a2a474040ed5db47ee1baa0327aeae94f231ffe67276d1cb"]

# NIST's first chain (chain 1, 2018-07-23 to 2022-04-29, pulses 1 to 1801851) used four certificates in a row,
# from three DigiCert intermediates. The last one is issued by the legacy issuer above (its id is in
# nist_legacy_certificate_ids). The other three each have a pinned issuer of their own, trusted only for
# their own ids (fixtures/nist-chain1-*.pem; tests keep the PEMs and the id lists equal to the fixtures).

