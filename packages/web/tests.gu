# Tests for the web package. Run with `guion test tests.gu` from this directory. None opens a socket:
# handlers are called with Request values; the serve tests live in crates/cli/tests/web_package.rs.

import "std:text"
import "std:fs"
import "std:log"
import "std:sqlite"
import "std:crypto"
import "std:process"
import "std:encoding"
import "std:types"
import "std:url"
import "std:cookie"
import "src/lib.gu"

fn main() -> Int:
    return 0

fn text_of(response: Response) -> Text:
    return text_from_bytes_lossy(response.body.data)

fn hello(request: Request) -> Result[Response, HttpFailure]:
    return Ok(response_text(200, "hello"))

fn show_user(request: Request) -> Result[Response, HttpFailure]:
    var id = 0 - 1
    match path_param_int(request, "id"):
        Some(value):
            set id = value
        None:
            set id = 0 - 1
    return Ok(response_text(200, "user " + int_to_text(id)))

fn show_slug(request: Request) -> Result[Response, HttpFailure]:
    match path_param(request, "slug"):
        Some(value):
            return Ok(response_text(200, "slug " + value))
        None:
            return Ok(response_text(500, "no slug"))

fn fail(request: Request) -> Result[Response, HttpFailure]:
    return Err(HttpFailure(404, "DB_SECRET_CODE", "database at 10.0.0.5 refused the password"))

fn echo_trace(request: Request) -> Result[Response, HttpFailure]:
    var trace = ""
    match request_header(request, "x-trace"):
        Some(value):
            set trace = value
        None:
            set trace = "none"
    return Ok(response_text(200, trace))

fn three_cookies(request: Request) -> Result[Response, HttpFailure]:
    let first = response_add_header(response_text(200, "ok"), "Set-Cookie", "a=1")?
    let second = response_add_header(first, "Set-Cookie", "b=2")?
    return response_add_header(second, "Set-Cookie", "c=3")

fn with_trace(request: Request, mark: Text) -> Request:
    var trace = mark
    match request_header(request, "x-trace"):
        Some(value):
            set trace = value + "," + mark
        None:
            set trace = mark
    var kept: List[Header] = []
    var index = 0
    while index < len(request.headers):
        if request.headers[index].name != "x-trace":
            set kept = list_push(kept, request.headers[index])
        set index = index + 1
    set kept = list_push(kept, Header("x-trace", trace))
    return Request(request.method, request.path, request.query, kept, request.body, request.params)

fn out_trace(response: Response, mark: Text) -> Result[Response, HttpFailure]:
    var trace = mark
    match response_header(response, "x-out"):
        Some(value):
            set trace = value + "," + mark
        None:
            set trace = mark
    return response_set_header(response, "x-out", trace)

fn before_a(config: Map[Text, Text], request: Request) -> Result[Request, Response]:
    return Ok(with_trace(request, "a"))

fn before_b(config: Map[Text, Text], request: Request) -> Result[Request, Response]:
    return Ok(with_trace(request, "b"))

fn before_c(config: Map[Text, Text], request: Request) -> Result[Request, Response]:
    return Ok(with_trace(request, "c"))

fn after_a(config: Map[Text, Text], request: Request, response: Response) -> Result[Response, HttpFailure]:
    return out_trace(response, "a")

fn after_b(config: Map[Text, Text], request: Request, response: Response) -> Result[Response, HttpFailure]:
    return out_trace(response, "b")

fn after_c(config: Map[Text, Text], request: Request, response: Response) -> Result[Response, HttpFailure]:
    return out_trace(response, "c")

fn deny(config: Map[Text, Text], request: Request) -> Result[Request, Response]:
    return Err(response_text(401, "denied"))

fn after_fail(config: Map[Text, Text], request: Request, response: Response) -> Result[Response, HttpFailure]:
    return Err(HttpFailure(418, "E_AFTER", "teapot detail"))

fn get(path: Text) -> Request:
    return request_new("GET", path)

fn code_of(result: Result[Router, HttpFailure]) -> Text:
    match result:
        Ok(built):
            return "ok"
        Err(failure):
            return failure.code

fn sample_router() -> Router:
    return unwrap(router([route("GET", "/", hello), route("GET", "/users/{id:int}", show_user), route("GET", "/files/{slug}", show_slug), route("POST", "/users/{id:int}", hello)]))

fn test_a_handler_runs_without_a_socket() -> Unit:
    let response = unwrap(hello(get("/")))
    assert(response.status == 200)
    assert(text_of(response) == "hello")

fn test_router_dispatches_with_params() -> Unit:
    let table = sample_router()
    assert(text_of(unwrap(router_handle(table, get("/")))) == "hello")
    assert(text_of(unwrap(router_handle(table, get("/users/42")))) == "user 42")
    assert(text_of(unwrap(router_handle(table, get("/users/0")))) == "user 0")
    assert(text_of(unwrap(router_handle(table, get("/files/readme")))) == "slug readme")

fn test_int_param_that_is_not_an_int_is_404_not_500() -> Unit:
    let table = sample_router()
    assert(unwrap(router_handle(table, get("/users/abc"))).status == 404)
    assert(unwrap(router_handle(table, get("/users/-1"))).status == 404)
    assert(unwrap(router_handle(table, get("/users/007"))).status == 404)
    assert(unwrap(router_handle(table, get("/users/1.5"))).status == 404)
    assert(unwrap(router_handle(table, get("/users/99999999999999999999"))).status == 404)

fn test_an_encoded_slash_stays_inside_one_parameter() -> Unit:
    let table = sample_router()
    assert(text_of(unwrap(router_handle(table, get("/files/a%2Fb")))) == "slug a/b")
    assert(text_of(unwrap(router_handle(table, get("/files/a%2fb")))) == "slug a/b")
    assert(unwrap(router_handle(table, get("/files/a/b"))).status == 404)
    assert(text_of(unwrap(router_handle(table, get("/files/caf%C3%A9")))) == "slug café")
    assert(text_of(unwrap(router_handle(table, get("/files/..")))) == "slug ..")

fn test_a_bad_encoding_is_400() -> Unit:
    let table = sample_router()
    assert(unwrap(router_handle(table, get("/files/%zz"))).status == 400)
    assert(unwrap(router_handle(table, get("/files/%00"))).status == 400)
    assert(unwrap(router_handle(table, get("/files/%ff"))).status == 400)

fn test_trailing_slash_is_significant() -> Unit:
    let table = sample_router()
    assert(unwrap(router_handle(table, get("/files/x/"))).status == 404)
    assert(unwrap(router_handle(table, get("/users/1/"))).status == 404)
    assert(unwrap(router_handle(table, get("//"))).status == 404)
    assert(unwrap(router_handle(table, get("/files//x"))).status == 404)
    assert(unwrap(router_handle(table, get(""))).status == 404)
    assert(unwrap(router_handle(table, get("users/1"))).status == 404)

fn test_a_pattern_cannot_end_in_a_slash() -> Unit:
    assert(code_of(router([route("GET", "/a/", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("GET", "/a//b", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("GET", "/", hello)])) == "ok")

fn test_malformed_patterns_are_errors_at_construction() -> Unit:
    assert(code_of(router([route("GET", "a", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("GET", "/a/{id", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("GET", "/a/{id:float}", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("GET", "/a/{}", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("GET", "/a/{id}/{id:int}", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("GET", "/a/b{c}", hello)])) == "E_ROUTE_PATTERN")
    assert(code_of(router([route("get", "/a", hello)])) == "E_ROUTE_PATTERN")

fn test_two_routes_matching_one_path_are_a_registration_error() -> Unit:
    assert(code_of(router([route("GET", "/a", hello), route("GET", "/a", hello)])) == "E_ROUTE_CONFLICT")
    assert(code_of(router([route("GET", "/u/{x}", hello), route("GET", "/u/{y}", hello)])) == "E_ROUTE_CONFLICT")
    assert(code_of(router([route("GET", "/u/{x}", hello), route("GET", "/u/new", hello)])) == "E_ROUTE_CONFLICT")
    assert(code_of(router([route("GET", "/u/{x:int}", hello), route("GET", "/u/{y}", hello)])) == "E_ROUTE_CONFLICT")
    assert(code_of(router([route("GET", "/u/{x:int}", hello), route("GET", "/u/12", hello)])) == "E_ROUTE_CONFLICT")

fn test_routes_that_cannot_match_one_path_are_accepted() -> Unit:
    assert(code_of(router([route("GET", "/u/{x:int}", hello), route("GET", "/u/new", hello)])) == "ok")
    assert(code_of(router([route("GET", "/a", hello), route("POST", "/a", hello)])) == "ok")
    assert(code_of(router([route("GET", "/a/{x}", hello), route("GET", "/a/{x}/b", hello)])) == "ok")
    assert(code_of(router([route("GET", "/a/b", hello), route("GET", "/a/c", hello)])) == "ok")

fn test_a_known_path_with_another_method_is_405_with_allow() -> Unit:
    let table = sample_router()
    let response = unwrap(router_handle(table, request_new("DELETE", "/users/5")))
    assert(response.status == 405)
    assert(unwrap(response_header(response, "allow")) == "GET, POST")
    assert(unwrap(router_handle(table, request_new("DELETE", "/nowhere"))).status == 404)

fn test_middleware_runs_outermost_first_and_unwinds_innermost_first() -> Unit:
    let base = app(sample_router_with_trace())
    let stacked = wrap(wrap(wrap(base, middleware(before_c, after_c)), middleware(before_b, after_b)), middleware(before_a, after_a))
    let response = unwrap(app_handle(stacked, get("/trace")))
    assert(text_of(response) == "a,b,c")
    assert(unwrap(response_header(response, "x-out")) == "c,b,a")
    let listed = app_with(sample_router_with_trace(), [middleware(before_a, after_a), middleware(before_b, after_b), middleware(before_c, after_c)])
    let again = unwrap(app_handle(listed, get("/trace")))
    assert(text_of(again) == "a,b,c")
    assert(unwrap(response_header(again, "x-out")) == "c,b,a")

fn sample_router_with_trace() -> Router:
    return unwrap(router([route("GET", "/trace", echo_trace), route("GET", "/cookies", three_cookies), route("GET", "/boom", fail)]))

fn test_a_before_hook_can_answer_and_outer_layers_still_unwind() -> Unit:
    let stacked = wrap(wrap(app(sample_router_with_trace()), middleware_before(deny)), middleware_after(after_a))
    let response = unwrap(app_handle(stacked, get("/trace")))
    assert(response.status == 401)
    assert(text_of(response) == "denied")
    assert(unwrap(response_header(response, "x-out")) == "a")

fn test_middleware_helpers_pass_the_other_side_through() -> Unit:
    let only_before = wrap(app(sample_router_with_trace()), middleware_before(before_a))
    let response = unwrap(app_handle(only_before, get("/trace")))
    assert(text_of(response) == "a")
    assert(is_some(response_header(response, "x-out")) == false)
    let only_after = wrap(app(sample_router_with_trace()), middleware_after(after_a))
    let second = unwrap(app_handle(only_after, get("/trace")))
    assert(text_of(second) == "none")
    assert(unwrap(response_header(second, "x-out")) == "a")

fn test_layer_closures_capture_the_values_they_use() -> Unit:
    let tag = "mine"
    let limit = 3
    let before = fn(request: Request) -> Result[Request, Response]: Ok(request)
    let after = fn(request: Request, response: Response) -> Result[Response, HttpFailure]: response_set_header(response, "x-tag", tag + int_to_text(limit))
    let stacked = wrap(app(sample_router_with_trace()), layer(before, after))
    let response = unwrap(app_handle(stacked, get("/trace")))
    assert(unwrap(response_header(response, "x-tag")) == "mine3")

fn test_layer_before_can_answer_from_a_captured_value() -> Unit:
    let blocked = "/trace"
    fn gate(request: Request) -> Result[Request, Response]:
        if request.path == blocked:
            return Err(response_text(403, "no"))
        return Ok(request)
    let stacked = wrap(app(sample_router_with_trace()), layer_before(gate))
    assert(unwrap(app_handle(stacked, get("/trace"))).status == 403)
    assert(unwrap(app_handle(stacked, get("/cookies"))).status == 200)

fn test_three_set_cookie_headers_survive_two_wrappers() -> Unit:
    let stacked = wrap(wrap(app(sample_router_with_trace()), middleware(before_b, after_b)), middleware(before_a, after_a))
    let response = unwrap(app_handle(stacked, get("/cookies")))
    assert(len(response_header_values(response, "set-cookie")) == 3)
    let wire = text_from_bytes(unwrap(response_serialize(response)))
    assert(is_some(wire))
    assert(len(text_split(unwrap(wire), "Set-Cookie: ")) == 4)

fn test_a_handler_err_is_an_err_in_app_handle_and_a_fixed_500_in_app_respond() -> Unit:
    let plain = app(sample_router_with_trace())
    assert(is_ok(app_handle(plain, get("/boom"))) == false)
    let response = app_respond(plain, get("/boom"))
    assert(response.status == 500)
    assert(text_of(response) == "Internal Server Error")
    assert(text_of(response) == internal_error_body())
    assert(len(response.headers) == 0)

fn test_a_500_carries_no_internal_detail_whatever_the_failure_says() -> Unit:
    let response = app_respond(app(sample_router_with_trace()), get("/boom"))
    let body = text_of(response)
    assert(response.status == 500)
    assert(text_find(body, "SECRET", 0) < 0)
    assert(text_find(body, "10.0.0.5", 0) < 0)
    assert(text_find(body, "password", 0) < 0)

fn test_an_after_hook_failure_is_also_a_500() -> Unit:
    let stacked = wrap(app(sample_router_with_trace()), middleware_after(after_fail))
    let response = app_respond(stacked, get("/trace"))
    assert(response.status == 500)
    assert(text_of(response) == "Internal Server Error")

fn test_the_failure_is_logged_through_std_log() -> Unit:
    let path = scratch("500.log")
    let opened = unwrap(log_open(path, "info"))
    let logged = app_log(app(sample_router_with_trace()), opened)
    let response = app_respond(logged, get("/boom"))
    assert(response.status == 500)
    assert(text_of(response) == "Internal Server Error")
    let lines = unwrap(read_text(path))
    assert(text_find(lines, "\"code\":\"DB_SECRET_CODE\"", 0) >= 0)
    assert(text_find(lines, "\"msg\":\"handler failed\"", 0) >= 0)
    assert(text_find(lines, "\"path\":\"/boom\"", 0) >= 0)
    let removed = fs_remove(path)

# ---- sessions and CSRF (F8) ----

# Every scratch file a test writes carries this process's id, so two `guion test` runs in one
# directory (a hand run beside the cargo test, say) never share a database, log or fixture directory.
fn scratch(name: Text) -> Text:
    return "web-test-" + int_to_text(process_pid()) + "-" + name

fn db_path() -> Text:
    return scratch("sessions.db")

fn clean_db() -> Unit:
    let a = fs_remove(db_path())
    let b = fs_remove(db_path() + "-wal")
    let c = fs_remove(db_path() + "-shm")
    let d = fs_remove(db_path() + "-journal")
    let e = fs_remove(scratch("sessions.log"))

fn fresh_store() -> SessionStore:
    clean_db()
    return unwrap(session_store_open(db_path()))

fn open_store() -> SessionStore:
    return unwrap(session_store_open(db_path()))

fn add_header(request: Request, name: Text, value: Text) -> Request:
    var headers = request.headers
    set headers = list_push(headers, Header(name, value))
    return Request(request.method, request.path, request.query, headers, request.body, request.params)

fn with_cookie(request: Request, name: Text, id: Text) -> Request:
    return add_header(request, "Cookie", name + "=" + id)

fn with_body(request: Request, content_type: Text, body: Text) -> Request:
    let typed = add_header(request, "Content-Type", content_type)
    return Request(typed.method, typed.path, typed.query, typed.headers, bytes_from_text(body), typed.params)

fn req(method: Text, path: Text, cookie: Text, token: Text) -> Request:
    var made = request_new(method, path)
    if len(cookie) > 0:
        set made = add_header(made, "Cookie", cookie)
    if len(token) > 0:
        set made = add_header(made, "x-csrf-token", token)
    return made

fn starts(value: Text, prefix: Text) -> Bool:
    return len(value) >= len(prefix) and text_slice(value, 0, len(prefix)) == prefix

fn cookie_name() -> Text:
    return session_policy_default().cookie_name

# The `name=value` part of the first Set-Cookie header ("" when there is none).
fn cookie_pair(response: Response) -> Text:
    let lines = response_header_values(response, "set-cookie")
    if len(lines) == 0:
        return ""
    return text_split(lines[0], ";")[0]

fn id_in(pair: Text) -> Text:
    let at = text_find(pair, "=", 0)
    return text_slice(pair, at + 1, len(pair))

fn count_rows(sql: Text, values: List[SqlValue]) -> Int:
    let db = unwrap(sqlite_open(db_path()))
    let tx = unwrap(sqlite_begin_read(db))
    let rows = unwrap(sqlite_query(tx, sql, values))
    let n = rows[0].values[0].integer
    let done = sqlite_commit(tx)
    let closed = sqlite_close(db)
    return n

fn sha_hex(id: Text) -> Text:
    return hex_encode(crypto_sha256_text(id))

fn val(result: Result[Option[Text], HttpFailure]) -> Text:
    match result:
        Ok(found):
            match found:
                Some(text):
                    return text
                None:
                    return "<none>"
        Err(failure):
            return "<err " + failure.code + ">"

fn failure_code(result: Result[Text, HttpFailure]) -> Text:
    match result:
        Ok(value):
            return "ok"
        Err(failure):
            return failure.code

fn test_a_session_id_is_64_lowercase_hex_digits() -> Unit:
    let id = unwrap(session_id_new())
    assert(len(id) == 64)
    assert(session_id_valid(id))
    assert(session_id_valid(text_slice(id, 0, 63)) == false)
    assert(session_id_valid(id + "0") == false)
    assert(session_id_valid("") == false)
    assert(session_id_valid(text_replace(id, text_slice(id, 0, 1), "g")) == false)
    let upper = "ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789"
    assert(session_id_valid(upper) == false)
    let padded = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde="
    assert(session_id_valid(padded) == false)
    let spaced = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde "
    assert(session_id_valid(spaced) == false)
    let encoded = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd%41"
    assert(session_id_valid(encoded) == false)
    clean_db()

fn first_word(id: Text) -> Int:
    let bytes = bytes_to_ints(unwrap(hex_decode(text_slice(id, 0, 8))))
    return ((bytes[0] * 256 + bytes[1]) * 256 + bytes[2]) * 256 + bytes[3]

fn test_ten_thousand_session_ids_have_no_collision_and_no_sequence() -> Unit:
    var seen: Map[Text, Bool] = {}
    var prefixes: Map[Text, Bool] = {}
    var differences: Map[Text, Bool] = {}
    var previous = 0
    var repeated_prefix = 0
    var count = 0
    while count < 10000:
        let id = unwrap(session_id_new())
        assert(session_id_valid(id))
        assert(map_has(seen, id) == false)
        set seen = map_set(seen, id, true)
        let prefix = text_slice(id, 0, 16)
        if map_has(prefixes, prefix):
            set repeated_prefix = repeated_prefix + 1
        set prefixes = map_set(prefixes, prefix, true)
        let word = first_word(id)
        if count > 0:
            set differences = map_set(differences, int_to_text(word - previous), true)
        set previous = word
        set count = count + 1
    assert(len(seen) == 10000)
    # 8 shared bytes between two of 10,000 random 32-byte IDs has probability about 2^-33.
    assert(repeated_prefix == 0)
    # A counter or a step would give one or a few differences; random words give almost all distinct.
    assert(len(differences) > 9900)
    clean_db()

fn test_a_malformed_cookie_id_is_rejected_before_the_database_is_touched() -> Unit:
    clean_db()
    let broken = SessionStore("no-such-directory/never.db", bytes_from_text("k"))
    let policy = session_policy_default()
    let good_shape = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    # The wrong shapes never reach the store, so the unreachable store is never noticed.
    assert(val(session_get_at(broken, policy, with_cookie(request_new("GET", "/"), cookie_name(), "short"), "user", 1000)) == "<none>")
    assert(val(session_get_at(broken, policy, with_cookie(request_new("GET", "/"), cookie_name(), good_shape + "0"), "user", 1000)) == "<none>")
    assert(val(session_get_at(broken, policy, with_cookie(request_new("GET", "/"), cookie_name(), "%41%42"), "user", 1000)) == "<none>")
    assert(val(session_get_at(broken, policy, request_new("GET", "/"), "user", 1000)) == "<none>")
    # A well-formed ID does go to the store, which here fails.
    let reached = session_get_at(broken, policy, with_cookie(request_new("GET", "/"), cookie_name(), good_shape), "user", 1000)
    assert(is_ok(reached) == false)
    assert(error(reached).code == "E_SESSION_STORE")
    clean_db()

fn test_the_store_holds_the_hash_of_an_id_never_the_id() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let id = unwrap(session_open_at(store, policy, request_new("GET", "/"), 5000))
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions WHERE id_hash = ?", [sql_text(id)]) == 0)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions WHERE id_hash = ?", [sql_text(sha_hex(id))]) == 1)
    let request = with_cookie(request_new("GET", "/"), cookie_name(), id)
    assert(unwrap(session_open_at(store, policy, request, 6000)) == id)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions", []) == 1)
    clean_db()

fn test_the_server_secret_is_made_once_and_kept() -> Unit:
    let first = fresh_store()
    let second = open_store()
    assert(len(first.secret) == 32)
    assert(first.secret == second.secret)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_secret", []) == 1)
    clean_db()
    let third = unwrap(session_store_open(db_path()))
    assert(third.secret != first.secret)
    clean_db()

fn test_session_fixation_an_unknown_id_is_replaced_never_adopted() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let planted = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    assert(session_id_valid(planted))
    let request = with_cookie(request_new("GET", "/"), cookie_name(), planted)
    let issued = unwrap(session_open_at(store, policy, request, 5000))
    assert(issued != planted)
    assert(session_id_valid(issued))
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions WHERE id_hash = ?", [sql_text(sha_hex(planted))]) == 0)
    # What the attacker planted does not become a session later either.
    let again = unwrap(session_open_at(store, policy, request, 6000))
    assert(again != planted)
    assert(again != issued)
    clean_db()

fn test_session_fixation_rotation_kills_an_id_the_attacker_knows() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    # The attacker gets a real session ID from the server and plants it in the victim's browser.
    let known = unwrap(session_open_at(store, policy, request_new("GET", "/"), unix_time_ms()))
    let victim = with_cookie(request_new("POST", "/login"), cookie_name(), known)
    unwrap(session_set(store, policy, victim, "cart", "3 items"))
    # The victim logs in; the application rotates on the privilege change.
    let answered = unwrap(session_rotate(store, policy, victim, response_text(200, "welcome")))
    let fresh = id_in(cookie_pair(answered))
    assert(session_id_valid(fresh))
    assert(fresh != known)
    assert(starts(cookie_pair(answered), cookie_name() + "="))
    # The planted ID is dead: it sees nothing and its data is gone.
    let attacker = with_cookie(request_new("GET", "/me"), cookie_name(), known)
    assert(val(session_get(store, policy, attacker, "cart")) == "<none>")
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions WHERE id_hash = ?", [sql_text(sha_hex(known))]) == 0)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_session_data WHERE id_hash = ?", [sql_text(sha_hex(known))]) == 0)
    # The victim's data moved to the new ID.
    let owner = with_cookie(request_new("GET", "/me"), cookie_name(), fresh)
    assert(val(session_get(store, policy, owner, "cart")) == "3 items")
    # Presenting the dead ID to the middleware's opener gives yet another ID, never the old one.
    let reissued = unwrap(session_open(store, policy, attacker))
    assert(reissued != known)
    assert(reissued != fresh)
    clean_db()

fn test_a_forged_or_extended_cookie_value_is_a_new_session_never_an_existing_one() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let victim_id = unwrap(session_open_at(store, policy, request_new("GET", "/"), unix_time_ms()))
    let victim = with_cookie(request_new("GET", "/"), cookie_name(), victim_id)
    unwrap(session_set(store, policy, victim, "user", "alice"))
    let last = text_slice(victim_id, 63, 64)
    var flipped = "0"
    if last == "0":
        set flipped = "1"
    let forged_values = [victim_id + "0", victim_id + "00", victim_id + "%00", text_slice(victim_id, 0, 63), text_slice(victim_id, 0, 63) + flipped, text_slice(victim_id, 1, 64), "\"" + victim_id + "x\""]
    for forged in forged_values:
        let request = with_cookie(request_new("GET", "/"), cookie_name(), forged)
        let issued = unwrap(session_open(store, policy, request))
        assert(issued != victim_id)
        assert(val(session_get(store, policy, with_cookie(request_new("GET", "/"), cookie_name(), issued), "user")) == "<none>")
    # The victim is untouched.
    assert(val(session_get(store, policy, victim, "user")) == "alice")
    clean_db()

fn test_an_idle_session_expires_and_activity_keeps_it_alive() -> Unit:
    let store = fresh_store()
    let policy = SessionPolicy(100, 100000, session_policy_default().cookie_name, true, "Lax")
    let id = unwrap(session_open_at(store, policy, request_new("GET", "/"), 1000000))
    let request = with_cookie(request_new("GET", "/"), cookie_name(), id)
    # 99 s later (idle is 100 s) the same ID is still valid and the visit renews it.
    assert(unwrap(session_open_at(store, policy, request, 1099000)) == id)
    assert(unwrap(session_open_at(store, policy, request, 1198000)) == id)
    # 100 s and a millisecond with no visit: gone.
    let late = unwrap(session_open_at(store, policy, request, 1298001))
    assert(late != id)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions WHERE id_hash = ?", [sql_text(sha_hex(id))]) == 0)
    assert(val(session_get_at(store, policy, request, "k", 1298002)) == "<none>")
    clean_db()

fn test_an_absolute_limit_ends_a_session_that_is_never_idle() -> Unit:
    let store = fresh_store()
    let policy = SessionPolicy(100, 250, session_policy_default().cookie_name, true, "Lax")
    let id = unwrap(session_open_at(store, policy, request_new("GET", "/"), 1000000))
    let request = with_cookie(request_new("GET", "/"), cookie_name(), id)
    assert(unwrap(session_open_at(store, policy, request, 1090000)) == id)
    assert(unwrap(session_open_at(store, policy, request, 1180000)) == id)
    assert(unwrap(session_open_at(store, policy, request, 1250000)) == id)
    # Visited 70 s ago, but the session is 250.001 s old: over the absolute limit.
    assert(unwrap(session_open_at(store, policy, request, 1250001)) != id)
    clean_db()

fn test_an_expired_session_hides_its_data_and_purge_removes_it() -> Unit:
    let store = fresh_store()
    let policy = SessionPolicy(100, 100000, session_policy_default().cookie_name, true, "Lax")
    let start = unix_time_ms()
    let id = unwrap(session_open_at(store, policy, request_new("GET", "/"), start))
    let request = with_cookie(request_new("GET", "/"), cookie_name(), id)
    unwrap(session_set(store, policy, request, "k", "v"))
    assert(val(session_get_at(store, policy, request, "k", start)) == "v")
    assert(val(session_get_at(store, policy, request, "k", start + 99999999999)) == "<none>")
    # Nothing is expired yet, so a purge now removes nothing; a purge far later removes the session
    # and its data.
    assert(unwrap(session_purge_expired_at(store, policy, start)) == 0)
    assert(unwrap(session_purge_expired_at(store, policy, start + 99999999999)) == 1)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions", []) == 0)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_session_data", []) == 0)
    clean_db()

fn test_session_values_belong_to_their_session_and_update_in_place() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let a = unwrap(session_open(store, policy, request_new("GET", "/")))
    let b = unwrap(session_open(store, policy, request_new("GET", "/")))
    assert(a != b)
    let ra = with_cookie(request_new("GET", "/"), cookie_name(), a)
    let rb = with_cookie(request_new("GET", "/"), cookie_name(), b)
    unwrap(session_set(store, policy, ra, "user", "alice"))
    assert(val(session_get(store, policy, ra, "user")) == "alice")
    assert(val(session_get(store, policy, rb, "user")) == "<none>")
    unwrap(session_set(store, policy, ra, "user", "alicia"))
    assert(val(session_get(store, policy, ra, "user")) == "alicia")
    assert(count_rows("SELECT COUNT(*) AS n FROM web_session_data", []) == 1)
    unwrap(session_remove(store, policy, ra, "user"))
    assert(val(session_get(store, policy, ra, "user")) == "<none>")
    clean_db()

fn test_session_set_needs_a_live_session_and_a_sane_key() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let none = request_new("GET", "/")
    assert(is_ok(session_set(store, policy, none, "k", "v")) == false)
    assert(error(session_set(store, policy, none, "k", "v")).code == "E_SESSION_NONE")
    let id = unwrap(session_open(store, policy, none))
    let request = with_cookie(none, cookie_name(), id)
    assert(error(session_set(store, policy, request, "", "v")).code == "E_SESSION_KEY")
    var long_key = ""
    var n = 0
    while n < 129:
        set long_key = long_key + "k"
        set n = n + 1
    assert(error(session_set(store, policy, request, long_key, "v")).code == "E_SESSION_KEY")
    var long_value = ""
    set n = 0
    while n < 65:
        set long_value = long_value + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10) + text_slice("0123456789", 0, 10)
        set n = n + 1
    assert(len(long_value) == 6500)
    assert(is_ok(session_set(store, policy, request, "k", long_value)))
    var huge = long_value
    set n = 0
    while n < 10:
        set huge = huge + huge
        set n = n + 1
    assert(error(session_set(store, policy, request, "k", huge)).code == "E_SESSION_VALUE")
    assert(is_ok(session_set(store, policy, request, "k", "v")))
    clean_db()

fn test_destroy_deletes_the_session_and_expires_the_cookie() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let id = unwrap(session_open(store, policy, request_new("GET", "/")))
    let request = with_cookie(request_new("POST", "/logout"), cookie_name(), id)
    unwrap(session_set(store, policy, request, "user", "alice"))
    let answered = unwrap(session_destroy(store, policy, request, response_text(200, "bye")))
    let line = response_header_values(answered, "set-cookie")[0]
    assert(starts(line, cookie_name() + "=;"))
    assert(text_find(line, "Max-Age=0", 0) >= 0)
    assert(val(session_get(store, policy, request, "user")) == "<none>")
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions", []) == 0)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_session_data", []) == 0)
    clean_db()

fn test_the_session_cookie_is_safe_by_default() -> Unit:
    let policy = session_policy_default()
    assert(policy.idle_seconds == 1800)
    assert(policy.absolute_seconds == 43200)
    assert(policy.secure)
    assert(policy.same_site == "Lax")
    let id = unwrap(session_id_new())
    let line = unwrap(cookie_serialize(unwrap(session_cookie(policy, id))))
    assert(starts(line, "__Host-session=" + id))
    assert(text_find(line, "; HttpOnly", 0) >= 0)
    assert(text_find(line, "; Secure", 0) >= 0)
    assert(text_find(line, "; SameSite=Lax", 0) >= 0)
    assert(text_find(line, "; Path=/", 0) >= 0)
    assert(text_find(line, "Domain", 0) < 0)
    clean_db()

fn test_samesite_none_needs_secure_and_a_host_prefix_needs_secure() -> Unit:
    let id = unwrap(session_id_new())
    let none_open = SessionPolicy(1800, 43200, "sid", false, "None")
    assert(error(session_cookie(none_open, id)).code == "E_COOKIE_SAMESITE_NONE_NEEDS_SECURE")
    assert(error(session_policy_check(none_open)).code == "E_COOKIE_SAMESITE_NONE_NEEDS_SECURE")
    let none_ok = SessionPolicy(1800, 43200, "sid", true, "None")
    assert(is_ok(session_policy_check(none_ok)))
    assert(text_find(unwrap(cookie_serialize(unwrap(session_cookie(none_ok, id)))), "SameSite=None", 0) >= 0)
    let host_insecure = SessionPolicy(1800, 43200, "__Host-sid", false, "Lax")
    assert(error(session_policy_check(host_insecure)).code == "E_SESSION_POLICY")
    # Local HTTP development: Secure off, no prefix.
    let local = SessionPolicy(1800, 43200, "sid", false, "Lax")
    assert(is_ok(session_policy_check(local)))
    let line = unwrap(cookie_serialize(unwrap(session_cookie(local, id))))
    assert(text_find(line, "Secure", 0) < 0)
    assert(text_find(line, "HttpOnly", 0) >= 0)
    # Nonsense limits and names are refused at construction.
    assert(error(session_policy_check(SessionPolicy(0, 43200, "sid", true, "Lax"))).code == "E_SESSION_POLICY")
    assert(error(session_policy_check(SessionPolicy(1800, 0, "sid", true, "Lax"))).code == "E_SESSION_POLICY")
    assert(error(session_policy_check(SessionPolicy(1800, 43200, "bad name", true, "Lax"))).code == "E_COOKIE_NAME_INVALID")
    assert(error(session_policy_check(SessionPolicy(1800, 43200, "sid", true, "Sideways"))).code == "E_COOKIE_SAMESITE_INVALID")
    let store = fresh_store()
    assert(is_ok(session_middleware(store, none_open)) == false)
    assert(error(session_middleware(store, none_open)).code == "E_COOKIE_SAMESITE_NONE_NEEDS_SECURE")
    assert(is_ok(csrf_middleware(store, none_open)) == false)
    clean_db()

# --- the application the middleware tests drive ---

fn form_page(request: Request) -> Result[Response, HttpFailure]:
    let token = csrf_token(open_store(), session_policy_default(), request)?
    return Ok(response_text(200, token))

fn item_ok(request: Request) -> Result[Response, HttpFailure]:
    return Ok(response_text(200, "done"))

fn login_page(request: Request) -> Result[Response, HttpFailure]:
    let store = open_store()
    let policy = session_policy_default()
    let set = session_set(store, policy, request, "user", "alice")?
    return session_rotate(store, policy, request, response_text(200, "welcome"))

fn whoami(request: Request) -> Result[Response, HttpFailure]:
    match session_get(open_store(), session_policy_default(), request, "user")?:
        Some(user):
            return Ok(response_text(200, user))
        None:
            return Ok(response_text(200, "anonymous"))

fn logout_page(request: Request) -> Result[Response, HttpFailure]:
    return session_destroy(open_store(), session_policy_default(), request, response_text(200, "bye"))

fn broken_page(request: Request) -> Result[Response, HttpFailure]:
    let set = session_set(open_store(), session_policy_default(), request, "secret", "TOPSECRETVALUE")?
    return Err(HttpFailure(500, "E_HANDLER", "something broke"))

fn form_router() -> Router:
    return unwrap(router([route("GET", "/form", form_page), route("GET", "/item", item_ok), route("HEAD", "/item", item_ok), route("OPTIONS", "/item", item_ok), route("POST", "/item", item_ok), route("PUT", "/item", item_ok), route("PATCH", "/item", item_ok), route("DELETE", "/item", item_ok), route("POST", "/login", login_page), route("GET", "/me", whoami), route("POST", "/logout", logout_page), route("GET", "/broken", broken_page)]))

fn full_app(store: SessionStore) -> App:
    let policy = session_policy_default()
    return app_with(form_router(), [unwrap(session_middleware(store, policy)), unwrap(csrf_middleware(store, policy))])

record Visit:
    cookie: Text
    token: Text

# A first visit: the session cookie and the CSRF token the page hands out.
fn visit(application: App) -> Visit:
    let response = app_respond(application, req("GET", "/form", "", ""))
    assert(response.status == 200)
    return Visit(cookie_pair(response), text_from_bytes_lossy(response.body.data))

fn status_of(application: App, request: Request) -> Int:
    return app_respond(application, request).status

fn test_the_session_layer_issues_a_cookie_once_and_reuses_the_session() -> Unit:
    let application = full_app(fresh_store())
    let first = visit(application)
    assert(starts(first.cookie, "__Host-session="))
    assert(len(id_in(first.cookie)) == 64)
    let again = app_respond(application, req("GET", "/form", first.cookie, ""))
    assert(cookie_pair(again) == first.cookie)
    assert(text_from_bytes_lossy(again.body.data) == first.token)
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions", []) == 1)
    let line = response_header_values(again, "set-cookie")[0]
    assert(text_find(line, "HttpOnly", 0) >= 0)
    assert(text_find(line, "Secure", 0) >= 0)
    assert(text_find(line, "SameSite=Lax", 0) >= 0)
    clean_db()

fn test_a_state_changing_request_without_a_token_is_refused_with_403() -> Unit:
    let application = full_app(fresh_store())
    let first = visit(application)
    for method in ["POST", "PUT", "PATCH", "DELETE"]:
        let refused = app_respond(application, req(method, "/item", first.cookie, ""))
        assert(refused.status == 403)
        assert(text_from_bytes_lossy(refused.body.data) == "Forbidden")
        assert(status_of(application, req(method, "/item", first.cookie, first.token)) == 200)
    # No cookie at all: a session is made for the request and the missing token is still a 403.
    assert(status_of(application, req("POST", "/item", "", "")) == 403)
    clean_db()

fn test_get_head_and_options_do_not_need_a_token_but_other_methods_do() -> Unit:
    let application = full_app(fresh_store())
    let first = visit(application)
    for method in ["GET", "HEAD", "OPTIONS"]:
        assert(status_of(application, req(method, "/item", first.cookie, "")) == 200)
        assert(status_of(application, req(method, "/item", "", "")) == 200)
    assert(csrf_exempt_method("GET"))
    assert(csrf_exempt_method("HEAD"))
    assert(csrf_exempt_method("OPTIONS"))
    for method in ["POST", "PUT", "PATCH", "DELETE", "TRACE", "CONNECT", "PURGE", "get", "post", "Get", ""]:
        assert(csrf_exempt_method(method) == false)
    # A method the router does not know is refused by CSRF (403) before the router's 405.
    assert(status_of(application, req("TRACE", "/item", first.cookie, "")) == 403)
    clean_db()

fn test_a_token_from_session_a_fails_in_session_b() -> Unit:
    let application = full_app(fresh_store())
    let a = visit(application)
    let b = visit(application)
    assert(a.cookie != b.cookie)
    assert(a.token != b.token)
    assert(status_of(application, req("POST", "/item", a.cookie, a.token)) == 200)
    assert(status_of(application, req("POST", "/item", b.cookie, b.token)) == 200)
    assert(status_of(application, req("POST", "/item", a.cookie, b.token)) == 403)
    assert(status_of(application, req("POST", "/item", b.cookie, a.token)) == 403)
    clean_db()

fn test_a_malformed_or_altered_token_is_refused() -> Unit:
    let application = full_app(fresh_store())
    let a = visit(application)
    assert(len(a.token) == 44)
    for bad in ["x", "AAAA", a.token + "A", text_slice(a.token, 0, 43), a.token + "=", "", "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"]:
        assert(status_of(application, req("POST", "/item", a.cookie, bad)) == 403)
    assert(status_of(application, req("POST", "/item", a.cookie, a.token)) == 200)
    clean_db()

# The last data character of a 32-byte MAC carries four bits and two unused padding bits. Trying every
# alphabet character there covers a changed MAC (a different value in the four bits) and the same MAC
# spelt another way (the padding bits set); the first is wrong and the second is not the token the
# server hands out, so each is refused whatever the random secret made this run's token. The token
# itself, at its own position in the alphabet, is the one that passes.
fn test_every_other_spelling_of_the_last_token_character_is_refused() -> Unit:
    let application = full_app(fresh_store())
    let a = visit(application)
    assert(len(a.token) == 44)
    assert(text_slice(a.token, 43, 44) == "=")
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    assert(len(alphabet) == 64)
    let head = text_slice(a.token, 0, 42)
    let own = text_slice(a.token, 42, 43)
    var refused = 0
    var accepted = 0
    var i = 0
    while i < 64:
        let c = text_slice(alphabet, i, i + 1)
        let variant = head + c + "="
        let status = status_of(application, req("POST", "/item", a.cookie, variant))
        if c == own:
            assert(variant == a.token)
            assert(status == 200)
            set accepted = accepted + 1
        else:
            assert(status == 403)
            set refused = refused + 1
        set i = i + 1
    assert(accepted == 1)
    assert(refused == 63)
    clean_db()

fn test_the_token_can_ride_in_a_form_field_and_the_header_wins() -> Unit:
    let application = full_app(fresh_store())
    let a = visit(application)
    let encoded = url_encode_component(a.token)
    let form = with_body(req("POST", "/item", a.cookie, ""), "application/x-www-form-urlencoded", "name=x&_csrf=" + encoded)
    assert(status_of(application, form) == 200)
    let wrong = with_body(req("POST", "/item", a.cookie, ""), "application/x-www-form-urlencoded", "name=x&_csrf=nope")
    assert(status_of(application, wrong) == 403)
    let absent = with_body(req("POST", "/item", a.cookie, ""), "application/x-www-form-urlencoded", "name=x")
    assert(status_of(application, absent) == 403)
    # A field in a body that is not a form is not read.
    let json = with_body(req("POST", "/item", a.cookie, ""), "application/json", "_csrf=" + encoded)
    assert(status_of(application, json) == 403)
    # A bad header is not rescued by a good field.
    let both = with_body(req("POST", "/item", a.cookie, "bad"), "application/x-www-form-urlencoded", "_csrf=" + encoded)
    assert(status_of(application, both) == 403)
    clean_db()

fn test_login_rotates_the_session_and_the_old_token_dies() -> Unit:
    let application = full_app(fresh_store())
    let before = visit(application)
    let answered = app_respond(application, req("POST", "/login", before.cookie, before.token))
    assert(answered.status == 200)
    let after_pair = cookie_pair(answered)
    assert(starts(after_pair, "__Host-session="))
    assert(after_pair != before.cookie)
    # One Set-Cookie for the session cookie: the layer does not add a second over the rotation.
    assert(len(response_header_values(answered, "set-cookie")) == 1)
    # The pre-login cookie and its token are dead.
    assert(app_respond(application, req("GET", "/me", before.cookie, "")).status == 200)
    assert(text_from_bytes_lossy(app_respond(application, req("GET", "/me", before.cookie, "")).body.data) == "anonymous")
    assert(status_of(application, req("POST", "/item", before.cookie, before.token)) == 403)
    # The new session is logged in; its token is new.
    assert(text_from_bytes_lossy(app_respond(application, req("GET", "/me", after_pair, "")).body.data) == "alice")
    let page = app_respond(application, req("GET", "/form", after_pair, ""))
    assert(text_from_bytes_lossy(page.body.data) != before.token)
    assert(status_of(application, req("POST", "/item", after_pair, text_from_bytes_lossy(page.body.data))) == 200)
    clean_db()

fn test_logout_destroys_the_session_and_its_token() -> Unit:
    let application = full_app(fresh_store())
    let a = visit(application)
    let answered = app_respond(application, req("POST", "/logout", a.cookie, a.token))
    assert(answered.status == 200)
    assert(len(response_header_values(answered, "set-cookie")) == 1)
    assert(text_find(response_header_values(answered, "set-cookie")[0], "Max-Age=0", 0) >= 0)
    assert(status_of(application, req("POST", "/item", a.cookie, a.token)) == 403)
    clean_db()

fn test_an_attacker_supplied_cookie_gets_a_fresh_session_through_the_middleware() -> Unit:
    let application = full_app(fresh_store())
    let planted = "__Host-session=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    let response = app_respond(application, req("GET", "/form", planted, ""))
    assert(response.status == 200)
    let issued = cookie_pair(response)
    assert(issued != planted)
    assert(id_in(issued) != id_in(planted))
    assert(count_rows("SELECT COUNT(*) AS n FROM web_sessions WHERE id_hash = ?", [sql_text(sha_hex(id_in(planted)))]) == 0)
    # Two cookies of the same name in one request: the first one is read and replaced as a whole.
    let doubled = req("GET", "/form", planted + "; __Host-session=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc; other=1", "")
    let second = app_respond(application, doubled)
    assert(id_in(cookie_pair(second)) != id_in(planted))
    assert(len(id_in(cookie_pair(second))) == 64)
    clean_db()

fn test_the_session_layer_keeps_other_cookies_and_puts_its_own_first() -> Unit:
    let policy = session_policy_default()
    let layer = unwrap(session_middleware(fresh_store(), policy))
    let before = layer.before
    let request = req("GET", "/", "theme=dark; __Host-session=zzz; lang=en", "")
    let passed = unwrap(before(layer.config, request))
    let id = unwrap(session_id_of(policy, passed))
    assert(session_id_valid(id))
    var joined = ""
    for header in passed.headers:
        set joined = joined + header.value + "|"
    assert(text_find(joined, "theme=dark", 0) >= 0)
    assert(text_find(joined, "lang=en", 0) >= 0)
    assert(text_find(joined, "zzz", 0) < 0)
    clean_db()

fn test_a_stored_session_past_its_limit_is_replaced_by_the_middleware_on_the_real_clock() -> Unit:
    let store = fresh_store()
    let application = full_app(store)
    let a = visit(application)
    let db = unwrap(sqlite_open(db_path()))
    let tx = unwrap(sqlite_begin(db))
    unwrap(sqlite_execute(tx, "UPDATE web_sessions SET last_seen_ms = 1, created_ms = 1", []))
    unwrap(sqlite_commit(tx))
    unwrap(sqlite_close(db))
    let response = app_respond(application, req("GET", "/form", a.cookie, ""))
    assert(response.status == 200)
    assert(cookie_pair(response) != a.cookie)
    assert(status_of(application, req("POST", "/item", a.cookie, a.token)) == 403)
    clean_db()

fn test_a_session_read_completes_while_another_connection_holds_a_write_transaction() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let id = unwrap(session_open(store, policy, request_new("GET", "/")))
    let request = with_cookie(request_new("GET", "/"), cookie_name(), id)
    unwrap(session_set(store, policy, request, "user", "alice"))
    let writer = unwrap(sqlite_open(db_path()))
    let held = unwrap(sqlite_begin(writer))
    unwrap(sqlite_execute(held, "INSERT INTO web_session_data (id_hash, key, value) VALUES ('held', 'k', 'v')", []))
    # The read path uses a read transaction, so the held write does not block it.
    assert(val(session_get(store, policy, request, "user")) == "alice")
    assert(unwrap(session_exists(store, policy, request)))
    let rolled = sqlite_rollback(held)
    let closed = sqlite_close(writer)
    clean_db()

fn test_nothing_about_a_session_reaches_the_log() -> Unit:
    let store = fresh_store()
    let opened = unwrap(log_open(scratch("sessions.log"), "debug"))
    let application = app_log(full_app(store), opened)
    let a = visit(application)
    let response = app_respond(application, req("GET", "/broken", a.cookie, ""))
    assert(response.status == 500)
    assert(text_from_bytes_lossy(response.body.data) == "Internal Server Error")
    let refused = app_respond(application, req("POST", "/item", a.cookie, "tampered"))
    assert(refused.status == 403)
    let lines = unwrap(read_text(scratch("sessions.log")))
    assert(text_find(lines, "\"code\":\"E_HANDLER\"", 0) >= 0)
    assert(text_find(lines, id_in(a.cookie), 0) < 0)
    assert(text_find(lines, a.token, 0) < 0)
    assert(text_find(lines, "TOPSECRETVALUE", 0) < 0)
    assert(text_find(lines, "tampered", 0) < 0)
    assert(text_find(lines, "__Host-session", 0) < 0)
    clean_db()

fn test_csrf_without_a_session_layer_in_front_fails_closed() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let lonely = app_with(form_router(), [unwrap(csrf_middleware(store, policy))])
    # A cookie nobody issued has no session behind it, so no token for it can verify.
    let ghost = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    let forged_token = base64url_encode(crypto_hmac_sha256(store.secret, bytes_from_text(ghost + "csrf")))
    assert(status_of(lonely, req("POST", "/item", "__Host-session=" + ghost, forged_token)) == 403)
    assert(status_of(lonely, req("POST", "/item", "", "")) == 403)
    clean_db()

fn test_csrf_tokens_are_a_keyed_mac_of_the_session_id() -> Unit:
    let store = fresh_store()
    let policy = session_policy_default()
    let id = unwrap(session_open(store, policy, request_new("GET", "/")))
    let request = with_cookie(request_new("GET", "/"), cookie_name(), id)
    let token = unwrap(csrf_token(store, policy, request))
    assert(token == base64url_encode(crypto_hmac_sha256(store.secret, bytes_from_text(id + "csrf"))))
    # Another server secret gives another token for the same ID.
    assert(token != base64url_encode(crypto_hmac_sha256(bytes_from_text("another secret"), bytes_from_text(id + "csrf"))))
    assert(is_ok(csrf_token(store, policy, request_new("GET", "/"))) == false)
    assert(error(csrf_token(store, policy, request_new("GET", "/"))).code == "E_CSRF_NO_SESSION")
    clean_db()

fn test_html_escape_text_covers_the_five_characters_and_nothing_else() -> Unit:
    assert(html_escape_text("<script>alert(1)</script>") == "&lt;script&gt;alert(1)&lt;/script&gt;")
    assert(html_escape_text("\"'&<>") == "&quot;&#39;&amp;&lt;&gt;")
    # Ampersand first: an existing entity is data and is escaped, not decoded.
    assert(html_escape_text("&lt;") == "&amp;lt;")
    assert(html_escape_text("plain text, é日本語😀 and `ticks`") == "plain text, é日本語😀 and `ticks`")
    assert(html_escape_text("") == "")

fn test_html_escape_attr_also_covers_the_backtick() -> Unit:
    assert(html_escape_attr("a`b") == "a&#96;b")
    assert(html_escape_attr("\" onmouseover=\"x") == "&quot; onmouseover=&quot;x")

fn test_html_escape_url_encodes_everything_but_unreserved_characters() -> Unit:
    assert(html_escape_url("javascript:alert(1)") == "javascript%3Aalert%281%29")
    assert(html_escape_url("a b/c?d=e&f#g") == "a%20b%2Fc%3Fd%3De%26f%23g")
    assert(html_escape_url("-._~AZaz09") == "-._~AZaz09")
    assert(html_escape_url("é") == "%C3%A9")
    assert(html_escape_url("<>\"'") == "%3C%3E%22%27")

fn test_html_script_string_is_a_json_literal_that_cannot_leave_the_element() -> Unit:
    assert(html_script_string("abc") == "\"abc\"")
    assert(html_script_string("a\"b\\c\nd") == "\"a\\\"b\\\\c\\nd\"")
    assert(html_script_string("</script><!--") == "\"\\u003c/script\\u003e\\u003c!--\"")
    assert(html_script_string("'`$&") == "\"\\u0027\\u0060\\u0024\\u0026\"")
    assert(html_script_string("\u{2028}\u{2029}") == "\"\\u2028\\u2029\"")
    assert(html_script_string("") == "\"\"")
    # No raw angle bracket, quote-breaking character or line separator survives.
    let hostile = html_script_string("</script><script>alert(1)//\u{2028}'`${x}")
    assert(text_find(hostile, "<", 0) < 0)
    assert(text_find(hostile, ">", 0) < 0)
    assert(text_find(hostile, "'", 0) < 0)
    assert(text_find(hostile, "`", 0) < 0)
    assert(text_find(hostile, "$", 0) < 0)
    assert(text_find(hostile, "\u{2028}", 0) < 0)

fn test_a_rendered_value_joins_its_parts_once_and_html_response_types_it() -> Unit:
    let page = html_finish(["<p>", html_escape_text("<b>"), "</p>"])
    assert(page.html == "<p>&lt;b&gt;</p>")
    assert(html_embed_rendered(page) == "<p>&lt;b&gt;</p>")
    assert(html_finish([]).html == "")
    let response = unwrap(html_response(201, page))
    assert(response.status == 201)
    assert(unwrap(response_header(response, "content-type")) == "text/html; charset=utf-8")
    assert(text_of(response) == "<p>&lt;b&gt;</p>")

# ---- static files ----

fn static_fixture(dir: Text) -> Text:
    let gone = fs_remove_all(dir)
    let made = fs_make_dir(dir)
    let written = write_text(dir + "/app.css", "body{}")
    return dir

fn static_app(dir: Text) -> App:
    let table = unwrap(router([route("GET", "/hello", hello)]))
    return app_with(table,[static_files("/assets", static_fixture(dir))])

fn test_static_files_serve_under_the_prefix_and_leave_other_paths_to_the_router() -> Unit:
    let dir = scratch("static-a")
    let served = app_respond(static_app(dir), get("/assets/app.css"))
    assert(served.status == 200)
    assert(unwrap(unwrap(response_file_plan(served))).length == 6)
    assert(unwrap(response_header(served, "content-type")) == "text/css; charset=utf-8")
    assert(app_respond(static_app(dir), get("/hello")).status == 200)
    assert(app_respond(static_app(dir), get("/assetsX/app.css")).status == 404)
    assert(app_respond(static_app(dir), get("/assets/missing.css")).status == 404)
    let cleaned = fs_remove_all(dir)

fn test_static_files_refuse_escapes_and_answer_head_and_validators() -> Unit:
    let dir = scratch("static-b")
    let site = static_app(dir)
    let secret_path = dir + "-secret.txt"
    let secret = write_text(secret_path, "secret")
    let escape = app_respond(site, get("/assets/%2e%2e%2f" + secret_path))
    assert(escape.status == 404)
    let head = app_respond(site, request_new("HEAD", "/assets/app.css"))
    assert(head.status == 200)
    assert(len(head.body.data) == 0)
    let served = app_respond(site, get("/assets/app.css"))
    let tag = unwrap(response_header(served, "etag"))
    let conditional = Request("GET", "/assets/app.css", {},[Header("if-none-match", tag)], bytes_from_text(""), {})
    assert(app_respond(site, conditional).status == 304)
    # Other methods under the prefix are the router's: no route, so 404 rather than a file.
    assert(app_respond(site, request_new("POST", "/assets/app.css")).status == 404)
    let cleaned = fs_remove_all(dir)
    let removed = fs_remove(secret_path)
